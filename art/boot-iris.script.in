# ArkadeOS boot screen, round 9: Írisz + Tervrajz (approved 2026-11-21).
# Written by art/boot_iris.py from art/boot-iris.script.in; change those, not
# this file.
#
# Thin construction lines lay out the mark (axes, dimension marks, two
# circles, the hexagon), the six crystal pieces of the Start mark spiral in
# onto the drawing like a closing iris and snap shut, the inside lights up,
# the gem turns into place with a light line and a hexagonal ring, the drawing
# fades, a sheen sweeps the mark and the word comes letter by letter. Until the
# desktop comes a light point circles the faint construction circle and a
# sheen sweeps the mark now and then. The system's own prompts (disk password,
# update progress) take the word's place under the mark.
#
# Plymouth draws in software: everything that moves stays round the mark, and
# once the opening is over the mark is one picture, so a frame redraws little.
#
# In Plymouth's script a name inside a function means the global of that name
# when one exists, so every function brings in its own helpers as local.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

#@SPRITES@

PI = 3.14159265;
CIRC_O = 106;          # the outer construction circle's radius, design units
LOCK = 1.95;           # the iris shuts
IGN = 2.15;            # the gem ignites
OPEN = 3.6;            # the opening is over, the waiting begins
WORD_OPACITY = 0.92;
AX_N = 16; STREAK_N = 16; GHOSTS = 2;

SW = Window.GetWidth();
SH = Window.GetHeight();
SC = Math.Min(SW / DW, SH / DH);     # screen px per design unit
OX = Window.GetX() + SW / 2;
OY = Window.GetY() + SH * 0.46;

fun X(x) { return OX + (x - DCX) * SC; }
fun Y(y) { return OY + (y - DCY) * SC; }

fun clamp01(v) { if (v < 0) return 0; if (v > 1) return 1; return v; }
fun ramp(t, a, b) { return clamp01((t - a) / (b - a)); }
fun out3(p) { local.q = 1 - p; return 1 - q * q * q; }
fun inout3(p) { local.q = 0; if (p < 0.5) return 4 * p * p * p; q = 2 - 2 * p; return 1 - q * q * q / 2; }
fun pop(p) { local.c1 = 1.70158 * 1.3; local.c3 = c1 + 1; local.q = p - 1; return 1 + c3 * q * q * q + c1 * q * q; }
fun frac(x) { local.i = Math.Int(x); if (x < i) i = i - 1; return x - i; }
fun near(x) { return Math.Int(x + 0.5); }

# A sprite image scaled to this screen; at the size it was drawn for (2560 wide) as it is.
fun load(name) {
    local.img = Image(name + ".png");
    local.k = SC / (RENDER * spr[name].d);
    local.w = 0; local.h = 0;
    if (k > 0.995 && k < 1.005) return img;
    w = Math.Max(1, Math.Int(img.GetWidth() * k + 0.5));
    h = Math.Max(1, Math.Int(img.GetHeight() * k + 0.5));
    return img.Scale(w, h);
}

# Place a sprite so its image's centre is at design point (x, y).
fun at(sprite, x, y, z) {
    local.img = sprite.GetImage();
    sprite.SetPosition(Math.Int(X(x) - img.GetWidth() / 2 + 0.5), Math.Int(Y(y) - img.GetHeight() / 2 + 0.5), z);
}

fun layer(name, z) {
    local.s = Sprite(load(name));
    at(s, spr[name].x, spr[name].y, z);
    s.SetOpacity(0);
    return s;
}

#----------------------------------------- the sprites

# the drawing
axh_base = load("axis-h"); axv_base = load("axis-v");
for (n = 0; n < AX_N; n++) {
    axh_img[n] = axh_base.Scale(Math.Max(1, Math.Int(axh_base.GetWidth() * (n + 1) / AX_N)), axh_base.GetHeight());
    axv_img[n] = axv_base.Scale(axv_base.GetWidth(), Math.Max(1, Math.Int(axv_base.GetHeight() * (n + 1) / AX_N)));
}
axh = Sprite(axh_img[0]); axh.SetOpacity(0); axh_i = -1;
axv = Sprite(axv_img[0]); axv.SetOpacity(0); axv_i = -1;
dimv_img = load("dim-v"); dimh_img = load("dim-h");
for (n = 0; n < 13; n++) {
    dimx[n] = Sprite(dimv_img); at(dimx[n], MCX + (n - 6) * 40, MCY, 2); dimx[n].SetOpacity(0);
    dimy[n] = Sprite(dimh_img); at(dimy[n], MCX, MCY + (n - 6) * 40, 2); dimy[n].SetOpacity(0);
}
for (n = 0; n < ARC_N; n++) { arco[n] = layer("arco-" + n, 3); arci[n] = layer("arci-" + n, 3); }
for (n = 0; n < HEX_N; n++) { hexa[n] = layer("hex0-" + n, 4); hexb[n] = layer("hex1-" + n, 4); }
circle = layer("circle", 3);

# the mark
base = layer("base", 11);
for (n = 0; n < INNER_N; n++) inner_img[n] = load("inner-" + n);
inner = Sprite(inner_img[0]); inner.SetOpacity(0); at(inner, MCX, MCY, 14);
for (a = 0; a < 360; a += IRIS_STEP) iris_img[a / IRIS_STEP] = load("iris-" + a);
IRIS_N = 360 / IRIS_STEP;
for (k = 0; k < 6; k++) {
    piece_img[k] = load("piece" + k + "-0");
    piece[k] = Sprite(iris_img[0]); piece[k].SetOpacity(0);
    for (j = 1; j <= GHOSTS; j++) { ghost[k][j] = Sprite(iris_img[0]); ghost[k][j].SetOpacity(0); }
}
ridge = layer("ridge", 17);
bezel = layer("bezel", 17);
lit = layer("bezel-lit", 18);
for (n = 0; n < SHOCK_N; n++) shock_img[n] = load("shock0-" + n);
ring = Sprite(shock_img[0]); ring.SetOpacity(0);
for (n = 0; n < SEQ_N; n++) seq_img[n] = load("seq-" + n);
seq = Sprite(seq_img[0]); seq.SetOpacity(0); at(seq, MCX, MCY, 16);
SEQ_FROM = IGN; SEQ_TO = IGN + 0.9;
streak_base = load("streak");
for (n = 0; n < STREAK_N; n++) streak_img[n] = streak_base.Scale(Math.Max(1, Math.Int(streak_base.GetWidth() * (n + 1) / STREAK_N * 2400 / 1180)), streak_base.GetHeight());
streak = Sprite(streak_img[0]); streak.SetOpacity(0);
for (n = 0; n < SHEEN_N; n++) sheen_img[n] = load(sheen_name[n]);
sheen = Sprite(sheen_img[0]); sheen.SetOpacity(0); at(sheen, MCX, MCY, 23);
mark = layer("mark", 10);
odot = layer("odot", 25);
for (n = 0; n < 8; n++) word_img[n] = load("word-" + (n + 1));
word_full = load("word");
word = Sprite(word_img[0]); word.SetOpacity(0); at(word, spr["word"].x, spr["word"].y, 24);

dialog_on = 0;
rest = 0; rested = 0; in_seq = 0; shut = 0; drawing_gone = 0; shx = 0; shy = 0;
t = 0;
if (Plymouth.GetMode() == "shutdown" || Plymouth.GetMode() == "reboot") t = OPEN;

#----------------------------------------- one frame

fun shake_at(sprite, x, y, z) { at(sprite, x + shx, y + shy, z); }

fun opening(t) {
    local.la = 0; local.a = 0; local.n = 0; local.o = 0; local.cp = 0; local.hp = 0; local.p = 0; local.e = 0;
    local.rot = 0; local.rad = 0; local.k = 0; local.j = 0; local.pj = 0; local.ej = 0; local.ang = 0;
    local.idx = 0; local.dx = 0; local.dy = 0; local.c = 0; local.s = 0; local.sh = 0; local.d = 0;
    local.rp = 0; local.ip = 0; local.sp = 0; local.kk = 0; local.w = 0; local.gp = 0; local.q = 0; local.wq = 0;

    # the drawing (touched only while it draws and while it fades)
    la = 1 - ramp(t, LOCK + 0.1, LOCK + 0.8);
    if (t < 1.25 || (t > LOCK + 0.1 && !drawing_gone)) {
        a = out3(ramp(t, 0, 0.55));
        if (a <= 0) { axh.SetOpacity(0); axv.SetOpacity(0); }
        else {
            idx = Math.Min(AX_N - 1, Math.Int(a * AX_N));
            if (idx != axh_i) { axh.SetImage(axh_img[idx]); axv.SetImage(axv_img[idx]); at(axh, MCX, MCY, 1); at(axv, MCX, MCY, 1); global.axh_i = idx; }
            axh.SetOpacity(la); axv.SetOpacity(la);
        }
        for (n = 0; n < 13; n++) {
            d = Math.Abs(n - 6);
            o = ramp(t, 0.35 + d * 0.03, 0.55 + d * 0.03) * la;
            dimx[n].SetOpacity(o);
            if (d <= 4) dimy[n].SetOpacity(o);
        }
        cp = ramp(t, 0.25, 0.9);
        if (t < SEQ_FROM) for (n = 0; n < ARC_N; n++) { o = clamp01(cp * ARC_N - n) * la; arco[n].SetOpacity(o); arci[n].SetOpacity(o); }
        hp = inout3(ramp(t, 0.6, 1.2));
        if (t < SEQ_FROM) for (n = 0; n < HEX_N; n++) { o = clamp01(hp * HEX_N - n) * la; hexa[n].SetOpacity(o); hexb[n].SetOpacity(o); }
        if (la <= 0) global.drawing_gone = 1;
    }

    # the iris
    sh = ramp(t, LOCK - 0.05, LOCK + 0.23);
    if (sh > 0 && sh < 1) { d = 7 * (1 - sh); global.shx = Math.Sin(sh * 47) * d; global.shy = Math.Cos(sh * 39) * d * 0.6; }
    else { global.shx = 0; global.shy = 0; }
    p = ramp(t, 1.0, LOCK);
    if (p > 0 && !shut) for (k = 0; k < 6; k++) {
        dx = piece_x[k] - MCX; dy = piece_y[k] - MCY;
        if (p <= 0) piece[k].SetOpacity(0);
        else if (p < 1) {
            for (j = 0; j <= GHOSTS; j++) {
                pj = clamp01(p - j * 0.035);
                ej = pop(pj);
                rot = -135 * (1 - ej);
                rad = 1 + 1.6 * (1 - ej);
                ang = 60 * k + rot;
                idx = near(ang / IRIS_STEP);
                idx = idx - Math.Int(idx / IRIS_N) * IRIS_N; if (idx < 0) idx += IRIS_N;
                c = Math.Cos(rot * PI / 180); s = Math.Sin(rot * PI / 180);
                if (j == 0) {
                    piece[k].SetImage(iris_img[idx]);
                    at(piece[k], MCX + (dx * c - dy * s) * rad, MCY + (dx * s + dy * c) * rad, 15);
                    piece[k].SetOpacity(clamp01(pj * 2.5));
                } else {
                    ghost[k][j].SetImage(iris_img[idx]);
                    at(ghost[k][j], MCX + (dx * c - dy * s) * rad, MCY + (dx * s + dy * c) * rad, 14);
                    ghost[k][j].SetOpacity(clamp01(pj * 2.5) * 0.3 * (GHOSTS + 1 - j) / GHOSTS);
                }
            }
        } else {
            # shut: the bezel picture stands for the six pieces and the ridge
            piece[k].SetOpacity(0);
            for (j = 1; j <= GHOSTS; j++) ghost[k][j].SetOpacity(0);
        }
    }
    if (p >= 1) global.shut = 1;
    if (t < LOCK - 0.1) return;

    if (t < SEQ_FROM) {
        if (p < 1) ridge.SetOpacity(ramp(t, LOCK - 0.1, LOCK + 0.05)); else ridge.SetOpacity(0);
        if (p >= 1) { shake_at(bezel, MCX, MCY, 17); bezel.SetOpacity(1); }
        shake_at(base, MCX, MCY, 11); base.SetOpacity(out3(ramp(t, LOCK, LOCK + 0.5)));
        shake_at(lit, MCX, MCY, 18); lit.SetOpacity(clamp01(1.5 * (ramp(t, LOCK - 0.05, LOCK + 0.05) - ramp(t, LOCK + 0.05, LOCK + 0.7))));
        ip = ramp(t, LOCK + 0.05, LOCK + 0.5);
        if (ip <= 0 || ip >= 1) inner.SetOpacity(0);
        else { inner.SetImage(inner_img[near(out3(ip) * (INNER_N - 1))]); inner.SetOpacity(clamp01(1.2 * (1 - ip))); }
    } else if (t < SEQ_TO) {
        # one picture for everything round the mark
        if (!in_seq) {
            ridge.SetOpacity(0); bezel.SetOpacity(0); base.SetOpacity(0); lit.SetOpacity(0); inner.SetOpacity(0);
            for (n = 0; n < ARC_N; n++) { arco[n].SetOpacity(0); arci[n].SetOpacity(0); }
            for (n = 0; n < HEX_N; n++) { hexa[n].SetOpacity(0); hexb[n].SetOpacity(0); }
            global.in_seq = 1;
        }
        seq.SetImage(seq_img[near((t - SEQ_FROM) / (SEQ_TO - SEQ_FROM) * (SEQ_N - 1))]);
        seq.SetOpacity(1);
    } else if (!rested) { mark.SetOpacity(1); seq.SetOpacity(0); global.rested = 1; }

    # the snap's hexagonal ring
    rp = ramp(t, LOCK, LOCK + 0.7);
    if (rp <= 0 || rp >= 1) ring.SetOpacity(0);
    else {
        ring.SetImage(shock_img[near(out3(rp) * (SHOCK_N - 1))]);
        at(ring, MCX, MCY, 19);
        ring.SetOpacity(0.9 * (1 - rp));
    }

    # the light line through the core
    sp = ramp(t, IGN, IGN + 1.1);
    if (sp <= 0 || sp >= 1) streak.SetOpacity(0);
    else {
        if (sp < 0.15) kk = sp / 0.15; else kk = 1 - (sp - 0.15) / 0.85;
        w = (300 + 900 * out3(Math.Min(1, sp * 2))) * 2 / 2400;
        streak.SetImage(streak_img[Math.Clamp(near(w * STREAK_N) - 1, 0, STREAK_N - 1)]);
        at(streak, MCX, MCY, 22);
        streak.SetOpacity(0.95 * kk);
    }

    # a sheen sweeps the mark, the word comes letter by letter
    if (t > IGN + 0.5 && t < IGN + 1.2) {
        q = inout3((t - IGN - 0.5) / 0.7);
        sheen.SetImage(sheen_img[near(q * (SHEEN_N - 1))]);
        sheen.SetOpacity(0.8);
    } else sheen.SetOpacity(0);
    wq = ramp(t, IGN + 0.6, IGN + 1.3);
    if (wq <= 0 || dialog_on) word.SetOpacity(0);
    else { word.SetImage(word_img[Math.Clamp(Math.Int(wq * 8 + 0.999) - 1, 0, 7)]); word.SetOpacity(WORD_OPACITY); }
}

# The opening's last frame equals the mark at rest; from here one picture stands for it.
fun settle() {
    local.n = 0; local.k = 0; local.j = 0;
    mark.SetOpacity(1);
    axh.SetOpacity(0); axv.SetOpacity(0);
    for (n = 0; n < 13; n++) { dimx[n].SetOpacity(0); dimy[n].SetOpacity(0); }
    for (n = 0; n < ARC_N; n++) { arco[n].SetOpacity(0); arci[n].SetOpacity(0); }
    for (n = 0; n < HEX_N; n++) { hexa[n].SetOpacity(0); hexb[n].SetOpacity(0); }
    for (k = 0; k < 6; k++) { piece[k].SetOpacity(0); for (j = 1; j <= GHOSTS; j++) ghost[k][j].SetOpacity(0); }
    base.SetOpacity(0); bezel.SetOpacity(0); seq.SetOpacity(0); ridge.SetOpacity(0); lit.SetOpacity(0);
    ring.SetOpacity(0); inner.SetOpacity(0); streak.SetOpacity(0);
    sheen.SetOpacity(0);
    word.SetImage(word_full);
    global.rest = 1;
}

fun waiting(t) {
    local.u = t - OPEN; local.a = 0; local.ph = 0;
    circle.SetOpacity(0.16 * ramp(u, 0, 0.6));
    a = u / 4 * 2 * PI - PI / 2;
    at(odot, MCX + CIRC_O * Math.Cos(a), MCY + CIRC_O * Math.Sin(a), 25);
    odot.SetOpacity(ramp(u, 0, 0.6));
    ph = frac((u + 1.5) / 4.0);
    if (ph < 0.45) { sheen.SetImage(sheen_img[near(inout3(ph / 0.45) * (SHEEN_N - 1))]); sheen.SetOpacity(0.5); }
    else sheen.SetOpacity(0);
    if (dialog_on) word.SetOpacity(0); else word.SetOpacity(WORD_OPACITY);
}

fun refresh() {
    global.t += 1 / 50;
    if (t < OPEN) opening(t);
    else {
        if (!rest) settle();
        waiting(t);
    }
}
Plymouth.SetRefreshFunction(refresh);

#----------------------------------------- under the mark: prompts and progress

font = "Inter " + Math.Int(Math.Max(11, SH / 80));
entry_image = load("entry");
lock_image = load("lock");
bullet_image = load("bullet");
entry = Sprite(entry_image);
lock = Sprite(lock_image);
prompt = Sprite();
answer = Sprite();
entry.SetOpacity(0);
lock.SetOpacity(0);
bullet_count = 0;
ex = X(spr["entry"].x) - entry_image.GetWidth() / 2;
ey = Y(spr["entry"].y) - entry_image.GetHeight() / 2;

fun dialog(text, opacity) {
    global.dialog_on = opacity > 0;
    entry.SetPosition(ex, ey, 100);
    lock.SetPosition(ex + entry_image.GetHeight() / 2 - lock_image.GetWidth() / 2, ey + entry_image.GetHeight() / 2 - lock_image.GetHeight() / 2, 101);
    prompt.SetImage(Image.Text(text, 0.62, 0.70, 0.77, 1, font));
    prompt.SetPosition(Window.GetX() + SW / 2 - prompt.GetImage().GetWidth() / 2, ey + entry_image.GetHeight() + SH * 0.012, 100);
    prompt.SetOpacity(opacity);
    entry.SetOpacity(opacity);
    lock.SetOpacity(opacity);
}

# The dots are globals, so they stay on the screen after this returns.
fun bullets(count) {
    local.bx = ex + entry_image.GetHeight();
    local.b = 0;
    for (b = 0; b < bullet_count || b < count; b++) {
        if (!global.bullet[b]) {
            global.bullet[b] = Sprite(bullet_image);
            global.bullet[b].SetPosition(bx + b * bullet_image.GetWidth() * 1.15, ey + entry_image.GetHeight() / 2 - bullet_image.GetHeight() / 2, 101);
        }
        if (b < count) global.bullet[b].SetOpacity(1); else global.bullet[b].SetOpacity(0);
    }
    global.bullet_count = Math.Max(bullet_count, count);
}

fun on_password(text, count) {
    if (text == "") text = " ";
    dialog(text, 1);
    answer.SetOpacity(0);
    bullets(count);
}

fun on_question(text, typed) {
    dialog(text, 1);
    bullets(0);
    answer.SetImage(Image.Text(typed + " ", 0.96, 0.96, 0.97, 1, font));
    answer.SetPosition(ex + entry_image.GetHeight(), ey + entry_image.GetHeight() / 2 - answer.GetImage().GetHeight() / 2, 101);
    answer.SetOpacity(1);
}

fun on_normal() {
    global.dialog_on = 0;
    prompt.SetOpacity(0);
    entry.SetOpacity(0);
    lock.SetOpacity(0);
    answer.SetOpacity(0);
    bullets(0);
}

Plymouth.SetDisplayPasswordFunction(on_password);
Plymouth.SetDisplayQuestionFunction(on_question);
Plymouth.SetDisplayNormalFunction(on_normal);

# Updates applied while starting (firmware, offline upgrades): a thin glass bar
# and the percentage in the word's place.
bar_back = Sprite(load("bar-back"));
at(bar_back, spr["bar-back"].x, spr["bar-back"].y, 90);
bar_back.SetOpacity(0);
bar_front = load("bar");
bar = Sprite();
percent = Sprite();

fun on_update(progress) {
    local.p = Math.Clamp(progress / 100, 0, 1);
    global.dialog_on = 1;
    bar_back.SetOpacity(1);
    if (p > 0) {
        bar.SetImage(bar_front.Scale(Math.Max(1, Math.Int(bar_front.GetWidth() * p)), bar_front.GetHeight()));
        bar.SetPosition(bar_back.GetX(), bar_back.GetY(), 91);
        bar.SetOpacity(1);
    }
    percent.SetImage(Image.Text(Math.Int(progress) + " %", 0.62, 0.70, 0.77, 1, font));
    percent.SetPosition(Window.GetX() + SW / 2 - percent.GetImage().GetWidth() / 2, bar_back.GetY() + SH * 0.015, 90);
    percent.SetOpacity(1);
}
Plymouth.SetSystemUpdateFunction(on_update);

message = Sprite();
fun on_message(text) {
    message.SetImage(Image.Text(text, 0.62, 0.70, 0.77, 1, font));
    message.SetPosition(Window.GetX() + SW / 2 - message.GetImage().GetWidth() / 2, Window.GetY() + SH * 0.88, 100);
    message.SetOpacity(1);
}
fun on_hide_message(text) { message.SetOpacity(0); }
Plymouth.SetDisplayMessageFunction(on_message);
Plymouth.SetHideMessageFunction(on_hide_message);
