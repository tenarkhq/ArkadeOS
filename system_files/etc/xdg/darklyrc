# ArkadeOS Glass (T086, Roland, 2026-11-14: "nem csak egy fejléccel ... de ez
# igaz minden ablakra", then "nem homogén a UI"): every KDE window is one
# glass with the Darkly style. The colour scheme gives the window the same
# see-through sky blue as its title area, so the title bar, menu bar,
# toolbars, sidebars and status bar are one surface over the blur behind
# (Better Blur DX, kwinrc); file lists and text areas stay solid so they read
# well. Dolphin's sidebar takes the window's own glass (Darkly's default).
[Style]
CornerRadius=8
MenuOpacity=82
DolphinViewOpacity=100
TransparentDolphinView=false
OpaqueInactiveWindows=false
