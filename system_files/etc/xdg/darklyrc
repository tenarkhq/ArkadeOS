# ArkadeOS Glass (T086, Roland, 2026-11-14: "nem csak egy fejléccel ... de ez
# igaz minden ablakra", then "nem homogén a UI", then on the first and the
# fourth run: the see-through sidebar of the first run is right, only the
# menu bar and the toolbar were wrong): every KDE window is one glass with the
# Darkly style. Darkly paints the menu bar, the toolbars, the tab bars and
# Dolphin's sidebar at their own opacity, solid by default (100), whatever the
# colour scheme's alpha; all four take the title bar's glass strength here
# (the title area is 53 % dark, 58 % light), over the blur behind (Better
# Blur DX, kwinrc). The menu bar and the toolbars take the title area's sky
# blue (the colour scheme's Header colours), the sidebar a neutral smoke (its
# Window colours), as in the approved design.
# File lists and text areas stay solid so they read well.
[Style]
CornerRadius=8
MenuOpacity=82
MenuBarOpacity=55
ToolBarOpacity=55
TabBarOpacity=55
DolphinSidebarOpacity=55
DolphinViewOpacity=100
TransparentDolphinView=false
OpaqueInactiveWindows=false
