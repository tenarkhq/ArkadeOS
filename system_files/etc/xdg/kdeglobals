# ArkadeOS defaults (T006). Fedora's own defaults sit below these in
# /usr/share/kde-settings; the global theme fills in colours, icons and style.
[General]
font=Inter,10,-1,5,50,0,0,0,0,0
menuFont=Inter,10,-1,5,50,0,0,0,0,0
smallestReadableFont=Inter,8,-1,5,50,0,0,0,0,0
toolBarFont=Inter,9,-1,5,50,0,0,0,0,0

[KDE]
LookAndFeelPackage=org.arkadeos.light.desktop
DefaultLightLookAndFeel=org.arkadeos.light.desktop
DefaultDarkLookAndFeel=org.arkadeos.dark.desktop
AutomaticLookAndFeel=true
# Animations one step faster than Plasma's: quicker, still pleasant to watch
# (Roland, 2026-11-01).
AnimationDurationFactor=0.5
