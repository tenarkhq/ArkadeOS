# ArkadeOS window manager defaults (T007). Fedora's own kwinrc sits below this
# in /usr/share/kde-settings; the global theme sets the window decoration.

# macOS-style window buttons on the left: close, minimise, maximise.
[org.kde.kdecoration2]
ButtonsOnLeft=XIA
ButtonsOnRight=

# Hot corners: bottom left opens the Overview, bottom right shows the desktop.
# The top corners stay free for the launcher logo and the tray.
[Effect-overview]
BorderActivate=5

[ElectricBorders]
BottomRight=ShowDesktop

# Pinned windows keep their icon on the dock (T068); a borderless game the
# size of the screen runs full screen, above the bars (T070).
[Plugins]
arkadeos-dock-namesEnabled=true
arkadeos-borderless-fullscreenEnabled=true

# No on-screen keyboard: Plasma starts plasma-keyboard by default, and on a
# laptop it pops up over games and apps (T071). A touch-screen user can pick
# it in System Settings > Keyboard > Virtual Keyboard.
[Wayland]
InputMethod=
