#!/usr/bin/python3 -I
"""Laptop keyboards whose light speaks HID LampArray (Roland's ASUS TUF A16
FA608, 2026-11-03): the kernel's asus::kbd_backlight takes the brightness
slider's value but the keyboard ignores it, the ITE5570 controller is set
over I2C-HID. The slider and the lighting come here (game-profile,
arkadeos-rgb); without such a keyboard it does nothing.
  lamparray LEVEL [RRGGBB]   LEVEL 0-100; the colour stays when not given"""
import fcntl
import os
import re
import sys
from pathlib import Path

STATE = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "arkadeos-lamparray-colour"


def ioc(nr, size):  # _IOC(_IOC_READ | _IOC_WRITE, 'H', nr, size)
    return (3 << 30) | (size << 16) | (ord("H") << 8) | nr


def keyboards():
    for node in sorted(Path("/sys/class/hidraw").glob("hidraw*")):
        try:
            desc = (node / "device/report_descriptor").read_bytes()
        except OSError:
            continue
        # Usage Page 0x59 (Lighting and Illumination), short or long form.
        if b"\x05\x59" in desc or b"\x06\x59\x00" in desc:
            yield Path("/dev") / node.name


def main():
    if len(sys.argv) not in (2, 3) or not sys.argv[1].isdigit() or \
            (len(sys.argv) == 3 and not re.fullmatch(r"[0-9a-fA-F]{6}", sys.argv[2])):
        sys.exit(__doc__)
    level = min(int(sys.argv[1]), 100)
    if len(sys.argv) == 3:
        STATE.write_text(sys.argv[2].lower())
    try:
        colour = STATE.read_text().strip()
    except OSError:
        colour = "ffffff"
    r, g, b = (int(colour[i:i + 2], 16) for i in (0, 2, 4))
    for dev in keyboards():
        try:
            fd = os.open(dev, os.O_RDWR)
        except OSError:
            continue
        try:
            # The computer sets the lamps, not the keyboard's own effect.
            fcntl.ioctl(fd, ioc(0x06, 2), bytes([0x46, 0x00]))
            attr = bytearray(23)
            attr[0] = 0x41  # LampArrayAttributes: the number of lamps
            fcntl.ioctl(fd, ioc(0x07, len(attr)), attr)
            last = max(int.from_bytes(attr[1:3], "little"), 1) - 1
            # LampRangeUpdate: every lamp, update complete.
            update = bytes([0x45, 0x01, 0, 0, last & 0xFF, last >> 8, r, g, b, round(level * 255 / 100)])
            fcntl.ioctl(fd, ioc(0x06, len(update)), update)
        except OSError:
            pass
        finally:
            os.close(fd)


if __name__ == "__main__":
    main()
