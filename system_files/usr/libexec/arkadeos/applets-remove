#!/usr/bin/python3
"""Removes widgets from Plasma's layout file while Plasma is not running.

  applets-remove FILE PLUGIN...

Every [Containments][N][Applets][M] group whose plugin is one of PLUGIN goes,
with its subgroups, and M leaves the containment's AppletOrder. The rest of
the file stays byte for byte. Used by the early update steps (migrate --early),
which run before plasmashell reads the file.
"""
import re
import sys

path, plugins = sys.argv[1], set(sys.argv[2:])
lines = open(path, encoding="utf-8").read().splitlines(keepends=True)

# The file as groups: (header, [header line + its lines]).
groups, current = [], ("", [])
for line in lines:
    if line.startswith("["):
        groups.append(current)
        current = (line.strip(), [line])
    else:
        current[1].append(line)
groups.append(current)

applet = re.compile(r"^\[Containments\]\[(\d+)\]\[Applets\]\[(\d+)\]$")
gone = set()  # (containment, applet)
for header, body in groups:
    m = applet.match(header)
    if m and any(l.strip() in {f"plugin={p}" for p in plugins} for l in body[1:]):
        gone.add((m.group(1), m.group(2)))
if not gone:
    sys.exit(0)

prefix = re.compile(r"^\[Containments\]\[(\d+)\]\[Applets\]\[(\d+)\]")
out = []
for header, body in groups:
    m = prefix.match(header)
    if m and (m.group(1), m.group(2)) in gone:
        continue
    g = re.match(r"^\[Containments\]\[(\d+)\]\[General\]$", header)
    if g:
        ids = {a for c, a in gone if c == g.group(1)}
        body = [re.sub(r"^(AppletOrder=)(.*)$",
                       lambda o: o.group(1) + ";".join(x for x in o.group(2).split(";") if x not in ids),
                       l.rstrip("\n")) + ("\n" if l.endswith("\n") else "")
                if l.startswith("AppletOrder=") else l for l in body]
    out.extend(body)
open(path, "w", encoding="utf-8").write("".join(out))
print(f"applets-remove: {len(gone)} removed from {path}")
