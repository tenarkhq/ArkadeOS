#!/usr/bin/bash
# Sets an ArkadeOS power profile as root (T011): battery, balanced and gaming
# through the standard power profile service, max (only on the charger) and
# wow (T055) straight in TuneD. /run/arkadeos/power-max and power-wow mark
# them while they are on.
set -euo pipefail

flags=(/run/arkadeos/power-max /run/arkadeos/power-wow)

on_battery() {
    busctl get-property org.freedesktop.UPower /org/freedesktop/UPower org.freedesktop.UPower OnBattery 2>/dev/null |
        grep -q true
}

# Battery care (T046, T047, T013): charging stops at 80%. ASUS through asusd
# (it keeps its own limit), Lenovo IdeaPad/Legion through conservation mode,
# the rest (MSI and most laptops) through the kernel's standard limit.
charge() {
    local limit=100 f
    [[ "$1" == on ]] && limit=80
    if systemctl is-active -q asusd.service; then
        asusctl battery limit "${limit}"
        return
    fi
    for f in /sys/bus/platform/drivers/ideapad_acpi/*/conservation_mode; do
        [[ -f "${f}" ]] && { [[ "${limit}" == 80 ]] && echo 1 > "${f}" || echo 0 > "${f}"; return; }
    done
    for f in /sys/class/power_supply/BAT*/charge_control_end_threshold; do
        [[ -f "${f}" ]] && echo "${limit}" > "${f}"
    done
}

case "${1:-}" in
    charge)
        case "${2:-}" in on|off) charge "$2"; exit 0 ;; *) echo "usage: $0 charge <on|off>" >&2; exit 2 ;; esac
        ;;
    battery) ppd=power-saver ;;
    balanced) ppd=balanced ;;
    gaming) ppd=performance ;;
    max)
        if on_battery; then
            echo "Max only runs on the charger" >&2
            exit 1
        fi
        mkdir -p /run/arkadeos
        rm -f "${flags[@]}"
        touch /run/arkadeos/power-max
        exec tuned-adm profile arkadeos-max
        ;;
    wow)
        mkdir -p /run/arkadeos
        rm -f "${flags[@]}"
        touch /run/arkadeos/power-wow
        exec tuned-adm profile arkadeos-wow
        ;;
    *) echo "usage: $0 <battery|balanced|gaming|max|wow> | charge <on|off>" >&2; exit 2 ;;
esac

rm -f "${flags[@]}"
busctl set-property net.hadess.PowerProfiles /net/hadess/PowerProfiles net.hadess.PowerProfiles ActiveProfile s "${ppd}"
