#!/usr/bin/bash
# Per-user setup at each login, and again when apps are installed or removed
# (arkadeos-session-setup.path): game folders out of home snapshots, Steam
# Game Mode shortcuts, EasyEffects microphone noise filter, stores on the dock,
# one-time update steps for the user's settings.
set -uo pipefail

IFS=: read -ra app_dirs <<< "${XDG_DATA_HOME:-${HOME}/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
app_dirs+=(/var/lib/flatpak/exports/share "${HOME}/.local/share/flatpak/exports/share")
has_app() {
    local d
    for d in "${app_dirs[@]}"; do
        [[ -f "${d}/applications/$1" ]] && return 0
    done
    return 1
}

# New ArkadeOS defaults for this user's existing settings (T051).
/usr/libexec/arkadeos/migrate

# The folders browsers put web apps in (T067): Flatpak only lets Chrome reach
# them when they exist, and a new user has neither.
mkdir -p "${HOME}/.local/share/applications" "${HOME}/.local/share/icons"
# Chrome web apps on the dock: on Wayland KWin looks for the window's menu
# entry by the name chrome-<app>-<profile>.desktop, but Chrome saves it with a
# com.google.Chrome.flextop. prefix, so a pinned web app disappears once it is
# closed. A hidden copy under the expected name fixes that; it goes with the
# web app.
apps_dir="${HOME}/.local/share/applications"
for f in "${apps_dir}"/com.google.Chrome.flextop.chrome-*.desktop; do
    [[ -f "${f}" ]] || continue
    id=$(basename "${f}" .desktop)
    id=${id#com.google.Chrome.flextop.}
    # Chrome points the icon into its sandbox (~/.var/app/...), which the dock
    # cannot read; the same file is in ~/.local/share/icons. A full path: by
    # name the icon loader falls back to Chrome's own icon.
    grep -q '^Icon=.*/\.var/app/.*/icons/' "${f}" &&
        sed -i "s|^Icon=.*/\.var/app/[^/]*/data/icons/|Icon=${HOME}/.local/share/icons/|" "${f}"
    # (also an icon given by that name)
    grep -q '^Icon=chrome-[^/]*$' "${f}" &&
        sed -i "s|^Icon=\(chrome-[^/]*\)$|Icon=${HOME}/.local/share/icons/hicolor/256x256/apps/\1.png|" "${f}"
    twin=$(sed -e '/^NoDisplay=/d' -e "s/^StartupWMClass=.*/StartupWMClass=${id}/" \
        -e '/^\[Desktop Entry\]/a NoDisplay=true' "${f}")
    [[ "$(cat "${apps_dir}/${id}.desktop" 2>/dev/null)" == "${twin}" ]] || printf '%s\n' "${twin}" > "${apps_dir}/${id}.desktop"
done
for f in "${apps_dir}"/chrome-*.desktop; do
    [[ -f "${f}" && ! -f "${apps_dir}/com.google.Chrome.flextop.$(basename "${f}")" ]] && rm -f "${f}"
done

# Game folders as their own btrfs subvolumes (T025): the daily home snapshots
# then leave out games, which are large and can be downloaded again.
if [[ "$(stat -f -c %T "${HOME}")" == btrfs ]]; then
    for d in "${HOME}/Games" "${HOME}/.local/share/Steam"; do
        [[ -e "${d}" ]] || { mkdir -p "$(dirname "${d}")"; btrfs subvolume create "${d}" >/dev/null; }
    done
fi

# Steam Game Mode shortcuts (T014); written only while Steam is closed.
grep -v '^#' /usr/share/arkadeos/steam-shortcuts.list | while IFS='|' read -r name exe icon; do
    /usr/libexec/arkadeos/steam-shortcut "${name}" "${exe}" "${icon}"
done

# EasyEffects (T016): noise filter on every microphone, running in the
# background from login. Set up once; the user's own changes stay.
ee=com.github.wwmm.easyeffects
stamp="${XDG_STATE_HOME:-${HOME}/.local/state}/arkadeos/easyeffects"
if has_app "${ee}.desktop" && [[ ! -e "${stamp}" ]]; then
    data="${HOME}/.var/app/${ee}/data/easyeffects/input"
    conf="${HOME}/.var/app/${ee}/config/easyeffects/db/easyeffectsrc"
    mkdir -p "${data}" "$(dirname "${conf}")" "${HOME}/.config/autostart" "$(dirname "${stamp}")"
    cp /usr/share/arkadeos/easyeffects/*.json "${data}/"
    kwriteconfig6 --file "${conf}" --group Window --key inputAutoloadingUsesFallback true
    kwriteconfig6 --file "${conf}" --group Window --key inputAutoloadingFallbackPreset "ArkadeOS mikrofon"
    kwriteconfig6 --file "${conf}" --group Presets --key lastLoadedInputPreset "ArkadeOS mikrofon"
    cp /usr/share/arkadeos/easyeffects/easyeffects-service.desktop "${HOME}/.config/autostart/${ee}.desktop"
    touch "${stamp}"
    # Its own unit: started from this one-shot service with a plain "&", it is
    # killed when the service ends if flatpak has not yet moved it to its scope.
    systemd-run --user --collect --quiet flatpak run "${ee}" --service-mode --hide-window
fi

# Stores on the dock (T018): one appears when it gets installed and goes when
# it is removed; one the user took off the dock is not put back.
present=""
for store in steam.desktop org.arkadeos.BattleNet.desktop com.heroicgameslauncher.hgl.desktop \
    net.lutris.Lutris.desktop org.arkadeos.EA.desktop org.arkadeos.Ubisoft.desktop; do
    has_app "${store}" && on=true || on=false
    present+="\"applications:${store}\": ${on}, "
done
js=$(sed "s|@PRESENT@|{${present%, }}|" /usr/share/arkadeos/dock-stores.js)
for _ in $(seq 30); do
    busctl --user call org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell evaluateScript s "${js}" \
        &>/dev/null && break
    sleep 2
done
