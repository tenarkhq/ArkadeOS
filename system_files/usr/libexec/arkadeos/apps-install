#!/usr/bin/bash
# Installs the apps of /usr/share/arkadeos/apps.list that should be on this
# machine: the always ones (unless the installer's choice left them out), and
# the chosen ones (/etc/arkadeos/apps, written by
# the installer's choice or the Portal's first start) or the default ones when
# nothing was chosen. Each app is installed once: one the user removed later
# (in the Portal or by hand) does not come back, and apps are never removed here.
set -euo pipefail

chosen=/etc/arkadeos/apps
done_list=/var/lib/arkadeos/apps-done
mkdir -p "$(dirname "${done_list}")"
touch "${done_list}"
want=() ids=()
while IFS='|' read -r id ref default; do
    [[ -z "${id}" || "${id}" == \#* ]] && continue
    grep -qx "${id}" "${done_list}" && continue
    # A choice made in the installer covers the always ones too.
    if { [[ "${default}" == always && ! -f /etc/arkadeos/apps-from-installer ]]; } ||
        { [[ -f "${chosen}" ]] && grep -qx "${id}" "${chosen}"; } ||
        { [[ ! -f "${chosen}" && "${default}" == on ]]; }; then
        ids+=("${id}")
        flatpak info --system "${ref}" &>/dev/null || want+=("${ref}")
    fi
done < /usr/share/arkadeos/apps.list

if [[ ${#want[@]} -gt 0 ]]; then
    flatpak remote-add --if-not-exists --system flathub /etc/flatpak/remotes.d/flathub.flatpakrepo
    flatpak install --system --noninteractive --or-update flathub "${want[@]}"
fi
[[ ${#ids[@]} -gt 0 ]] && printf '%s\n' "${ids[@]}" >> "${done_list}"

# Chromium-based browsers install web apps (Claude, YouTube, ...) as menu
# entries: they need the user's applications and icons folders, which their
# Flathub sandbox leaves out. Given as home paths: xdg-data/applications is
# also mounted on the app's own data/applications, which is a symlink there,
# and the browser then does not start. Set every boot, also for ones
# installed later.
for app in com.google.Chrome org.chromium.Chromium com.brave.Browser com.microsoft.Edge; do
    flatpak override --system \
        --filesystem=~/.local/share/applications --filesystem=~/.local/share/icons "${app}"
done
exit 0
