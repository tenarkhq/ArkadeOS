#!/usr/bin/bash
# Exit 0 when no game runs, 1 while one does (T050): the background jobs that
# can wait run it first (updates, snapshot cleanup, disk trim, the firmware
# list). The game watcher (game-profile) keeps the mark arkadeos-game in the
# user's /run/user folder for as long as a game runs, whatever profile the
# game is on.
if compgen -G '/run/user/*/arkadeos-game' >/dev/null; then
    echo "a game is running: not now"
    exit 1
fi
exit 0
