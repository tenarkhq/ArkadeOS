#!/usr/bin/python3
"""Sets the power profile of the running game (T011, T034), and lets it go
when the game exits, so the profile chosen before comes back.

A game is running when Steam has launched one (its reaper process), when a
Windows game runs under Wine or Proton (wineserver, Battle.net through umu
too), or when a game asked GameMode for its tweaks.

Its profile, first match wins:
  1. ARKADEOS_PROFILE in the game's environment; in Steam's launch options:
     ARKADEOS_PROFILE=battery %command%
  2. ~/.config/arkadeos/game-profiles.conf, then /usr/share/arkadeos/game-profiles.conf:
     lines of <Steam AppId or program name>=<profile>, e.g. Wow.exe=wow
     (arkadeos-power game writes the first)
  3. gaming
Profiles: battery, balanced, gaming, max (max only on the charger, else
gaming), wow (full CPU, held-back GPU, T055). Max or WoW set by hand is left
alone.

It also sets the lighting of the profile in force whenever that changes, by
hand or by itself (arkadeos-rgb, T042), and when a game starts, a model the
local AI (Ollama, T019) holds lets go of the video memory (T050). While a game
runs, notifications wait (do not disturb, T062)."""
import os
import re
import subprocess
import time
from pathlib import Path

import json
import urllib.request

import dbus

FLAGS = {"max": "/run/arkadeos/power-max", "wow": "/run/arkadeos/power-wow"}
DIRECT = tuple(FLAGS)  # set straight in TuneD by power-set, not held through PPD
UID = os.getuid()
PROFILES = ("battery", "balanced", "gaming", "max", "wow")
CONFS = [Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "arkadeos/game-profiles.conf",
         Path("/usr/share/arkadeos/game-profiles.conf")]


def user_processes():
    for p in Path("/proc").iterdir():
        if p.name.isdigit():
            try:
                if p.stat().st_uid == UID:
                    yield p
            except OSError:
                pass


def read(p, name):
    try:
        return (p / name).read_bytes().split(b"\0")
    except OSError:
        return []


def table():
    out = {}
    for conf in reversed(CONFS):  # the user's file wins
        try:
            for line in conf.read_text().splitlines():
                key, _, value = line.partition("=")
                if key.strip() and not key.startswith("#") and value.strip() in PROFILES:
                    out[key.strip().lower()] = value.strip()
        except OSError:
            pass
    return out


def running_game():
    """None when no game runs, else the profile the game wants."""
    names, env_profile, game = table(), None, False
    keys = []
    for p in user_processes():
        cmd = [c.decode(errors="replace") for c in read(p, "cmdline") if c]
        if not cmd:
            continue
        line = " ".join(cmd)
        appid = re.search(r"SteamLaunch AppId=(\d+)", line)
        if appid:
            game = True
            keys.append(appid.group(1))
        if os.path.basename(cmd[0]) == "wineserver":
            game = True
        for c in cmd:
            if c.lower().endswith(".exe"):
                keys.append(re.split(r"[\\/]", c)[-1].lower())
        for e in read(p, "environ"):
            if e.startswith(b"ARKADEOS_PROFILE="):
                value = e.split(b"=", 1)[1].decode(errors="replace")
                if value in PROFILES:
                    env_profile = value
    if not game:
        status = subprocess.run(["gamemoded", "-s"], capture_output=True, text=True)
        game = "is active" in status.stdout
    if not game:
        return None
    if env_profile:
        return env_profile
    for k in keys:
        if k.lower() in names:
            return names[k.lower()]
    return "gaming"


def on_battery(bus):
    up = bus.get_object("org.freedesktop.UPower", "/org/freedesktop/UPower")
    return bool(up.Get("org.freedesktop.UPower", "OnBattery", dbus_interface="org.freedesktop.DBus.Properties"))


def power_set(profile):
    subprocess.run(["pkexec", "/usr/libexec/arkadeos/power-set", profile], check=False)


def profile_in_force(bus):
    """battery | balanced | gaming | max | wow, as arkadeos-power status shows it."""
    for name, flag in FLAGS.items():
        if os.path.exists(flag):
            return name
    props = dbus.Interface(bus.get_object("net.hadess.PowerProfiles", "/net/hadess/PowerProfiles"),
                           "org.freedesktop.DBus.Properties")
    active = str(props.Get("net.hadess.PowerProfiles", "ActiveProfile"))
    if active == "power-saver":
        return "battery"
    if active == "performance":
        return "gaming"
    return "battery" if on_battery(bus) else "balanced"


def unload_ai_models():
    """Ollama keeps a used model in video memory for a while; a game needs it."""
    try:
        with urllib.request.urlopen("http://127.0.0.1:11434/api/ps", timeout=2) as r:
            models = [m["name"] for m in json.load(r).get("models", [])]
        for name in models:
            body = json.dumps({"model": name, "keep_alive": 0}).encode()
            urllib.request.urlopen(urllib.request.Request(
                "http://127.0.0.1:11434/api/generate", data=body,
                headers={"Content-Type": "application/json"}), timeout=10).read()
    except (OSError, ValueError):
        pass  # no Ollama running


def quiet(on, state):
    """Do not disturb while a game runs: Plasma holds back the notifications
    until UnInhibit (or until this program exits)."""
    try:
        notes = dbus.Interface(dbus.SessionBus().get_object("org.freedesktop.Notifications",
                                                            "/org/freedesktop/Notifications"),
                               "org.freedesktop.Notifications")
        if on and state.get("quiet") is None:
            state["quiet"] = notes.Inhibit("org.arkadeos.GameProfile", "Game running",
                                           dbus.Dictionary({}, signature="sv"))
        elif not on and state.get("quiet") is not None:
            notes.UnInhibit(state.pop("quiet"))
    except dbus.exceptions.DBusException:
        state.pop("quiet", None)


def main():
    bus = dbus.SystemBus()
    state = {}
    ppd = dbus.Interface(bus.get_object("net.hadess.PowerProfiles", "/net/hadess/PowerProfiles"),
                         "net.hadess.PowerProfiles")
    cookie = None    # our PPD hold (battery or gaming)
    ours = None      # Max or WoW we switched on for the game
    current = None   # profile we applied for the running game
    lit = None       # profile whose lighting is set
    while True:
        try:
            now = profile_in_force(bus)
            if now != lit:
                lit = now
                subprocess.Popen(["arkadeos-rgb", "apply", now], stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL)
        except dbus.exceptions.DBusException:
            pass
        want = running_game()
        if want == "max":
            try:
                if on_battery(bus):
                    want = "gaming"
            except dbus.exceptions.DBusException:
                want = "gaming"
        if ours is None and any(os.path.exists(f) for f in FLAGS.values()):
            want = None  # Max or WoW by hand: leave it alone
        if want != current:
            try:
                if cookie is not None:
                    held, cookie = cookie, None
                    ppd.ReleaseProfile(held)
            except dbus.exceptions.DBusException:
                pass
            if ours is not None and want != ours:
                if want not in DIRECT:
                    power_set("balanced")
                ours = None
            if want in ("battery", "gaming"):
                try:
                    cookie = ppd.HoldProfile("power-saver" if want == "battery" else "performance",
                                             "Game running", "org.arkadeos.GameProfile")
                except dbus.exceptions.DBusException:
                    cookie = None
            elif want in DIRECT:
                power_set(want)
                ours = want
            # Marks a game on Max or WoW for no-game-running and
            # arkadeos-power status (no PPD hold then).
            mark = Path(f"/run/user/{UID}/arkadeos-game-max")
            if want in DIRECT:
                mark.touch()
            else:
                mark.unlink(missing_ok=True)
            if want is not None and current is None:
                unload_ai_models()
            quiet(want is not None, state)
            current = want
        time.sleep(3)


if __name__ == "__main__":
    main()
