#!/usr/bin/python3
"""Sets the power profile of the running game (T011, T034), and lets it go
when the game exits, so the profile chosen before comes back.

A game is running when Steam has launched one (its reaper process), when a
Windows game runs under Wine or Proton (wineserver, Battle.net through umu
too), or when a game asked GameMode for its tweaks.

Its profile, first match wins:
  1. ARKADEOS_PROFILE in the game's environment; in Steam's launch options:
     ARKADEOS_PROFILE=battery %command%
  2. ~/.config/arkadeos/game-profiles.conf, then /usr/share/arkadeos/game-profiles.conf:
     lines of <Steam AppId or program name>=<profile>, e.g. Wow.exe=wow
     (arkadeos-power game writes the first)
  3. gaming
Profiles: battery, balanced, gaming, max (max only on the charger, else
gaming), wow (full CPU, held-back GPU, T055). Max or WoW set by hand is left
alone.

It also sets the lighting of the profile in force whenever that changes, by
hand or by itself (arkadeos-rgb, T042), and dims or brightens it with the
keyboard brightness slider (T044). While a game runs, notifications wait
(do not disturb, T062).

While WoW is on, a Windows game runs on one group of cores where the
processor has several, each with a cache of its own: the two halves (CCDs) of
a Ryzen 9, say (T084, game_cpus). arkadeos-power ccd off lets it use every
core again.

It looks every three seconds, for as long as the session lasts, so a look
costs little (T050): it lists the processes, and reads only the new ones."""
import os
import re
import subprocess
import sys
import time
from pathlib import Path


import dbus

FLAGS = {"max": "/run/arkadeos/power-max", "wow": "/run/arkadeos/power-wow"}
# Wine's own programs (its services, tools and helpers) run from its Windows
# folder, and a game never does. Wine 11 has lsass.exe running there for as
# long as any program of the prefix runs, which made a launcher alone a game:
# Gaming, and no update, with only Battle.net open (Roland, 2026-11-12).
WINE_OWN = re.compile(r"(?:\\\\\?\\|\\\?\?\\)?c:[\\/]+windows[\\/]", re.IGNORECASE)
# Windows programs that are not games by their name: Wine's own where they
# are started without their folder, Proton's helper beside every desktop
# program (xalia.exe), and the stores' launchers with their helpers
# (Battle.net, EA app, Ubisoft Connect, Steam for Windows).
NOT_GAMES = {
    "services.exe", "winedevice.exe", "plugplay.exe", "svchost.exe", "rpcss.exe", "explorer.exe",
    "conhost.exe", "tabtip.exe", "wineboot.exe", "start.exe", "rundll32.exe", "winemenubuilder.exe",
    "mscorsvw.exe", "cmd.exe", "xalia.exe", "steam.exe", "steamwebhelper.exe", "crashpad_handler.exe",
    "battle.net.exe", "battle.net launcher.exe", "battle.net helper.exe", "agent.exe", "blizzarderror.exe",
    "blizzard update agent.exe", "eadesktop.exe", "eabackgroundservice.exe", "ealocalhostsvc.exe",
    "eaconnect_microsoft.exe", "qtwebengineprocess.exe", "upc.exe", "ubisoftconnect.exe",
    "uplaywebcore.exe", "uplayservice.exe", "ubisoftgamelauncher.exe", "ubisoftgamelauncher64.exe",
}
DIRECT = tuple(FLAGS)  # set straight in TuneD by power-set, not held through PPD
UID = os.getuid()
PROFILES = ("battery", "balanced", "gaming", "max", "wow")
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "arkadeos"
CONFS = [CONFIG / "game-profiles.conf", Path("/usr/share/arkadeos/game-profiles.conf")]
CCD_OFF = CONFIG / "ccd-off"  # arkadeos-power ccd off
# A process is read again 1, 2, 4... looks after it appeared, then every
# MAX_GAP looks (a minute and a half).
MAX_GAP = 32


def facts(pid):
    """What one process says about a running game, or None for nothing: its
    Steam AppId, whether it is a wineserver, the Windows programs on its
    command line (without Wine's own), and the profile in its environment."""
    try:
        if os.stat(f"/proc/{pid}").st_uid != UID:
            return None
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            cmd = [c.decode(errors="replace") for c in f.read().split(b"\0") if c]
        if not cmd:
            return None
        with open(f"/proc/{pid}/environ", "rb") as f:
            env = re.search(rb"(?:^|\0)ARKADEOS_PROFILE=([^\0]*)", f.read())
    except OSError:
        return None
    appid = re.search(r"SteamLaunch AppId=(\d+)", " ".join(cmd))
    appid = int(appid.group(1)) if appid else None
    wineserver = os.path.basename(cmd[0]) == "wineserver"
    exes = tuple(re.split(r"[\\/]", c)[-1].lower() for c in cmd
                 if c.lower().endswith(".exe") and not WINE_OWN.match(c))
    profile = env.group(1).decode(errors="replace") if env else None
    if profile not in PROFILES:
        profile = None
    if appid is None and not wineserver and not exes and profile is None:
        return None
    return appid, wineserver, exes, profile


def read_table():
    out = {}
    for conf in reversed(CONFS):  # the user's file wins
        try:
            for line in conf.read_text().splitlines():
                key, _, value = line.partition("=")
                if key.strip() and not key.startswith("#") and value.strip() in PROFILES:
                    out[key.strip().lower()] = value.strip()
        except OSError:
            pass
    return out


def gamemode_active():
    """A game asked GameMode for its tweaks. Its daemon starts when a game
    asks; the question alone does not start it."""
    try:
        session = dbus.SessionBus()
        if not session.name_has_owner("com.feralinteractive.GameMode"):
            return False
        props = dbus.Interface(session.get_object("com.feralinteractive.GameMode", "/com/feralinteractive/GameMode",
                                                  introspect=False), "org.freedesktop.DBus.Properties")
        return int(props.Get("com.feralinteractive.GameMode", "ClientCount")) > 0
    except dbus.exceptions.DBusException:
        return False


class Games:
    """The running game, from the user's processes.

    What a process says about a game (facts) stays the same for as long as it
    lives, unless it starts another program in its own place. So every look
    lists the processes, and reads only the ones that are new or due again."""

    def __init__(self):
        self.looks = 0
        self.seen = {}     # pid: [look it is read again, looks until the one after, its facts]
        self.said = {}     # pid: facts, of the processes that say something
        self.stamp = None  # the per-game lists' dates and sizes when they were read
        self.names = {}
        self.found = (False, "gaming", (), "")

    def scan(self):
        """True when a process that says something came, went or changed."""
        self.looks += 1
        changed = False
        alive = set()
        for name in os.listdir("/proc"):
            if not name.isdigit():
                continue
            pid = int(name)
            alive.add(pid)
            entry = self.seen.get(pid)
            if entry is None:
                entry = self.seen[pid] = [self.looks + 1, 1, None]
            elif entry[0] > self.looks:
                continue
            elif entry[1] < MAX_GAP:
                entry[1] *= 2
                # The first long wait differs from process to process, so the
                # ones that appeared together are not all read in one look.
                entry[0] = self.looks + (entry[1] if entry[1] < MAX_GAP else 1 + pid % MAX_GAP)
            else:
                entry[0] = self.looks + MAX_GAP
            now = facts(pid)
            if now != entry[2]:
                entry[2] = now
                changed = True
                if now is None:
                    del self.said[pid]
                else:
                    self.said[pid] = now
        for pid in self.seen.keys() - alive:
            del self.seen[pid]
            if self.said.pop(pid, None) is not None:
                changed = True
        return changed

    def table(self):
        """True when one of the per-game lists changed; they are read again then."""
        stamp = []
        for conf in CONFS:
            try:
                st = conf.stat()
                stamp.append((st.st_mtime_ns, st.st_size))
            except OSError:
                stamp.append(None)
        if stamp == self.stamp:
            return False
        self.stamp, self.names = stamp, read_table()
        return True

    def running(self):
        """(profile, programs, what): the profile the running game wants, None
        when no game runs, the pids of the Windows game programs, and what
        counts as the game (for the mark the Portal and the update read)."""
        # Both run at every look: each keeps its own state up to date.
        changed = [self.scan(), self.table()]
        if any(changed):
            self.found = self.judge()
        game, profile, programs, what = self.found
        if not game:
            if not gamemode_active():
                return None, (), ""
            what = "GameMode"
        return profile, programs, what

    def judge(self):
        """(a game runs, the profile it wants, its Windows programs, what
        counts as the game), as the processes say; GameMode can still say
        that a game runs."""
        game = windows = False  # Steam launched a game; Wine or a Steam shortcut runs
        env_profile, keys, programs, steam, names = None, [], [], [], []
        for pid in sorted(self.said):
            appid, wineserver, exes, profile = self.said[pid]
            if appid is not None:
                # A Steam shortcut of another program (its number is above
                # 2^31, e.g. Battle.net) counts only with a game in it, as
                # Wine does.
                if appid < 2**31:
                    game = True
                    steam.append(f"Steam {appid}")
                else:
                    windows = True
                keys.append(str(appid))
            windows = windows or wineserver
            keys.extend(exes)
            if any(exe not in NOT_GAMES for exe in exes):
                programs.append(pid)
                names.extend(exe for exe in exes if exe not in NOT_GAMES)
            env_profile = profile or env_profile
        # Wine stays up while only a store's launcher runs (Battle.net after
        # the game closed): that is not a game.
        if not windows:
            names = []
        game = game or bool(names)
        profile = env_profile or next((self.names[k] for k in keys if k in self.names), "gaming")
        return game, profile, tuple(programs), ", ".join(dict.fromkeys(steam + names))


def cpu_list(text):
    """The CPU numbers of a kernel list such as 0-7,16-23."""
    out = set()
    for part in text.strip().split(","):
        first, _, last = part.partition("-")
        out.update(range(int(first), int(last or first) + 1))
    return frozenset(out)


def cpu_text(cpus):
    """A set of CPU numbers as the kernel writes it: 0-7,16-23."""
    out, cpus = [], sorted(cpus)
    while cpus:
        last = cpus[0]
        while last + 1 in cpus:
            last += 1
        out.append(str(cpus[0]) if last == cpus[0] else f"{cpus[0]}-{last}")
        cpus = [c for c in cpus if c > last]
    return ",".join(out)


def game_cpus():
    """The CPUs a game on WoW runs on, or None for all of them (T084).

    Where the processor has two or more groups of cores, each with a cache of
    its own (the two CCDs of a Ryzen 9 8940HX or 9950X, or two processors),
    the game's threads stay in one group: they share one cache, and none of
    them moves to a core that has none of the game's data. The group with the
    biggest cache, then the one the firmware rates fastest, then the first.

    None with one group, with groups of different sizes (a processor with big
    and small cores has its own order), with groups under six cores (too few
    for a game), and where the kernel steers games itself (AMD 3D V-Cache,
    x3d-vcache)."""
    sys_cpu = Path(os.environ.get("ARKADEOS_CPU", "/sys/devices/system/cpu"))  # a stand-in tree in the VM test
    least = int(os.environ.get("ARKADEOS_CCD_MIN_CORES", 6))
    if list(Path("/sys/bus/platform/drivers/amd_x3d_vcache").glob("*/amd_x3d_mode")):
        return None
    groups = {}
    for cache in sys_cpu.glob("cpu[0-9]*/cache/index3"):
        try:
            cpus = cpu_list((cache / "shared_cpu_list").read_text())
            size = int(re.sub(r"\D", "", (cache / "size").read_text()) or 0)
        except (OSError, ValueError):
            return None
        groups[cpus] = size
    if len(groups) < 2 or len({len(g) for g in groups}) != 1:
        return None

    def read(cpu, name, default):
        try:
            return (sys_cpu / f"cpu{cpu}" / name).read_text().strip()
        except OSError:
            return default

    best = None
    for cpus, size in groups.items():
        if len({read(c, "topology/core_cpus_list", str(c)) for c in cpus}) < least:
            return None
        speed = max(int(read(c, "acpi_cppc/highest_perf", 0) or 0) for c in cpus)
        rank = (size, speed, -min(cpus))
        if best is None or rank > best[0]:
            best = (rank, cpus)
    return best[1]


def threads(pid):
    try:
        return [int(t) for t in os.listdir(f"/proc/{pid}/task")]
    except OSError:
        return []


def program(pid):
    """Wow.exe (1234), for the log."""
    try:
        return f"{Path(f'/proc/{pid}/comm').read_text().strip()} ({pid})"
    except OSError:
        return f"process {pid}"


def pin(programs, cpus, state):
    """Keeps every thread of the game programs on cpus, also the ones the
    game moved since the last look, and lets the programs go that are no
    longer kept there (cpus None: all of them)."""
    kept = state.setdefault("pinned", {})  # pid: the CPUs it is kept on
    for pid in list(kept):
        if cpus is None or pid not in programs:
            everywhere = os.sched_getaffinity(0)
            was = kept.pop(pid)
            moved = False
            for tid in threads(pid):
                try:
                    if os.sched_getaffinity(tid) == was:
                        os.sched_setaffinity(tid, everywhere)
                        moved = True
                except OSError:
                    pass
            if moved:
                print(f"game-profile: {program(pid)} on every CPU again", file=sys.stderr, flush=True)
    if cpus is None:
        return
    for pid in programs:
        moved = False
        for tid in threads(pid):
            try:
                if not os.sched_getaffinity(tid) <= cpus:
                    os.sched_setaffinity(tid, cpus)
                    moved = True
            except OSError:  # the thread ended meanwhile
                pass
        if moved and pid not in kept:
            print(f"game-profile: {program(pid)} on CPUs {cpu_text(cpus)}", file=sys.stderr, flush=True)
        kept[pid] = cpus


def kbd_level():
    """The keyboard backlight in percent (the brightness slider), or None."""
    for led in sorted(Path("/sys/class/leds").glob("*kbd_backlight")):
        try:
            top = int((led / "max_brightness").read_text())
            if top:
                return round(int((led / "brightness").read_text()) * 100 / top)
        except (OSError, ValueError):
            continue
    return None


def on_battery(bus):
    up = bus.get_object("org.freedesktop.UPower", "/org/freedesktop/UPower")
    return bool(up.Get("org.freedesktop.UPower", "OnBattery", dbus_interface="org.freedesktop.DBus.Properties"))


def power_set(profile):
    subprocess.run(["pkexec", "/usr/libexec/arkadeos/power-set", profile], check=False)


def profile_in_force(bus):
    """battery | balanced | gaming | max | wow, as arkadeos-power status shows it."""
    for name, flag in FLAGS.items():
        if os.path.exists(flag):
            return name
    props = dbus.Interface(bus.get_object("net.hadess.PowerProfiles", "/net/hadess/PowerProfiles"),
                           "org.freedesktop.DBus.Properties")
    active = str(props.Get("net.hadess.PowerProfiles", "ActiveProfile"))
    if active == "power-saver":
        return "battery"
    if active == "performance":
        return "gaming"
    return "battery" if on_battery(bus) else "balanced"


def tuned_active():
    try:
        return Path("/etc/tuned/active_profile").read_text().strip()
    except OSError:
        return None


def quiet(on, state):
    """Do not disturb while a game runs: Plasma holds back the notifications
    until UnInhibit (or until this program exits)."""
    try:
        notes = dbus.Interface(dbus.SessionBus().get_object("org.freedesktop.Notifications",
                                                            "/org/freedesktop/Notifications"),
                               "org.freedesktop.Notifications")
        if on and state.get("quiet") is None:
            state["quiet"] = notes.Inhibit("org.arkadeos.GameProfile", "Game running",
                                           dbus.Dictionary({}, signature="sv"))
        elif not on and state.get("quiet") is not None:
            notes.UnInhibit(state.pop("quiet"))
    except dbus.exceptions.DBusException:
        state.pop("quiet", None)


def main():
    bus = dbus.SystemBus()
    state = {}
    ppd = dbus.Interface(bus.get_object("net.hadess.PowerProfiles", "/net/hadess/PowerProfiles"),
                         "net.hadess.PowerProfiles")
    cookie = None    # our PPD hold (battery or gaming)
    ours = None      # Max or WoW we switched on for the game
    current = None   # profile we applied for the running game
    lit = None       # profile whose lighting is set
    kbd = None       # keyboard brightness the lighting follows
    level = None     # keyboard brightness now
    seen = None      # keyboard brightness at the last look
    heals = 0        # times TuneD was put back under this game
    games = Games()
    try:
        cpus = game_cpus()  # one core group for a game on WoW, where there are several
    except (OSError, ValueError):
        cpus = None
    while True:
        try:
            now = profile_in_force(bus)
            seen, level = level, kbd_level()
            if now != lit:
                lit = now
                kbd = level
                if level:  # the slider's level for the new lighting (not login's passing 0)
                    Path(f"/run/user/{UID}/arkadeos-rgb-level").write_text(f"{level}\n")
                subprocess.Popen(["arkadeos-rgb", "apply", now], stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL)
            elif level != kbd and level == seen:
                # Only a level that stays for a look: at login the keyboard
                # light is 0 for a moment before it is put back. A profile's
                # own keyboard switch (lighting off and on again) comes back
                # here once too; that run sets the same lighting.
                kbd = level
                if level is not None:
                    # A LampArray keyboard (FA608) follows the slider even
                    # in a profile without lighting.
                    subprocess.Popen(["/usr/libexec/arkadeos/lamparray", str(level)],
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    subprocess.Popen(["arkadeos-rgb", "apply", now, str(level)],
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except dbus.exceptions.DBusException:
            pass
        want, programs, what = games.running()
        # The mark the background jobs wait on (no-game-running): a game
        # runs, also on a profile set by hand. It holds what counts as the
        # game (a program's name, Steam with the AppId, GameMode), so the
        # Portal and the update's log can say it (Roland, 2026-11-12).
        if (want is not None, what) != state.get("game"):
            state["game"] = (want is not None, what)
            mark = Path(f"/run/user/{UID}/arkadeos-game")
            if want is not None:
                mark.write_text(f"{what}\n")
            else:
                mark.unlink(missing_ok=True)
        if want == "max":
            try:
                if on_battery(bus):
                    want = "gaming"
            except dbus.exceptions.DBusException:
                want = "gaming"
        if ours is None and any(os.path.exists(f) for f in FLAGS.values()):
            want = None  # Max or WoW by hand: leave it alone
        if want != current:
            released = False
            try:
                if cookie is not None:
                    held, cookie = cookie, None
                    released = True
                    ppd.ReleaseProfile(held)
            except dbus.exceptions.DBusException:
                pass
            if ours is not None and want != ours:
                if want not in DIRECT:
                    power_set("balanced")
                ours = None
            if want in ("battery", "gaming"):
                try:
                    cookie = ppd.HoldProfile("power-saver" if want == "battery" else "performance",
                                             "Game running", "org.arkadeos.GameProfile")
                except dbus.exceptions.DBusException:
                    cookie = None
            elif want in DIRECT:
                if released:
                    time.sleep(2)  # the released hold first puts PPD's own profile back
                power_set(want)
                ours = want
            # Marks a game on Max or WoW for arkadeos-power status (no PPD
            # hold then).
            mark = Path(f"/run/user/{UID}/arkadeos-game-max")
            if want in DIRECT:
                mark.touch()
            else:
                mark.unlink(missing_ok=True)
            quiet(want is not None, state)
            current = want
            heals = 0
        elif (ours is not None and heals < 3 and os.path.exists(FLAGS[ours])
              and tuned_active() not in (None, f"arkadeos-{ours}")):
            # Something else (PPD) switched TuneD under the game; put it back,
            # but never more than three times a game, so two switchers cannot
            # fight for as long as the game runs.
            heals += 1
            print(f"game-profile: TuneD on {tuned_active()} under the game, back to {ours}",
                  file=sys.stderr, flush=True)
            power_set(ours)
        if cpus:
            on = os.path.exists(FLAGS["wow"]) and not CCD_OFF.exists()
            pin(programs, cpus if on else None, state)
        time.sleep(3)


if __name__ == "__main__":
    if sys.argv[1:] == ["cpus"]:  # for arkadeos-power ccd
        print(cpu_text(game_cpus() or ()))
    else:
        main()
