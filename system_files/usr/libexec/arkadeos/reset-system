#!/usr/bin/bash
# Factory reset that keeps the files (T036, like Pop!_OS's refresh install):
# the system settings in /etc go back to the image's, packages layered on top
# are removed, the machine follows its channel's newest build again. Kept: the
# home folders, users and passwords, disks and encryption, network
# connections, machine name, language, keyboard, time zone, printers, the
# login settings, home snapshots, RAID and ArkadeOS's own choices. The old
# /etc is saved first.
#   reset-system         as root; the changes count after a reboot
set -euo pipefail

keep='^((passwd|group|shadow|gshadow|subuid|subgid)-?|\.pwd\.lock|fstab|crypttab|hostname|machine-id|machine-info|locale\.conf|vconsole\.conf|localtime|adjtime|resolv\.conf|X11(/xorg\.conf\.d(/00-keyboard\.conf)?)?|NetworkManager(/system-connections(/.*)?)?|ssh(/.*)?|systemd(/system(/multi-user\.target\.wants(/sshd\.service)?)?)?|arkadeos(/.*)?|plasmalogin\.conf\.d(/.*)?|sddm\.conf\.d(/.*)?|cups(/.*)?|pki(/akmods(/.*)?)?|ostree(/.*)?|snapper(/.*)?|sysconfig(/snapper)?|mdadm\.conf|udisks2(/.*)?|containers(/registries\.conf\.d(/.*)?)?)$'

backup=/var/lib/arkadeos/etc-before-reset-$(date +%Y%m%d-%H%M%S)
mkdir -p "${backup}"
cp -a /etc/. "${backup}/"

# What differs from the image's /etc: M changed, A added, D deleted.
ostree admin config-diff | while read -r change path; do
    [[ "${path}" =~ ${keep} ]] && continue
    case "${change}" in
        M|D) [[ -e "/usr/etc/${path}" || -L "/usr/etc/${path}" ]] && cp -a --remove-destination "/usr/etc/${path}" "/etc/${path}" ;;
        A) rm -rf "/etc/${path}" ;;
    esac
done

rpm-ostree reset --overlays --overrides 2>/dev/null || true
# Back to the channel's newest build if a dated one was chosen.
ref=$(bootc status --json | python3 -c '
import json, sys
print(((json.load(sys.stdin).get("spec") or {}).get("image") or {}).get("image") or "")')
tag=${ref##*:}
if [[ "${tag}" == *-* ]]; then
    bootc switch --enforce-container-sigpolicy "${ref%:*}:${tag%%-*}"
fi
echo "${backup}"
