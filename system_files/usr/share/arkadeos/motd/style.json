{
  "document": {"block_prefix": "\n", "block_suffix": "\n", "color": "252", "margin": 2},
  "block_quote": {"indent": 1, "indent_token": "│ "},
  "paragraph": {},
  "list": {"level_indent": 2},
  "heading": {"block_suffix": "\n", "color": "39", "bold": true},
  "h1": {"prefix": " ", "suffix": " ", "color": "#ffffff", "background_color": "#0860f2", "bold": true},
  "h2": {"prefix": "## "},
  "h3": {"prefix": "### "},
  "text": {},
  "strikethrough": {"crossed_out": true},
  "emph": {"italic": true},
  "strong": {"color": "#ffffff", "bold": true},
  "hr": {"color": "240", "format": "\n--------\n"},
  "item": {"block_prefix": "• "},
  "enumeration": {"block_prefix": ". "},
  "task": {"ticked": "[✓] ", "unticked": "[ ] "},
  "link": {"color": "#6ea8ff", "underline": true},
  "link_text": {"color": "#6ea8ff", "bold": true},
  "image": {"color": "212", "underline": true},
  "image_text": {"color": "243", "format": "Image: {{.text}} →"},
  "code": {"prefix": " ", "suffix": " ", "color": "#7fb0ff", "background_color": "#2b3240"},
  "code_block": {"color": "244", "margin": 2},
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {"block_prefix": "\n🠶 "},
  "html_block": {},
  "html_span": {}
}
