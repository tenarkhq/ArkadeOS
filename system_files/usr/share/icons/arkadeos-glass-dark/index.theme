[Icon Theme]
Name=ArkadeOS Glass Dark
Comment=ArkadeOS: Breeze Dark with the glass taskbar's own tray icons and app icons
Inherits=breeze-dark,hicolor
Example=audio-volume-high-symbolic
FollowsColorScheme=true
DisplayDepth=32
Directories=marks/s,marks/m,marks/l,marks/xl,apps/small,apps/small@2x,apps/small@3x,status/22,status/22@2x,status/22@3x,apps/scalable,apps/scalable@2x,apps/scalable@3x

[marks/s]
Size=32
Context=Applications
Type=Scalable
MinSize=8
MaxSize=32

[marks/m]
Size=48
Context=Applications
Type=Scalable
MinSize=33
MaxSize=63

[marks/l]
Size=96
Context=Applications
Type=Scalable
MinSize=64
MaxSize=159

[marks/xl]
Size=256
Context=Applications
Type=Scalable
MinSize=160
MaxSize=1024

[apps/small]
Size=32
Context=Applications
Type=Scalable
MinSize=8
MaxSize=32

[apps/small@2x]
Size=32
Scale=2
Context=Applications
Type=Scalable
MinSize=8
MaxSize=32

[apps/small@3x]
Size=32
Scale=3
Context=Applications
Type=Scalable
MinSize=8
MaxSize=32

[status/22]
Size=22
Context=Status
Type=Scalable
MinSize=8
MaxSize=256

[status/22@2x]
Size=22
Scale=2
Context=Status
Type=Scalable
MinSize=8
MaxSize=256

[status/22@3x]
Size=22
Scale=3
Context=Status
Type=Scalable
MinSize=8
MaxSize=256

[apps/scalable]
