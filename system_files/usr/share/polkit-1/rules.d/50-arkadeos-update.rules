// "Update now" (Roland, 2026-11-15: "frissítésnél muszáj jelszót kérnie?"):
// the machine's admin users, at the machine, start the update without a
// password, as the daily run does on its own. Only the start of the update
// service; going back to an earlier version and switching the channel still
// ask for it.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "uupd.service" && action.lookup("verb") == "start" &&
        subject.isInGroup("wheel") && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
