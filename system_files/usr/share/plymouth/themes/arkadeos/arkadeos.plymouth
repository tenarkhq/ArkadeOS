[Plymouth Theme]
Name=ArkadeOS
Description=ArkadeOS boot screen (round 9, Írisz + Tervrajz): thin construction lines lay out the Start mark, its six crystal pieces spiral in onto the drawing like a closing iris and snap shut, the gem turns into place with a light line and a hexagonal ring, and the ARKADEOS word comes letter by letter; then a light point circles the faint construction circle until the desktop comes. No words of its own, so it reads the same in every language (T010).
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/arkadeos
ScriptFile=/usr/share/plymouth/themes/arkadeos/arkadeos.script
