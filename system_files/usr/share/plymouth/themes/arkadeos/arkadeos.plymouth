[Plymouth Theme]
Name=ArkadeOS
Description=ArkadeOS boot screen (T082): four streaks in the Ark colours race through the ArkadeOS wordmark and light it; then a white streak runs through it until the desktop comes. No words of its own, so it reads the same in every language (T010).
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/arkadeos
ScriptFile=/usr/share/plymouth/themes/arkadeos/arkadeos.script
