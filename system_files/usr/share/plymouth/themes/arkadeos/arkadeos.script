MOTES = 34; FIELD_Y = 517.24;

SW = Window.GetWidth();
SH = Window.GetHeight();
SC = Math.Min(SW / DW, SH / DH);     # screen px per design unit
OX = Window.GetX() + SW / 2;
OY = Window.GetY() + SH * 0.46;

fun X(x) { return OX + (x - DCX) * SC; }
fun Y(y) { return OY + (y - DCY) * SC; }

fun frac(x) {
    local.i = Math.Int(x);
    if (x < i) i = i - 1;
    return x - i;
}

# A sprite image scaled to this screen.
fun load(name) {
    local.img = Image(name + ".png");
    local.k = SC / (RENDER * spr[name].d);
    local.w = Math.Max(1, Math.Int(img.GetWidth() * k + 0.5));
    local.h = Math.Max(1, Math.Int(img.GetHeight() * k + 0.5));
    return img.Scale(w, h);
}

# Place a sprite so its image's centre is at design point (x, y).
fun at(sprite, x, y, z) {
    local.img = sprite.GetImage();
    sprite.SetPosition(Math.Int(X(x) - img.GetWidth() / 2 + 0.5), Math.Int(Y(y) - img.GetHeight() / 2 + 0.5), z);
}

fun layer(name, z) {
    local.s = Sprite(load(name));
    at(s, spr[name].x, spr[name].y, z);
    s.SetOpacity(0);
    return s;
}

#----------------------------------------- easing: the drawing's cubic Béziers, tabled

fun table(n) {
    local.x1 = bez[n][0]; local.y1 = bez[n][1]; local.x2 = bez[n][2]; local.y2 = bez[n][3];
    local.i = 0; local.j = 0; local.x = 0; local.lo = 0; local.hi = 0; local.m = 0; local.bx = 0;
    for (i = 0; i <= 32; i++) {
        x = i / 32;
        lo = 0; hi = 1;
        for (j = 0; j < 16; j++) {
            m = (lo + hi) / 2;
            bx = 3 * (1 - m) * (1 - m) * m * x1 + 3 * (1 - m) * m * m * x2 + m * m * m;
            if (bx < x) lo = m; else hi = m;
        }
        m = (lo + hi) / 2;
        global.tab[n][i] = 3 * (1 - m) * (1 - m) * m * y1 + 3 * (1 - m) * m * m * y2 + m * m * m;
    }
}
names[0] = "ease-out"; names[1] = "ease-in"; names[2] = "ease-in-out"; names[3] = "out"; names[4] = "in"; names[5] = "pop"; names[6] = "wave";
for (n = 0; n < 7; n++) table(names[n]);

fun ease(n, p) {
    if (p <= 0) return 0;
    if (p >= 1) return 1;
    if (n == "linear") return p;
    local.q = p * 32;
    local.i = Math.Int(q);
    local.f = q - i;
    return tab[n][i] * (1 - f) + tab[n][i + 1] * f;
}

# A layer's opacity at time t (the drawing's keyframes).
fun gatev(name, t) {
    local.n = gate[name].n;
    local.i = 0;
    local.p = 0;
    if (t <= gate[name][0].t) return gate[name][0].v;
    for (i = 0; i < n - 1; i++) {
        if (t < gate[name][i + 1].t) {
            p = (t - gate[name][i].t) / (gate[name][i + 1].t - gate[name][i].t);
            return gate[name][i].v + (gate[name][i + 1].v - gate[name][i].v) * ease(gate[name][i].e, p);
        }
    }
    return gate[name][n - 1].v;
}

fun mix(a, b, e) { return a + (b - a) * e; }

