# The nearest of a list of rendered scales.
fun nearest(list, n, s) {
    local.b = 0;
    local.i = 0;
    for (i = 1; i < n; i++) if (Math.Abs(list[i] - s) < Math.Abs(list[b] - s)) b = i;
    return b;
}

# A two- or three-key track (flash, shock waves, flares): scale in .s, opacity in .o.
fun track(kind, i, t) {
    local.n = 3; local.j = 0; local.e = 0;
    local.kt[0] = 0; local.ks[0] = 0; local.ko[0] = 0; local.ke[0] = 0;
    local.r.s = 0; local.r.o = 0;
    if (kind == "shock") n = 2;
    for (j = 0; j < n; j++) {
        if (kind == "flash") { kt[j] = flash[j].t; ks[j] = flash[j].s; ko[j] = flash[j].o; ke[j] = flash[j].e; }
        else if (kind == "shock") { kt[j] = shock[i][j].t; ks[j] = shock[i][j].s; ko[j] = shock[i][j].o; ke[j] = shock[i][j].e; }
        else { kt[j] = flare[i][j].t; ks[j] = flare[i][j].s; ko[j] = flare[i][j].o; ke[j] = flare[i][j].e; }
    }
    r.s = ks[0]; r.o = 0;
    if (t < kt[0] || t >= kt[n - 1]) return r;
    for (j = 0; j < n - 1; j++) {
        if (t < kt[j + 1]) {
            e = ease(ke[j], (t - kt[j]) / (kt[j + 1] - kt[j]));
            r.s = mix(ks[j], ks[j + 1], e);
            r.o = mix(ko[j], ko[j + 1], e);
            return r;
        }
    }
    return r;
}

fun refresh() {
    local.g = 0; local.a = 0; local.i = 0; local.j = 0; local.k = 0; local.u = 0; local.p = 0;
    local.r = 0; local.o = 0; local.b = 0; local.off = 0; local.s = 0; local.q = 0; local.e = 0;
    local.l = 0; local.gs = 0; local.go = 0; local.ts = 1; local.to = 1; local.f = 0; local.top = 0;
    global.t += 1 / 50;

    amb.SetOpacity(gatev("amb", t));

    # beams: a turn in SPIN s; six-fold, so 60 degrees in 12 steps, cross-faded
    g = gatev("beams", t);
    a = frac(t / SPIN * 6) * 12;
    i = Math.Int(a);
    if (i != beam_i) {
        beam_a.SetImage(beam_img[i]);
        beam_b.SetImage(beam_img[(i + 1) % 12]);
        global.beam_i = i;
    }
    beam_a.SetOpacity(g * (1 - (a - i)));
    beam_b.SetOpacity(g * (a - i));

    # sparks rushing in
    for (i = 0; i < SPARKS; i++) {
        u = t - spark[i].d;
        if (u < 0 || u > spark[i].dur + 0.06) spark_s[i].SetOpacity(0);
        else {
            p = Math.Min(1, u / spark[i].dur);
            if (p < 0.7 && u < spark[i].dur) spark_s[i].SetImage(spark_img[i][0]); else spark_s[i].SetImage(spark_img[i][1]);
            r = spark[i].r0 + (spark[i].r1 - spark[i].r0) * p;
            at(spark_s[i], DCX + spark_cos[i] * r, DCY + spark_sin[i] * r, 4);
            if (u < 0.1) o = u / 0.1; else if (u < spark[i].dur) o = 1; else o = 1 - (u - spark[i].dur) / 0.06;
            spark_s[i].SetOpacity(o);
        }
    }

    # motes drifting out while loading
    g = gatev("motes", t);
    for (i = 0; i < MOTES; i++) {
        if (g <= 0) mote_s[i].SetOpacity(0);
        else {
            p = frac((t - mote[i].d) / mote[i].dur);
            r = mote[i].r0 + (mote[i].r1 - mote[i].r0) * p;
            at(mote_s[i], DCX + mote_cos[i] * r, DCY + mote_sin[i] * r, 3);
            if (p < 0.15) o = mote[i].o * p / 0.15; else o = mote[i].o * (1 - (p - 0.15) / 0.85);
            mote_s[i].SetOpacity(o * g);
        }
    }

    halo.SetOpacity(gatev("halo", t));
    chamber.SetOpacity(gatev("chamber", t));
    ticks.SetOpacity(gatev("ticks", t));
    ridge.SetOpacity(gatev("ridge", t));

    # the core's bloom breathes
    p = frac(t / BREATHE);
    if (p < 0.5) b = mix(BREATHE_LOW, 1, ease("ease-in-out", p / 0.5)); else b = mix(1, BREATHE_LOW, ease("ease-in-out", (p - 0.5) / 0.5));
    bloom.SetOpacity(gatev("bloom", t) * b);

    # the light running round the ticks
    g = gatev("lit", t);
    for (i = 0; i < TICKS; i++) {
        if (g <= 0) tick_s[i].SetOpacity(0);
        else {
            p = frac((t - i / TICKS * CHASE) / CHASE);
            if (p < TAIL) o = 1 - ease("ease-in-out", p / TAIL); else o = 0;
            tick_s[i].SetOpacity(o * g);
        }
    }

    # rays, frame by frame
    if (t < RAYS_FROM) rays.SetOpacity(0);
    else {
        i = Math.Min(RAYS_N - 1, Math.Int((t - RAYS_FROM) * RAYS_FPS + 0.5));
        if (i != ray_i) { rays.SetImage(ray_img[i]); global.ray_i = i; }
        rays.SetOpacity(1);
    }

    # the bezel pieces fly in and lock
    for (k = 0; k < 6; k++) {
        if (t < piece[k].t0) piece_s[k].SetOpacity(0);
        else {
            off = 1 - ease("out", (t - piece[k].t0) / (piece[k].t1 - piece[k].t0));
            s = Math.Min(PIECE_STEPS - 1, Math.Int(piece[k].rot * off / PIECE_DEG + 0.5));
            piece_s[k].SetImage(piece_img[k][s]);
            at(piece_s[k], piece[k].x + piece[k].dx * off, piece[k].y + piece[k].dy * off, 16);
            piece_s[k].SetOpacity(ease("out", (t - piece[k].t0) / piece[k].fade));
        }
    }

    # the sheen sweeping the bezel
    g = gatev("sheen", t);
    if (g <= 0) sheen.SetOpacity(0);
    else {
        p = frac(t / SWEEP);
        if (p < SWEEP_MOVING) q = ease("ease-in-out", p / SWEEP_MOVING); else q = 1;
        sheen.SetImage(sheen_img[Math.Int(q * (SHEEN_N - 1) + 0.5)]);
        sheen.SetOpacity(g);
    }

    # the gem ignites
    if (t < GEM_FROM) gem.SetOpacity(0);
    else {
        e = ease("pop", (t - GEM_FROM) / (GEM_TO - GEM_FROM));
        gem.SetImage(gem_img[nearest(gem_scale, GEM_N, e)]);
        at(gem, spr["gem-0"].x, spr["gem-0"].y, 19);
        gem.SetOpacity(Math.Clamp(e, 0, 1));
    }

    # glints: a flash as each piece locks, then twinkling
    for (k = 0; k < 6; k++) {
        l = glint[k].lit;
        if (t < l - 0.02) { gs = 0; go = 0; }
        else if (t < l + 0.1) { e = ease("ease-out", (t - l + 0.02) / 0.12); gs = 2.4 * e; go = e; }
        else if (t < l + 0.45) { e = ease("ease-in", (t - l - 0.1) / 0.35); gs = mix(2.4, 1, e); go = 1; }
        else { gs = 1; go = 1; }
        p = frac((t - glint[k].tw) / TWINKLE);
        ts = 1;
        to = 1;
        for (j = 0; j < 3; j++) {
            if (p >= twk[j].p && p < twk[j + 1].p) {
                e = ease("ease-in-out", (p - twk[j].p) / (twk[j + 1].p - twk[j].p));
                ts = mix(twk[j].s, twk[j + 1].s, e);
                to = mix(twk[j].o, twk[j + 1].o, e);
            }
        }
        s = gs * ts;
        if (s < 0.1) glint_s[k].SetOpacity(0);
        else {
            glint_s[k].SetImage(glint_img[nearest(glint_scale, GLINT_N, s)]);
            at(glint_s[k], glint[k].x, glint[k].y, 20);
            glint_s[k].SetOpacity(go * to);
        }
    }

    # ignition: flash, shock waves, flares
    f = track("flash", 0, t);
    if (f.o <= 0) flash_s.SetOpacity(0);
    else {
        flash_s.SetImage(flash_base.Scale(Math.Max(1, Math.Int(flash_base.GetWidth() * f.s / 2.6)), Math.Max(1, Math.Int(flash_base.GetHeight() * f.s / 2.6))));
        at(flash_s, spr["flash"].x, spr["flash"].y, 21);
        flash_s.SetOpacity(f.o);
    }
    for (i = 0; i < 2; i++) {
        f = track("shock", i, t);
        if (f.o <= 0) shock_s[i].SetOpacity(0);
        else {
            top = shock[i][1].s;
            shock_s[i].SetImage(shock_img[i][Math.Int((f.s - 1) / (top - 1) * (SHOCK_N - 1) + 0.5)]);
            at(shock_s[i], DCX, DCY, 22);
            shock_s[i].SetOpacity(f.o);
        }
        f = track("flare", i, t);
        if (f.o <= 0 || f.s < 0.01) flare_s[i].SetOpacity(0);
        else {
            flare_s[i].SetImage(flare_base[i].Scale(Math.Max(1, Math.Int(flare_base[i].GetWidth() * f.s)), flare_base[i].GetHeight()));
            at(flare_s[i], spr["flare" + i].x, spr["flare" + i].y, 23);
            flare_s[i].SetOpacity(f.o);
        }
    }

    # the word, unless a prompt stands in its place
    if (dialog_on) word.SetOpacity(0);
    else {
        e = ease("out", (t - WORD_FROM) / (WORD_TO - WORD_FROM));
        at(word, spr["word"].x, spr["word"].y + WORD_RISE * (1 - e), 24);
        word.SetOpacity(WORD_OPACITY * e);
    }
}
Plymouth.SetRefreshFunction(refresh);

#----------------------------------------- under the mark: prompts and progress

font = "Inter " + Math.Int(Math.Max(11, SH / 80));
entry_image = load("entry");
lock_image = load("lock");
bullet_image = load("bullet");
entry = Sprite(entry_image);
lock = Sprite(lock_image);
prompt = Sprite();
answer = Sprite();
entry.SetOpacity(0);
lock.SetOpacity(0);
bullet_count = 0;
ex = X(spr["entry"].x) - entry_image.GetWidth() / 2;
ey = Y(spr["entry"].y) - entry_image.GetHeight() / 2;

fun dialog(text, opacity) {
    global.dialog_on = opacity > 0;
    entry.SetPosition(ex, ey, 100);
    lock.SetPosition(ex + entry_image.GetHeight() / 2 - lock_image.GetWidth() / 2, ey + entry_image.GetHeight() / 2 - lock_image.GetHeight() / 2, 101);
    prompt.SetImage(Image.Text(text, 0.62, 0.70, 0.77, 1, font));
    prompt.SetPosition(Window.GetX() + SW / 2 - prompt.GetImage().GetWidth() / 2, ey + entry_image.GetHeight() + SH * 0.012, 100);
    prompt.SetOpacity(opacity);
    entry.SetOpacity(opacity);
    lock.SetOpacity(opacity);
}

# The dots are globals, so they stay on the screen after this returns.
fun bullets(count) {
    local.bx = ex + entry_image.GetHeight();
    local.b = 0;
    for (b = 0; b < bullet_count || b < count; b++) {
        if (!global.bullet[b]) {
            global.bullet[b] = Sprite(bullet_image);
            global.bullet[b].SetPosition(bx + b * bullet_image.GetWidth() * 1.15, ey + entry_image.GetHeight() / 2 - bullet_image.GetHeight() / 2, 101);
        }
        if (b < count) global.bullet[b].SetOpacity(1); else global.bullet[b].SetOpacity(0);
    }
    global.bullet_count = Math.Max(bullet_count, count);
}

fun on_password(text, count) {
    if (text == "") text = " ";
    dialog(text, 1);
    answer.SetOpacity(0);
    bullets(count);
}

fun on_question(text, typed) {
    dialog(text, 1);
    bullets(0);
    answer.SetImage(Image.Text(typed + " ", 0.96, 0.96, 0.97, 1, font));
    answer.SetPosition(ex + entry_image.GetHeight(), ey + entry_image.GetHeight() / 2 - answer.GetImage().GetHeight() / 2, 101);
    answer.SetOpacity(1);
}

fun on_normal() {
    global.dialog_on = 0;
    prompt.SetOpacity(0);
    entry.SetOpacity(0);
    lock.SetOpacity(0);
    answer.SetOpacity(0);
    bullets(0);
}

Plymouth.SetDisplayPasswordFunction(on_password);
Plymouth.SetDisplayQuestionFunction(on_question);
Plymouth.SetDisplayNormalFunction(on_normal);

# Updates applied while starting (firmware, offline upgrades): a thin glass bar
# and the percentage in the word's place.
bar_back = Sprite(load("bar-back"));
at(bar_back, spr["bar-back"].x, spr["bar-back"].y, 90);
bar_back.SetOpacity(0);
bar_front = load("bar");
bar = Sprite();
percent = Sprite();

fun on_update(progress) {
    local.p = Math.Clamp(progress / 100, 0, 1);
    global.dialog_on = 1;
    bar_back.SetOpacity(1);
    if (p > 0) {
        bar.SetImage(bar_front.Scale(Math.Max(1, Math.Int(bar_front.GetWidth() * p)), bar_front.GetHeight()));
        bar.SetPosition(bar_back.GetX(), bar_back.GetY(), 91);
        bar.SetOpacity(1);
    }
    percent.SetImage(Image.Text(Math.Int(progress) + " %", 0.62, 0.70, 0.77, 1, font));
    percent.SetPosition(Window.GetX() + SW / 2 - percent.GetImage().GetWidth() / 2, bar_back.GetY() + SH * 0.015, 90);
    percent.SetOpacity(1);
}
Plymouth.SetSystemUpdateFunction(on_update);

message = Sprite();
fun on_message(text) {
    message.SetImage(Image.Text(text, 0.62, 0.70, 0.77, 1, font));
    message.SetPosition(Window.GetX() + SW / 2 - message.GetImage().GetWidth() / 2, Window.GetY() + SH * 0.88, 100);
    message.SetOpacity(1);
}
fun on_hide_message(text) { message.SetOpacity(0); }
Plymouth.SetDisplayMessageFunction(on_message);
Plymouth.SetHideMessageFunction(on_hide_message);
