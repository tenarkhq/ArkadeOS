#!/usr/bin/bash
# Windows game stores on ArkadeOS (T014, T018): Battle.net, EA app, Ubisoft
# Connect, each in its own Wine prefix under ~/Games, through umu-launcher with
# the GE-Proton the image ships (tested with it). A store update that breaks
# it can be run on another Proton (--choose-proton, kept per store in
# ~/.config/arkadeos/<store>.conf). The first start downloads the store's
# installer and runs it.
#   arkadeos-store STORE                 start the store (install on first start)
#   arkadeos-store STORE --choose-proton pick the Proton for the store
#   arkadeos-store STORE --check         print the Proton and prefix in use
#   arkadeos-store STORE --launch CODE   start the store and the game in it
#                                        (Battle.net game codes, e.g. WoW; T068)
set -euo pipefail

store=${1:?store: battlenet | ea | ubisoft}
shift
case "${store}" in
    battlenet)
        name="Battle.net"
        installer_url="https://downloader.battle.net/download/getInstaller?os=win&installer=Battle.net-Setup.exe"
        launcher="drive_c/Program Files (x86)/Battle.net/Battle.net Launcher.exe"
        icon=/usr/share/icons/WhiteSur/apps/scalable/battlenet.svg
        ;;
    ea)
        name="EA app"
        installer_url="https://origin-a.akamaihd.net/EA-Desktop-Client-Download/installer-releases/EAappInstaller.exe"
        launcher="drive_c/Program Files/Electronic Arts/EA Desktop/EA Desktop/EADesktop.exe"
        icon=/usr/share/icons/WhiteSur/apps/scalable/applications-games.svg
        ;;
    ubisoft)
        name="Ubisoft Connect"
        installer_url="https://static3.cdn.ubi.com/orbit/launcher_installer/UbisoftConnectInstaller.exe"
        launcher="drive_c/Program Files (x86)/Ubisoft/Ubisoft Game Launcher/UbisoftConnect.exe"
        icon=/usr/share/icons/WhiteSur/apps/scalable/applications-games.svg
        ;;
    *) echo "unknown store: ${store}" >&2; exit 2 ;;
esac

conf="${XDG_CONFIG_HOME:-${HOME}/.config}/arkadeos/${store}.conf"
prefix="${HOME}/Games/${store}"
launcher="${prefix}/${launcher}"

protons() {
    ls -d /usr/share/steam/compatibilitytools.d/*/ \
        "${HOME}"/.steam/root/compatibilitytools.d/*/ \
        "${HOME}"/.local/share/Steam/compatibilitytools.d/*/ 2>/dev/null |
        while read -r dir; do [[ -x "${dir}proton" ]] && echo "${dir%/}"; done | sort -uV
}

PROTON=
[[ -f "${conf}" ]] && source "${conf}"
if [[ -z "${PROTON}" || ! -x "${PROTON}/proton" ]]; then
    PROTON=$(ls -d /usr/share/steam/compatibilitytools.d/GE-Proton* | sort -V | tail -1)
fi

case "${1:-}" in
    --choose-proton)
        items=()
        while read -r dir; do
            items+=("${dir}" "$(basename "${dir}")" "$([[ "${dir}" == "${PROTON}" ]] && echo on || echo off)")
        done < <(protons)
        text="Proton for ${name}:"
        [[ "${LANG:-}" == hu* ]] && text="A(z) ${name} ezzel a Protonnal fut:"
        choice=$(kdialog --title "${name} Proton" --radiolist "${text}" "${items[@]}") || exit 0
        mkdir -p "$(dirname "${conf}")"
        printf 'PROTON=%q\n' "${choice}" > "${conf}"
        exit 0
        ;;
    --check)
        printf 'proton=%s\nprefix=%s\ninstalled=%s\n' "${PROTON}" "${prefix}" \
            "$([[ -f "${launcher}" ]] && echo yes || echo no)"
        exit 0
        ;;
esac

# Also reachable from Steam Game Mode (added while Steam is closed).
/usr/libexec/arkadeos/steam-shortcut "${name}" "/usr/bin/arkadeos-${store}" "${icon}" || true

export WINEPREFIX="${prefix}" PROTONPATH="${PROTON}" GAMEID=umu-default STORE="${store}"
mkdir -p "${prefix}"
if [[ ! -f "${launcher}" ]]; then
    setup="${prefix}/$(basename "${installer_url%%\?*}")"
    [[ "${setup}" == *.exe ]] || setup="${prefix}/setup.exe"
    curl -fL --retry 3 -o "${setup}" "${installer_url}"
    umu-run "${setup}"
    exit 0
fi
if [[ "${1:-}" == --launch && -n "${2:-}" && "${store}" == battlenet ]]; then
    exec umu-run "${launcher}" --exec="launch $2"
fi
exec umu-run "${launcher}"
