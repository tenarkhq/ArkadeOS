#!/usr/bin/bash
# Battle.net on ArkadeOS (T014), through umu-launcher with the GE-Proton the
# image ships (tested with it); a Battle.net update that breaks it can be run
# on another Proton (--choose-proton, kept in ~/.config/arkadeos/battlenet.conf).
# The first start downloads Blizzard's installer and runs it.
#   arkadeos-battlenet                 start Battle.net (install on first start)
#   arkadeos-battlenet --choose-proton pick the Proton for Battle.net
#   arkadeos-battlenet --check         print the Proton and prefix in use
set -euo pipefail

conf="${XDG_CONFIG_HOME:-${HOME}/.config}/arkadeos/battlenet.conf"
prefix="${HOME}/Games/battlenet"
installer_url="https://downloader.battle.net/download/getInstaller?os=win&installer=Battle.net-Setup.exe"
launcher="${prefix}/drive_c/Program Files (x86)/Battle.net/Battle.net Launcher.exe"

protons() {
    ls -d /usr/share/steam/compatibilitytools.d/*/ \
        "${HOME}"/.steam/root/compatibilitytools.d/*/ \
        "${HOME}"/.local/share/Steam/compatibilitytools.d/*/ 2>/dev/null |
        while read -r dir; do [[ -x "${dir}proton" ]] && echo "${dir%/}"; done | sort -uV
}

PROTON=
[[ -f "${conf}" ]] && source "${conf}"
if [[ -z "${PROTON}" || ! -x "${PROTON}/proton" ]]; then
    PROTON=$(ls -d /usr/share/steam/compatibilitytools.d/GE-Proton* | sort -V | tail -1)
fi

case "${1:-}" in
    --choose-proton)
        items=()
        while read -r dir; do
            items+=("${dir}" "$(basename "${dir}")" "$([[ "${dir}" == "${PROTON}" ]] && echo on || echo off)")
        done < <(protons)
        title="Battle.net Proton"
        text="Proton for Battle.net:"
        [[ "${LANG:-}" == hu* ]] && text="A Battle.net ezzel a Protonnal fut:"
        choice=$(kdialog --title "${title}" --radiolist "${text}" "${items[@]}") || exit 0
        mkdir -p "$(dirname "${conf}")"
        printf 'PROTON=%q\n' "${choice}" > "${conf}"
        exit 0
        ;;
    --check)
        printf 'proton=%s\nprefix=%s\ninstalled=%s\n' "${PROTON}" "${prefix}" \
            "$([[ -f "${launcher}" ]] && echo yes || echo no)"
        exit 0
        ;;
esac

# Also reachable from Steam Game Mode (added while Steam is closed).
/usr/libexec/arkadeos/steam-shortcut "Battle.net" /usr/bin/arkadeos-battlenet /usr/share/icons/WhiteSur/apps/scalable/battlenet.svg || true

export WINEPREFIX="${prefix}" PROTONPATH="${PROTON}" GAMEID=umu-default STORE=battlenet
mkdir -p "${prefix}"
if [[ ! -f "${launcher}" ]]; then
    setup="${prefix}/Battle.net-Setup.exe"
    curl -fL --retry 3 -o "${setup}" "${installer_url}"
    umu-run "${setup}"
    exit 0
fi
exec umu-run "${launcher}"
