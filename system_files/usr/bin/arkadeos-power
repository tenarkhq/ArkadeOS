#!/usr/bin/bash
# ArkadeOS power profiles (T011).
#   arkadeos-power status        profile=..., auto=game|battery|, on_battery=..., rgb=on|off,
#                                has_battery=true|false, charge=on|off|none
#   arkadeos-power charge on|off battery care: charging stops at 80%
#   arkadeos-power set PROFILE   battery | balanced | gaming | max | wow (max: charger only;
#                                wow: full CPU, held-back GPU, T055)
#   arkadeos-power game GAME PROFILE   profile while a game runs (T034); GAME is
#                                a Steam AppId or a program name (Wow.exe)
#   arkadeos-power game GAME default   back to the default (gaming)
#   arkadeos-power games         the per-game list
#   arkadeos-power ccd [on|off]  while WoW is on, a game runs on one group of cores where the
#                                processor has several (T084, the default) or on all of them;
#                                alone: on|off with the group's CPUs, or none on other processors
set -euo pipefail

case "${1:-status}" in
    status)
        on_battery=false
        [[ "$(busctl get-property org.freedesktop.UPower /org/freedesktop/UPower org.freedesktop.UPower OnBattery 2>/dev/null)" == "b true" ]] &&
            on_battery=true
        # One call for both: s "balanced", then aa{sv} <number of holds> ...
        ppd=$(busctl get-property net.hadess.PowerProfiles /net/hadess/PowerProfiles net.hadess.PowerProfiles \
            ActiveProfile ActiveProfileHolds)
        { read -r _ active; read -r _ holds _; } <<< "${ppd}"
        active=${active//\"/}
        auto=
        if [[ -e /run/arkadeos/power-max || -e /run/arkadeos/power-wow ]]; then
            [[ -e /run/arkadeos/power-max ]] && profile=max || profile=wow
            # The game watcher set it for a running game.
            compgen -G '/run/user/*/arkadeos-game-max' >/dev/null && auto=game
        else
            case "${active}" in
                power-saver) profile=battery ;;
                performance) profile=gaming ;;
                *) profile=balanced ;;
            esac
            if [[ "${holds}" != 0 && "${active}" == performance ]]; then
                auto=game
            elif [[ "${profile}" == balanced && "${on_battery}" == true ]]; then
                profile=battery auto=battery
            fi
        fi
        # A desktop has no battery: the Akku profile is called Quiet there (T052).
        # A wireless mouse's or headset's battery (scope Device) is not the machine's.
        has_battery=false
        for d in /sys/class/power_supply/*/; do
            [[ "$(cat "${d}type" 2>/dev/null)" == Battery && "$(cat "${d}scope" 2>/dev/null)" != Device ]] && has_battery=true
        done
        # Battery care: on when charging stops below 100%.
        charge=none
        for f in /sys/bus/platform/drivers/ideapad_acpi/*/conservation_mode \
            /sys/class/power_supply/BAT*/charge_control_end_threshold; do
            [[ -f "${f}" ]] || continue
            v=$(<"${f}")
            if [[ "${f}" == *conservation_mode ]]; then [[ "${v}" == 1 ]] && charge=on || charge=off
            else (( v < 100 )) && charge=on || charge=off; fi
            break
        done
        printf 'profile=%s\nauto=%s\non_battery=%s\nrgb=%s\nhas_battery=%s\ncharge=%s\n' "${profile}" "${auto}" \
            "${on_battery}" "$(arkadeos-rgb sync status 2>/dev/null || echo off)" "${has_battery}" "${charge}"
        ;;
    set)
        exec pkexec /usr/libexec/arkadeos/power-set "${2:?profile}"
        ;;
    charge)
        exec pkexec /usr/libexec/arkadeos/power-set charge "${2:?on|off}"
        ;;
    game)
        conf="${XDG_CONFIG_HOME:-${HOME}/.config}/arkadeos/game-profiles.conf"
        game=${2:?game} profile=${3:?profile}
        mkdir -p "$(dirname "${conf}")"
        touch "${conf}"
        sed -i "/^$(printf '%s' "${game}" | sed 's/[][\\.*^$/]/\\&/g')=/Id" "${conf}"
        case "${profile}" in
            battery|balanced|gaming|max|wow) echo "${game}=${profile}" >> "${conf}" ;;
            default) ;;
            *) echo "profile: battery | balanced | gaming | max | wow | default" >&2; exit 2 ;;
        esac
        ;;
    games)
        grep -hv '^#' /usr/share/arkadeos/game-profiles.conf \
            "${XDG_CONFIG_HOME:-${HOME}/.config}/arkadeos/game-profiles.conf" 2>/dev/null || true
        ;;
    ccd)
        # The game watcher reads the switch at every look, so it also moves a
        # game that is running.
        off="${XDG_CONFIG_HOME:-${HOME}/.config}/arkadeos/ccd-off"
        case "${2:-}" in
            on) rm -f "${off}" ;;
            off) mkdir -p "$(dirname "${off}")"; touch "${off}" ;;
            "")
                cpus=$(/usr/libexec/arkadeos/game-profile cpus)
                if [[ -z "${cpus}" ]]; then
                    echo none
                elif [[ -e "${off}" ]]; then
                    echo "off ${cpus}"
                else
                    echo "on ${cpus}"
                fi
                ;;
            *) echo "usage: arkadeos-power ccd [on|off]" >&2; exit 2 ;;
        esac
        ;;
    *)
        echo "usage: arkadeos-power status | set <battery|balanced|gaming|max|wow> | charge <on|off> | game <game> <profile> | games | ccd [on|off]" >&2
        exit 2
        ;;
esac
