#!/usr/bin/bash
# ArkadeOS updates (T025). The system, Flatpak apps and Homebrew update every
# day by themselves (uupd, 04:00); a new system version starts at the next
# reboot, and the previous one stays installed to go back to.
#   arkadeos-update status     versions: running, waiting for reboot, previous
#   arkadeos-update now        update now instead of waiting for 04:00
#   arkadeos-update staged     the version that starts at the next reboot, if any
#   arkadeos-update rollback   start the previous version at the next reboot
#   arkadeos-update channel [stable|testing]   show or change the channel (T051)
#   arkadeos-update versions   the builds of the last 90 days of this channel (T036)
#   arkadeos-update version TAG   start that build at the next reboot; it stays
#                              until "channel" brings the newest again
#   arkadeos-update latest     the newest version on the channel, and whether it
#                              runs, waits for the reboot or is still to come
#                              (exit status 10: a newer one is out)
#   arkadeos-update notify     tells the user once about each build that waits
#                              for the reboot (arkadeos-update-notify.timer)
#   arkadeos-update auto [on|off]   show or change the automatic update: on, a
#                              new system version is downloaded and installed by
#                              itself; off, only told (Roland, 2026-11-21)
#   arkadeos-update check      the scheduled look at this machine's channel
#                              (arkadeos-update-check.timer): on, it updates as
#                              Update now does; off, it tells the new version
# A version is <Fedora>.<day>, and <Fedora>.<day>.<n> for the day's further
# builds: 45.20261112, 45.20261112.1, 45.20261112.2 (build.yml).
set -euo pipefail

hu() { [[ "${LANG:-}" == hu* || "${LANGUAGE:-}" == hu* ]]; }
say() { if hu; then echo "$2"; else echo "$1"; fi; }

# Deployments as rpm-ostree reports them; it answers without root, bootc
# does not, and this runs as the user (the Portal, the notify timer).
deployments() { rpm-ostree status --json 2>/dev/null || echo '{}'; }

# The version of the booted, staged or rollback deployment.
version() {
    deployments | python3 -c '
import json, sys
want = sys.argv[1]
ds = json.load(sys.stdin).get("deployments", [])
booted = [d for d in ds if d.get("booted")]
staged = [d for d in ds if d.get("staged")]
rest = [d for d in ds if not d.get("booted") and not d.get("staged")]
d = {"booted": booted, "staged": staged, "rollback": rest}[want]
if d:
    print(d[0].get("version") or d[0].get("checksum", "")[:12])' "$1"
}

# The image digest of the booted or staged deployment: what tells two builds
# apart for certain.
digest_of() {
    deployments | jq -r --arg w "$1" '.deployments[]? | select(if $w == "booted" then .booted else .staged end)
        | ."container-image-reference-digest" // empty' | head -1
}

# The image this machine follows (the staged one after a switch), e.g.
# ghcr.io/tenarkhq/arkadeos:stable.
image_ref() {
    deployments | python3 -c '
import json, sys
ds = json.load(sys.stdin).get("deployments", [])
for d in [d for d in ds if d.get("staged")] + [d for d in ds if d.get("booted")]:
    ref = d.get("container-image-reference") or ""
    if ref:
        # ostree-image-signed:docker://REF or ostree-unverified-registry:REF
        print(ref.split("docker://", 1)[1] if "docker://" in ref else ref.split(":", 1)[1])
        break'
}

# Follow another image from the next reboot on; the signature is checked.
switch_to() {
    if [[ "${2:-}" != --yes && -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]]; then
        kdialog --title ArkadeOS --yesno "$(say "Switch to ${1} at the next reboot?" \
            "Váltás erre a következő újraindításkor: ${1}?")" || exit 0
    fi
    pkexec bootc switch --enforce-container-sigpolicy "${1}"
    say "Done: ${1} starts at the next reboot." "Kész: a következő újraindításkor ez indul: ${1}."
}

# The automatic update (Roland, 2026-11-21): on unless the machine's admin
# turned it off in the Portal. One setting for the machine, as its system is.
AUTO=/etc/arkadeos/auto-update
auto_on() { [[ "$(cat "${AUTO}" 2>/dev/null)" != off ]]; }

STATE="${XDG_STATE_HOME:-${HOME}/.local/state}/arkadeos"

# Roland, 2026-11-04 and 11-12: the channel's newest build against the
# running and the staged one, by image digest. One line in the form of the
# status lines; the Portal shows it under them when it opens. Exit status 10:
# a newer one is out (its digest and version are left in REMOTE_DIGEST and
# REMOTE_VERSION). The channel is always the one this machine follows: a
# stable machine never hears of a testing build.
latest() {
    local ref remote digest newest
    ref=$(image_ref)
    [[ -n "${ref}" ]] || { say "No ArkadeOS image found." "Nem található ArkadeOS image."; return 1; }
    remote=$(timeout 30 skopeo inspect --no-tags "docker://${ref}" 2>/dev/null) ||
        { say "Newest available: the channel could not be reached" \
            "Legfrissebb elérhető: a csatorna most nem érhető el"; return 1; }
    # When it looked last: the Portal shows it under the automatic update.
    mkdir -p "${STATE}" && date +%s > "${STATE}/update-checked" || true
    digest=$(jq -r .Digest <<< "${remote}")
    newest=$(jq -r '.Labels["org.opencontainers.image.version"] // empty' <<< "${remote}")
    REMOTE_DIGEST=${digest} REMOTE_VERSION=${newest}
    if [[ "${digest}" == "$(digest_of booted)" ]]; then
        say "Newest available: ${newest} (this one is running)" "Legfrissebb elérhető: ${newest} (ez fut)"
    elif [[ "${digest}" == "$(digest_of staged)" ]]; then
        say "Newest available: ${newest} (downloaded, starts at the next reboot)" \
            "Legfrissebb elérhető: ${newest} (letöltve, a következő újraindításkor indul)"
    else
        say "Newest available: ${newest}, newer than the running one; Update now brings it" \
            "Legfrissebb elérhető: ${newest}, újabb a futónál; a Frissítés most gombbal jön le"
        return 10
    fi
}

# The channel's name as the Portal shows it.
channel_name() {
    local t
    t=$(image_ref); t=${t##*:}; t=${t%%-*}
    case "${t}" in
        testing) say "Testing" "Teszt" ;;
        *) say "Stable" "Stabil" ;;
    esac
}

case "${1:-status}" in
    status)
        say "Running:  $(version booted)" "Fut:            $(version booted)"
        staged=$(version staged)
        if [[ -n "${staged}" ]]; then say "At reboot: ${staged}" "Újraindításkor: ${staged}"; fi
        rollback=$(version rollback)
        if [[ -n "${rollback}" ]]; then say "Previous: ${rollback}" "Előző:          ${rollback}"; fi
        ;;
    staged)
        version staged
        ;;
    latest)
        latest || exit $?
        ;;
    now)
        # Without a password for the machine's admins (50-arkadeos-update.rules).
        exec systemctl start --no-block uupd.service
        ;;
    rollback)
        if [[ -z "$(version rollback)" ]]; then
            say "There is no previous version to go back to." "Nincs előző verzió, amire vissza lehetne állni."
            exit 1
        fi
        if [[ "${2:-}" != --yes && -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]]; then
            msg=$(say "Start the previous version ($(version rollback)) at the next reboot?" \
                "Az előző verzió ($(version rollback)) induljon a következő újraindításkor?")
            kdialog --title ArkadeOS --yesno "${msg}" || exit 0
        fi
        pkexec bootc rollback
        say "Done: the previous version starts at the next reboot." \
            "Kész: a következő újraindításkor az előző verzió indul."
        ;;
    channel)
        ref=$(image_ref)
        [[ -n "${ref}" ]] || { say "No ArkadeOS image found." "Nem található ArkadeOS image."; exit 1; }
        if [[ -z "${2:-}" ]]; then t=${ref##*:}; echo "${t%%-*}"; exit 0; fi
        case "${2}" in stable|testing) ;; *) echo "channel: stable | testing" >&2; exit 2 ;; esac
        [[ "${ref##*:}" == "${2}" ]] && exit 0
        switch_to "${ref%:*}:${2}" "${3:-}"
        ;;
    notify)
        staged=$(version staged)
        [[ -n "${staged}" ]] || exit 0
        # Once per build, not per version number (Roland, 2026-11-12): the
        # second build of a day is told as well.
        build=$(digest_of staged)
        build=${build:-${staged}}
        seen="${STATE}/update-notified"
        [[ "$(cat "${seen}" 2>/dev/null)" != "${build}" ]] || exit 0
        mkdir -p "$(dirname "${seen}")"
        echo "${build}" > "${seen}"
        action=$(notify-send -a ArkadeOS -i system-software-update \
            -A restart="$(say "Restart now" "Újraindítás most")" \
            "$(say "Update installed, restart needed" "Frissítés telepítve, újraindítás szükséges")" \
            "$(say "ArkadeOS ${staged} starts at the next reboot." "Az ArkadeOS ${staged} a következő újraindításkor indul.")" || true)
        [[ "${action}" == restart ]] && exec qdbus-qt6 org.kde.LogoutPrompt /LogoutPrompt promptReboot
        exit 0
        ;;
    auto)
        if [[ -z "${2:-}" ]]; then if auto_on; then echo on; else echo off; fi; exit 0; fi
        case "${2}" in on|off) ;; *) echo "auto: on | off" >&2; exit 2 ;; esac
        # Without a password for the machine's admins, as Update now
        # (50-arkadeos-update.rules).
        pkexec /usr/libexec/arkadeos/auto-update-set "${2}"
        ;;
    check)
        # Every 6 hours and after the login (arkadeos-update-check.timer).
        rc=0
        latest >/dev/null || rc=$?
        [[ ${rc} -eq 10 ]] || exit 0
        if auto_on; then
            # The same update as Update now; it does not run while a game
            # runs (no-game-running), the next look tries again. It waits
            # for the end, then tells that the new version is installed.
            systemctl start uupd.service || true
            exec "$0" notify
        fi
        # Off: told once per build, with its version.
        seen="${STATE}/update-available-notified"
        [[ "$(cat "${seen}" 2>/dev/null)" != "${REMOTE_DIGEST}" ]] || exit 0
        mkdir -p "${STATE}"
        echo "${REMOTE_DIGEST}" > "${seen}"
        action=$(notify-send -a ArkadeOS -i system-software-update \
            -A portal="$(say "Open the Portal" "Portál megnyitása")" \
            "$(say "New update available" "Új frissítés érhető el")" \
            "$(say "ArkadeOS ${REMOTE_VERSION} is out on the $(channel_name) channel. You can install it in the Portal." \
                "Az ArkadeOS ${REMOTE_VERSION} megjelent a $(channel_name) csatornán. A Portálban telepítheted.")" || true)
        [[ "${action}" == portal ]] && exec arkadeos-portal --system
        exit 0
        ;;
    versions)
        ref=$(image_ref)
        [[ -n "${ref}" ]] || { say "No ArkadeOS image found." "Nem található ArkadeOS image."; exit 1; }
        channel=${ref##*:}
        channel=${channel%%-*}
        since=$(date -u -d '90 days ago' +%Y%m%d)
        skopeo list-tags "docker://${ref%:*}" | python3 -c '
import json, re, sys
channel, since = sys.argv[1], sys.argv[2]
builds = []
for tag in json.load(sys.stdin)["Tags"]:
    m = re.fullmatch(re.escape(channel) + r"-(\d+)\.(\d{8})(?:\.(\d+))?", tag)
    if m and m.group(2) >= since:
        builds.append((int(m.group(1)), m.group(2), int(m.group(3) or 0), tag))
# Newest first: the Fedora it is built on, the day, then the build of the day.
for build in sorted(builds, reverse=True):
    print(build[3])' "${channel}" "${since}"
        ;;
    version)
        ref=$(image_ref)
        [[ -n "${ref}" ]] || { say "No ArkadeOS image found." "Nem található ArkadeOS image."; exit 1; }
        tag=${2:?tag}
        [[ "${tag}" =~ ^(stable|testing)-[0-9]+\.[0-9]{8}(\.[0-9]+)?$ ]] || { echo "version: a tag from 'arkadeos-update versions'" >&2; exit 2; }
        switch_to "${ref%:*}:${tag}" "${3:-}"
        ;;
    *)
        sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'
        exit 2
        ;;
esac
