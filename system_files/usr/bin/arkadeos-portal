#!/usr/bin/python3
"""ArkadeOS Portal (T037): everything optional of ArkadeOS in one window.

Apps: tick to install, untick to remove (portal-item does the work). On the
first login it opens by itself as the choice screen (T026, --first-run): the
defaults are ticked, and what is chosen gets installed.
System: update now, go back to the previous version, channel (stable or
testing), the image for the graphics card, firmware, desktop defaults.
Games: the power profile each game runs with (T055); arkadeos-power game
keeps the list, a game not on it runs on Gaming.
"""
import html
import os
import re
import subprocess
import sys
from pathlib import Path

from PySide6.QtCore import QLocale, QObject, QProcess, Qt, QThread, Signal
from PySide6.QtGui import QIcon
from PySide6.QtWidgets import (
    QApplication, QCheckBox, QComboBox, QGridLayout, QGroupBox, QHBoxLayout,
    QHeaderView, QLabel, QLineEdit, QMessageBox, QPlainTextEdit, QPushButton,
    QScrollArea, QTableWidget, QTabWidget, QToolButton, QVBoxLayout, QWidget,
)

ITEM = "/usr/libexec/arkadeos/portal-item"
CATALOG = Path("/usr/share/arkadeos/portal/catalog.tsv")
APPS_LIST = Path("/usr/share/arkadeos/apps.list")
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "arkadeos"
FIRST_RUN_DONE = STATE / "portal-first-run"
# Chosen in the installer (T026): the first start installs it without asking.
FROM_INSTALLER = Path("/etc/arkadeos/apps-from-installer")
CHOSEN = Path("/etc/arkadeos/apps")

HU = QLocale().name().startswith("hu")


def tr(en, hu):
    return hu if HU else en


GROUPS = {
    "base": tr("Basic apps", "Alap appok"),
    "chat": tr("Chat", "Csevegés"),
    "stores": tr("Game stores", "Játékáruházak"),
    "gaming": tr("Gaming", "Játék"),
    "stream": tr("Streaming and recording", "Streamelés és felvétel"),
    "desktop": tr("Desktop", "Asztal"),
    "ai": tr("AI", "AI"),
    "dev": tr("Developer tools", "Fejlesztői eszközök"),
    "vendor": tr("Laptop maker (only the detected one can be chosen)",
                 "Gépgyártó (csak a felismert választható)"),
}


def catalog():
    items = []
    for line in CATALOG.read_text().splitlines():
        if not line or line.startswith("#"):
            continue
        item_id, group, kind, ref, en, hun = line.split("\t")
        items.append({"id": item_id, "group": group, "kind": kind, "name": tr(en, hun)})
    return items


def defaults():
    """The apps that come by default (apps.list: always or on)."""
    on = set()
    for line in APPS_LIST.read_text().splitlines():
        if line and not line.startswith("#"):
            item_id, _, default = line.split("|")
            if default in ("always", "on"):
                on.add(item_id)
    return on


def run(*args):
    return subprocess.run(args, capture_output=True, text=True).stdout.strip()


class StatusReader(QObject):
    """Reads every item's status in the background: some take a moment."""
    found = Signal(str, bool)
    finished = Signal()

    def __init__(self, ids):
        super().__init__()
        self.ids = ids

    def work(self):
        for item_id in self.ids:
            self.found.emit(item_id, run(ITEM, item_id, "status") == "on")
        self.finished.emit()


class AppsTab(QWidget):
    def __init__(self, first_run):
        super().__init__()
        self.first_run = first_run
        self.from_installer = first_run and FROM_INSTALLER.exists()
        self.chosen = set(CHOSEN.read_text().split()) if self.from_installer and CHOSEN.exists() else set()
        self.items = catalog()
        self.installed = {}
        self.boxes = {}
        self.queue = []

        layout = QVBoxLayout(self)
        intro = QLabel(tr(
            "Welcome to ArkadeOS! What you chose during the installation is being set up; "
            "everything can be changed here later.",
            "Üdv az ArkadeOS-en! Most települ, amit a telepítéskor kiválasztottál; később itt "
            "bármikor módosíthatod.") if self.from_installer else tr(
            "Welcome to ArkadeOS! Tick what you want on this machine; everything can be "
            "changed here later too.",
            "Üdv az ArkadeOS-en! Pipáld ki, mi kerüljön a gépre; később itt bármikor "
            "módosíthatod.") if first_run else tr(
            "Tick to install, untick to remove.",
            "Pipáld ki, amit telepítenél, vedd ki a pipát, amit eltávolítanál."))
        intro.setWordWrap(True)
        layout.addWidget(intro)
        # T053: what the installer's hardware check found (English and
        # Hungarian line of each finding).
        check = Path("/etc/arkadeos/hardware-check.txt")
        if first_run and check.exists():
            notes = [b.splitlines() for b in check.read_text().split("\n\n") if b.strip()]
            found = QLabel("\n".join("⚠ " + (n[1] if HU and len(n) > 1 else n[0]) for n in notes))
            found.setWordWrap(True)
            layout.addWidget(found)

        self.locked = set()
        body = QWidget()
        grid = QVBoxLayout(body)
        for group, title in GROUPS.items():
            members = [i for i in self.items if i["group"] == group]
            if not members:
                continue
            box = QGroupBox(title)
            box_layout = QGridLayout(box)
            for n, item in enumerate(members):
                check = QCheckBox(item["name"])
                check.setEnabled(False)
                if item["kind"] == "fixed":
                    # Part of the image: shown so the list is complete, never removed.
                    check.setChecked(True)
                    check.setToolTip(tr("Always on this machine", "Mindig rajta van a gépen"))
                else:
                    self.boxes[item["id"]] = check
                if item["group"] == "vendor" and run("arkadeos-vendor", item["id"], "allowed") != "yes":
                    # Another maker's machine (arkadeos-vendor): never selectable here.
                    self.locked.add(item["id"])
                    check.setToolTip(tr("This machine is not this maker's laptop",
                                        "Ez a gép nem ennek a gyártónak a laptopja"))
                box_layout.addWidget(check, n // 2, n % 2)
            grid.addWidget(box)
        grid.addStretch()
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setWidget(body)
        layout.addWidget(scroll, 1)

        self.log = QPlainTextEdit()
        self.log.setReadOnly(True)
        self.log.setMaximumHeight(140)
        self.log.hide()
        layout.addWidget(self.log)

        row = QHBoxLayout()
        self.state = QLabel(tr("Checking what is installed…", "Annak ellenőrzése, mi van telepítve…"))
        row.addWidget(self.state, 1)
        self.apply = QPushButton(QIcon.fromTheme("dialog-ok-apply"), tr("Apply", "Alkalmazás"))
        self.apply.setEnabled(False)
        self.apply.clicked.connect(self.start)
        row.addWidget(self.apply)
        layout.addLayout(row)

        self.thread = QThread()
        self.reader = StatusReader([i["id"] for i in self.items if i["kind"] != "fixed"])
        self.reader.moveToThread(self.thread)
        self.thread.started.connect(self.reader.work)
        self.reader.found.connect(self.found)
        self.reader.finished.connect(self.ready)
        self.reader.finished.connect(self.thread.quit)
        self.thread.start()

    def found(self, item_id, on):
        self.installed[item_id] = on
        check = self.boxes[item_id]
        if self.from_installer:
            # The installer's choice; makers follow /etc/arkadeos/vendor, so their status.
            vendor = any(i["id"] == item_id and i["group"] == "vendor" for i in self.items)
            check.setChecked(on if vendor else item_id in self.chosen)
        else:
            check.setChecked(on or (self.first_run and item_id in defaults()))
        check.setEnabled(item_id not in self.locked)

    def ready(self):
        self.state.setText("")
        self.apply.setEnabled(True)
        if self.from_installer:
            self.start()

    def start(self):
        self.queue = [(i, "install" if b.isChecked() else "remove") for i, b in self.boxes.items()
                      if b.isChecked() != self.installed.get(i, False)]
        if self.first_run and not self.from_installer:
            chosen = [i for i, b in self.boxes.items() if b.isChecked()]
            subprocess.run(["pkexec", "/usr/libexec/arkadeos/apps-choose", *chosen])
        if not self.queue:
            self.done()
            return
        self.apply.setEnabled(False)
        for check in self.boxes.values():
            check.setEnabled(False)
        self.log.show()
        self.next()

    def next(self):
        if not self.queue:
            self.done()
            return
        item_id, action = self.queue.pop(0)
        name = self.boxes[item_id].text()
        self.state.setText(tr(f"{'Installing' if action == 'install' else 'Removing'}: {name}",
                              f"{'Telepítés' if action == 'install' else 'Eltávolítás'}: {name}"))
        proc = QProcess(self)
        proc.setProcessChannelMode(QProcess.MergedChannels)
        proc.readyRead.connect(lambda: self.log.appendPlainText(
            bytes(proc.readAll()).decode(errors="replace").rstrip()))
        proc.finished.connect(lambda code, _status: self.item_done(item_id, action, code))
        proc.start(ITEM, [item_id, action])

    def item_done(self, item_id, action, code):
        ok = code == 0
        if ok:
            self.installed[item_id] = action == "install"
        else:
            self.boxes[item_id].setChecked(self.installed.get(item_id, False))
        self.log.appendPlainText(("✔ " if ok else "✘ ") + self.boxes[item_id].text())
        self.next()

    def done(self):
        if self.first_run:
            STATE.mkdir(parents=True, exist_ok=True)
            FIRST_RUN_DONE.touch()
        self.state.setText(tr("Done.", "Kész."))
        self.apply.setEnabled(True)
        for item_id, check in self.boxes.items():
            check.setEnabled(item_id not in self.locked)


class SystemTab(QWidget):
    def __init__(self):
        super().__init__()
        layout = QVBoxLayout(self)

        updates = QGroupBox(tr("Updates", "Frissítések"))
        u = QVBoxLayout(updates)
        self.version = QLabel()
        u.addWidget(self.version)
        u.addWidget(QLabel(tr(
            "The system, apps and Homebrew update every day by themselves; a new system "
            "version starts at the next reboot.",
            "A rendszer, az appok és a Homebrew naponta maguktól frissülnek; az új "
            "rendszerverzió a következő újraindításkor indul.")))
        row = QHBoxLayout()
        row.addWidget(self.button("system-software-update", tr("Update now", "Frissítés most"),
                                  ["arkadeos-update", "now"]))
        row.addWidget(self.button("edit-undo", tr("Back to the previous version", "Vissza az előző verzióra"),
                                  ["arkadeos-update", "rollback"]))
        u.addLayout(row)
        row = QHBoxLayout()
        row.addWidget(QLabel(tr("Channel:", "Csatorna:")))
        self.channel = QComboBox()
        self.channel.addItem(tr("Stable", "Stabil"), "stable")
        self.channel.addItem(tr("Testing (newer, less tried)", "Teszt (újabb, kevésbé kipróbált)"), "testing")
        row.addWidget(self.channel, 1)
        switch = QPushButton(tr("Switch", "Váltás"))
        switch.clicked.connect(lambda: self.call(["arkadeos-update", "channel", self.channel.currentData()]))
        row.addWidget(switch)
        u.addLayout(row)
        row = QHBoxLayout()
        row.addWidget(QLabel(tr("Graphics card:", "Videokártya:")))
        self.gpu = QComboBox()
        self.gpu.addItem("NVIDIA", "nvidia")
        self.gpu.addItem(tr("AMD or Intel", "AMD vagy Intel"), "other")
        row.addWidget(self.gpu, 1)
        switch = QPushButton(tr("Switch", "Váltás"))
        switch.clicked.connect(lambda: self.call(["arkadeos-update", "gpu", self.gpu.currentData()]))
        row.addWidget(switch)
        u.addLayout(row)
        layout.addWidget(updates)

        firmware = QGroupBox(tr("Firmware", "Firmware"))
        f = QHBoxLayout(firmware)
        f.addWidget(self.button("system-software-update", tr("Look for firmware updates", "Firmware-frissítések keresése"),
                                ["arkadeos-firmware", "check"]))
        f.addWidget(self.button("run-install", tr("Install firmware updates", "Firmware-frissítések telepítése"),
                                ["arkadeos-firmware", "update"]))
        layout.addWidget(firmware)

        desktop = QGroupBox(tr("Reset", "Visszaállítás"))
        d = QHBoxLayout(desktop)
        reset = QPushButton(QIcon.fromTheme("edit-reset"), tr("Restore the desktop defaults", "Asztal alapbeállításainak visszaállítása"))
        reset.clicked.connect(self.reset_desktop)
        d.addWidget(reset)
        factory = QPushButton(QIcon.fromTheme("edit-clear-history"), tr("Factory reset (files stay)", "Gyári visszaállítás (a fájlok megmaradnak)"))
        factory.clicked.connect(self.reset_system)
        d.addWidget(factory)
        layout.addWidget(desktop)

        versions = QGroupBox(tr("Earlier builds (last 90 days)", "Korábbi buildek (az elmúlt 90 nap)"))
        v = QHBoxLayout(versions)
        self.builds = QComboBox()
        v.addWidget(self.builds, 1)
        load = QPushButton(tr("List", "Listázás"))
        load.clicked.connect(lambda: self.builds.addItems(run("arkadeos-update", "versions").splitlines()) if not self.builds.count() else None)
        v.addWidget(load)
        start = QPushButton(tr("Start this one", "Ez induljon"))
        start.clicked.connect(lambda: self.builds.currentText() and self.call(["arkadeos-update", "version", self.builds.currentText()]))
        v.addWidget(start)
        layout.addWidget(versions)
        layout.addStretch()
        self.refresh()

    def button(self, icon, text, command):
        b = QPushButton(QIcon.fromTheme(icon), text)
        b.clicked.connect(lambda: self.call(command))
        return b

    def call(self, command):
        result = subprocess.run(command, capture_output=True, text=True)
        text = (result.stdout + result.stderr).strip()
        if text:
            QMessageBox.information(self, "ArkadeOS", text)
        self.refresh()

    def refresh(self):
        self.version.setText(run("arkadeos-update", "status"))
        for combo, value in ((self.channel, run("arkadeos-update", "channel")),
                             (self.gpu, run("arkadeos-update", "gpu"))):
            index = combo.findData(value)
            if index >= 0:
                combo.setCurrentIndex(index)

    def reset_system(self):
        if QMessageBox.question(self, "ArkadeOS", tr(
                "Reset the system settings to the factory ones? Home folders, users, network "
                "connections, language and keyboard stay; packages added on top are removed. "
                "It counts after a reboot.",
                "Visszaállítod a rendszerbeállításokat a gyáriakra? A saját mappák, a felhasználók, "
                "a hálózati kapcsolatok, a nyelv és a billentyűzet megmaradnak; a ráadásként "
                "telepített csomagok eltűnnek. Újraindítás után érvényes.")) != QMessageBox.Yes:
            return
        result = subprocess.run(["pkexec", "/usr/libexec/arkadeos/reset-system"], capture_output=True, text=True)
        if result.returncode == 0:
            QMessageBox.information(self, "ArkadeOS", tr(
                f"Done. Restart the machine. The old settings are in {result.stdout.strip()}.",
                f"Kész. Indítsd újra a gépet. A régi beállítások itt vannak: {result.stdout.strip()}."))

    def reset_desktop(self):
        if QMessageBox.question(self, "ArkadeOS", tr(
                "Restore the ArkadeOS look, panel, dock and shortcuts? Your own settings are "
                "kept in a backup folder; files and apps stay.",
                "Visszaállítod az ArkadeOS kinézetét, paneljét, dockját és billentyűparancsait? "
                "A saját beállításaid egy mentési mappába kerülnek; a fájlok és az appok "
                "megmaradnak.")) != QMessageBox.Yes:
            return
        backup = run("/usr/libexec/arkadeos/reset-desktop")
        QMessageBox.information(self, "ArkadeOS", tr(
            f"Done. Log out and back in to see it. Your settings are in {backup}.",
            f"Kész. Jelentkezz ki és be, hogy érvénybe lépjen. A beállításaid itt vannak: {backup}."))


# Power profiles a game can run with (arkadeos-power, T011, T055).
PROFILES = [
    ("battery", tr("Battery", "Akku")),
    ("balanced", tr("Balanced", "Kiegyensúlyozott")),
    ("gaming", "Gaming"),
    ("max", tr("Max (charger only)", "Max (csak töltőn)")),
    ("wow", tr("WoW (full CPU, GPU held back)", "WoW (teljes CPU, visszafogott GPU)")),
]
FACTORY_GAMES = Path("/usr/share/arkadeos/game-profiles.conf")
USER_GAMES = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "arkadeos/game-profiles.conf"
GAME_NAMES = {"wow.exe": ("World of Warcraft", "Battle.net"), "wowclassic.exe": ("WoW Classic", "Battle.net")}
STEAM_ROOTS = [Path.home() / ".local/share/Steam", Path.home() / ".var/app/com.valvesoftware.Steam/.local/share/Steam"]
# Steam's own tools are no games.
STEAM_TOOLS = re.compile(r"^(Proton|Steam Linux Runtime|Steamworks Common)")


def read_games(path):
    out = {}
    try:
        for line in path.read_text().splitlines():
            key, _, value = line.partition("=")
            if key.strip() and not key.startswith("#") and value.strip():
                out[key.strip()] = value.strip()
    except OSError:
        pass
    return out


def steam_games():
    """AppId -> name of the installed Steam games, from every Steam library."""
    games = {}
    for root in STEAM_ROOTS:
        libraries = {root}
        try:
            libraries |= {Path(p) for p in re.findall(r'"path"\s+"([^"]+)"',
                                                       (root / "steamapps/libraryfolders.vdf").read_text())}
        except OSError:
            pass
        for library in libraries:
            for manifest in (library / "steamapps").glob("appmanifest_*.acf"):
                try:
                    text = manifest.read_text(errors="replace")
                except OSError:
                    continue
                appid = re.search(r'"appid"\s+"(\d+)"', text)
                name = re.search(r'"name"\s+"([^"]+)"', text)
                if appid and name and not STEAM_TOOLS.match(name.group(1)):
                    games[appid.group(1)] = name.group(1)
    return games


class GamesTab(QWidget):
    def __init__(self):
        super().__init__()
        layout = QVBoxLayout(self)
        intro = QLabel(tr(
            "The power profile each game runs with. It switches on when the game starts, and "
            "the profile before comes back when it exits. A game not on the list runs on Gaming.",
            "Melyik játék milyen energiaprofillal fusson. A játék indulásakor ez kapcsol be "
            "magától, és kilépéskor visszaáll az előző profil. Ami nincs a listán, Gaminggel fut."))
        intro.setWordWrap(True)
        layout.addWidget(intro)
        self.table = QTableWidget(0, 4)
        self.table.setHorizontalHeaderLabels([tr("Game", "Játék"), tr("From", "Honnan"),
                                              tr("Power profile", "Energiaprofil"), ""])
        header = self.table.horizontalHeader()
        header.setSectionResizeMode(0, QHeaderView.Stretch)
        for column in (1, 2, 3):
            header.setSectionResizeMode(column, QHeaderView.ResizeToContents)
        self.table.verticalHeader().hide()
        self.table.setEditTriggers(QTableWidget.NoEditTriggers)
        self.table.setSelectionMode(QTableWidget.NoSelection)
        layout.addWidget(self.table, 1)

        row = QHBoxLayout()
        self.add = QPushButton(QIcon.fromTheme("list-add"), tr("Add a program…", "Program hozzáadása…"))
        self.add.clicked.connect(lambda: self.adding(True))
        row.addWidget(self.add)
        self.name = QLineEdit()
        self.name.setPlaceholderText(tr("The program's name, e.g. Diablo IV.exe", "A program neve, például Diablo IV.exe"))
        self.name.returnPressed.connect(self.add_program)
        row.addWidget(self.name, 1)
        self.add_ok = QPushButton(tr("Add", "Hozzáadás"))
        self.add_ok.clicked.connect(self.add_program)
        row.addWidget(self.add_ok)
        self.add_cancel = QPushButton(tr("Cancel", "Mégse"))
        self.add_cancel.clicked.connect(lambda: self.adding(False))
        row.addWidget(self.add_cancel)
        row.addStretch()
        layout.addLayout(row)
        hint = QLabel(tr(
            "Steam games come on the list by themselves. For another game give the program's name "
            "(e.g. Wow.exe), even before it is installed. ✕ removes a program you added.",
            "A Steam-játékok maguktól kerülnek a listára. Más játékhoz a program nevét kell megadni "
            "(például Wow.exe), akkor is, ha a játék még nincs telepítve. A kézzel felvett programot "
            "a ✕ törli."))
        hint.setWordWrap(True)
        layout.addWidget(hint)
        self.status = QLabel()
        layout.addWidget(self.status)
        self.adding(False)
        self.refresh()

    def adding(self, on):
        self.add.setVisible(not on)
        for widget in (self.name, self.add_ok, self.add_cancel):
            widget.setVisible(on)
        if on:
            self.name.setFocus()
        else:
            self.name.clear()

    def rows(self):
        """(key, name, from, factory profile or None, own profile or None, removable)"""
        factory, own, steam = read_games(FACTORY_GAMES), read_games(USER_GAMES), steam_games()
        keys = {k.lower(): k for k in list(factory) + list(own)}
        out = []
        for low, key in keys.items():
            if key in steam:
                continue
            fac = next((v for k, v in factory.items() if k.lower() == low), None)
            mine = next((v for k, v in own.items() if k.lower() == low), None)
            name, source = GAME_NAMES.get(low, (re.sub(r"(?i)\.exe$", "", key), tr("program", "program")))
            out.append((key, name, source, fac, mine, fac is None))
        for appid, name in sorted(steam.items(), key=lambda kv: kv[1].lower()):
            out.append((appid, name, "Steam", factory.get(appid), own.get(appid), False))
        return out

    def refresh(self):
        rows = self.rows()
        self.table.setRowCount(len(rows))
        names = dict(PROFILES)
        for i, (key, name, source, fac, mine, removable) in enumerate(rows):
            label = QLabel(f"<b>{html.escape(name)}</b> <span style='color:gray'>{html.escape(key)}</span>")
            label.setTextFormat(Qt.RichText)
            self.table.setCellWidget(i, 0, label)
            self.table.setCellWidget(i, 1, QLabel(source))
            combo = QComboBox()
            combo.addItem(tr(f"Default ({names[fac or 'gaming'].split(' (')[0]})",
                             f"Alapértelmezett ({names[fac or 'gaming'].split(' (')[0]})"), "default")
            for profile, text in PROFILES:
                combo.addItem(text, profile)
            index = combo.findData(mine) if mine else 0
            combo.setCurrentIndex(max(index, 0))
            combo.currentIndexChanged.connect(lambda _, k=key, n=name, c=combo: self.choose(k, n, c))
            self.table.setCellWidget(i, 2, combo)
            if removable:
                remove = QToolButton()
                remove.setText("✕")
                remove.setToolTip(tr("Remove from the list", "Törlés a listáról"))
                remove.clicked.connect(lambda _, k=key: self.remove(k))
                self.table.setCellWidget(i, 3, remove)
            else:
                self.table.removeCellWidget(i, 3)

    def power(self, key, profile):
        result = subprocess.run(["arkadeos-power", "game", key, profile], capture_output=True, text=True)
        if result.returncode:
            QMessageBox.warning(self, "ArkadeOS", (result.stdout + result.stderr).strip())
        return result.returncode == 0

    def choose(self, key, name, combo):
        if self.power(key, combo.currentData()):
            self.status.setText(tr(f"Saved: {name} → {combo.currentText()}. It counts from its next start.",
                                   f"Mentve: {name} → {combo.currentText()}. A következő indításától érvényes."))

    def add_program(self):
        key = self.name.text().strip()
        if not key:
            return
        if not key.lower().endswith(".exe"):
            key += ".exe"
        if self.power(key, "gaming"):
            self.adding(False)
            self.refresh()
            self.status.setText(tr(f"Added: {key}. Choose its profile in the list.",
                                   f"Hozzáadva: {key}. A profilját a listában lehet választani."))

    def remove(self, key):
        if self.power(key, "default"):
            self.refresh()
            self.status.setText(tr(f"Removed: {key}. It runs on Gaming again.",
                                   f"Törölve: {key}. Újra Gaminggel fut."))


def main():
    first_run = "--first-run" in sys.argv
    if first_run and FIRST_RUN_DONE.exists():
        return
    app = QApplication(sys.argv)
    app.setDesktopFileName("org.arkadeos.Portal")
    window = QTabWidget()
    window.setWindowTitle("ArkadeOS Portal")
    window.setWindowIcon(QIcon.fromTheme("arkadeos-portal", QIcon.fromTheme("preferences-system")))
    window.addTab(AppsTab(first_run), QIcon.fromTheme("applications-all"), tr("Apps", "Appok"))
    if not first_run:
        window.addTab(SystemTab(), QIcon.fromTheme("preferences-system"), tr("System", "Rendszer"))
        window.addTab(GamesTab(), QIcon.fromTheme("applications-games"), tr("Games", "Játékok"))
    window.resize(760, 640)
    window.show()
    app.exec()


if __name__ == "__main__":
    main()
