        self.name = QLineEdit()
        self.name.setPlaceholderText(tr("The program's name, e.g. Diablo IV.exe", "A program neve, például Diablo IV.exe"))
        self.name.returnPressed.connect(self.add_program)
        row.addWidget(self.name, 1)
        self.add_ok = QPushButton(tr("Add", "Hozzáadás"))
        self.add_ok.clicked.connect(self.add_program)
        row.addWidget(self.add_ok)
        self.add_cancel = QPushButton(tr("Cancel", "Mégse"))
        self.add_cancel.clicked.connect(lambda: self.adding(False))
        row.addWidget(self.add_cancel)
        row.addStretch()
        layout.addLayout(row)
        hint = QLabel(tr(
            "Steam games come on the list by themselves. For another game give the program's name "
            "(e.g. Wow.exe), even before it is installed. ✕ removes a program you added.",
            "A Steam-játékok maguktól kerülnek a listára. Más játékhoz a program nevét kell megadni "
            "(például Wow.exe), akkor is, ha a játék még nincs telepítve. A kézzel felvett programot "
            "a ✕ törli."))
        hint.setObjectName("muted")
        hint.setWordWrap(True)
        layout.addWidget(hint)
        self.status = QLabel()
        layout.addWidget(self.status)
        self.adding(False)
        self.refresh()

    def adding(self, on):
        self.add.setVisible(not on)
        for widget in (self.name, self.add_ok, self.add_cancel):
            widget.setVisible(on)
        if on:
            self.name.setFocus()
        else:
            self.name.clear()

    def rows(self):
        """(key, name, from, factory profile or None, own profile or None, removable)"""
        factory, own, steam = read_games(FACTORY_GAMES), read_games(USER_GAMES), steam_games()
        keys = {k.lower(): k for k in list(factory) + list(own)}
        out = []
        for low, key in keys.items():
            if key in steam:
                continue
            fac = next((v for k, v in factory.items() if k.lower() == low), None)
            mine = next((v for k, v in own.items() if k.lower() == low), None)
            name, source = GAME_NAMES.get(low, (re.sub(r"(?i)\.exe$", "", key), tr("program", "program")))
            out.append((key, name, source, fac, mine, fac is None))
        for appid, name in sorted(steam.items(), key=lambda kv: kv[1].lower()):
            out.append((appid, name, "Steam", factory.get(appid), own.get(appid), False))
        return out

    def refresh(self):
        rows = self.rows()
        self.table.setRowCount(len(rows))
        names = dict(PROFILES)
        for i, (key, name, source, fac, mine, removable) in enumerate(rows):
            label = QLabel(f"<b>{html.escape(name)}</b> <span style='color:gray'>{html.escape(key)}</span>")
            label.setTextFormat(Qt.RichText)
            self.table.setCellWidget(i, 0, label)
            self.table.setCellWidget(i, 1, QLabel(source))
            combo = QComboBox()
            combo.addItem(tr(f"Default ({names[fac or 'gaming'].split(' (')[0]})",
                             f"Alapértelmezett ({names[fac or 'gaming'].split(' (')[0]})"), "default")
            for profile, text in PROFILES:
                combo.addItem(text, profile)
            index = combo.findData(mine) if mine else 0
            combo.setCurrentIndex(max(index, 0))
            combo.currentIndexChanged.connect(lambda _, k=key, n=name, c=combo: self.choose(k, n, c))
            self.table.setCellWidget(i, 2, combo)
            if removable:
                remove = QToolButton()
                remove.setText("✕")
                remove.setToolTip(tr("Remove from the list", "Törlés a listáról"))
                remove.clicked.connect(lambda _, k=key: self.remove(k))
                self.table.setCellWidget(i, 3, remove)
            else:
                self.table.removeCellWidget(i, 3)

    def power(self, key, profile):
        result = subprocess.run(["arkadeos-power", "game", key, profile], capture_output=True, text=True)
        if result.returncode:
            QMessageBox.warning(self, "ArkadeOS", (result.stdout + result.stderr).strip())
        return result.returncode == 0

    def choose(self, key, name, combo):
        if self.power(key, combo.currentData()):
            self.status.setText(tr(f"Saved: {name} → {combo.currentText()}. It counts from its next start.",
                                   f"Mentve: {name} → {combo.currentText()}. A következő indításától érvényes."))

    def add_program(self):
        key = self.name.text().strip()
        if not key:
            return
        if not key.lower().endswith(".exe"):
            key += ".exe"
        if self.power(key, "gaming"):
            self.adding(False)
            self.refresh()
            self.status.setText(tr(f"Added: {key}. Choose its profile in the list.",
                                   f"Hozzáadva: {key}. A profilját a listában lehet választani."))

    def remove(self, key):
        if self.power(key, "default"):
            self.refresh()
            self.status.setText(tr(f"Removed: {key}. It runs on Gaming again.",
                                   f"Törölve: {key}. Újra Gaminggel fut."))


def config(name, group, key):
    run = subprocess.run(["kreadconfig6", "--file", name, "--group", group, "--key", key],
                         capture_output=True, text=True)
    return run.stdout.strip()


def wait_for_look():
    """On the first login the Plasma look is not final yet when the Portal
    starts: the session opens with the image's default (light) look, and
    Plasma's automatic light/dark switch (a kded module) applies the right one
    a few seconds later. The choice screen waits for that (at most 30
    seconds), so it opens in the final look; Breeze follows later switches
    by itself."""
    home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    files = [home / "kdeglobals"]
    automatic = config("kdeglobals", "KDE", "AutomaticLookAndFeel") == "true"
    deadline = time.monotonic() + 30
    scheme = ""
    while time.monotonic() < deadline:
        if automatic:
            kded = subprocess.run(["busctl", "--user", "call", "org.kde.kded6", "/kded",
                                   "org.kde.kded6", "loadedModules"], capture_output=True, text=True)
            ready = "lookandfeelautoswitcher" in kded.stdout
        else:
            ready = True
        scheme = config("kdeglobals", "General", "ColorScheme")
        still = all(not f.exists() or time.time() - f.stat().st_mtime >= 2 for f in files)
        if ready and still:
            break
        time.sleep(0.5)
    print(f"arkadeos-portal: waited for the look, {scheme or 'unset'}", file=sys.stderr)


class LookLog(QObject):
    """Writes the colours the window shows to the journal: when it opens and
    at each light/dark switch it follows (for the VM test)."""

    def __init__(self, window):
        super().__init__(window)
        window.installEventFilter(self)
        self.log()

    def log(self):
        scheme = config("kdeglobals", "General", "ColorScheme")
        print(f"arkadeos-portal: shows the colours {scheme or 'unset'}", file=sys.stderr, flush=True)

    def eventFilter(self, obj, event):
        if event.type() == QEvent.ApplicationPaletteChange:
            self.log()
        return False


def kdeglobals():
    c = configparser.ConfigParser(strict=False, interpolation=None)
    c.optionxform = str
    try:
        c.read(Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "kdeglobals")
    except configparser.Error:
        pass
    return c


def glass_colours():
    """The window frame's glass, active and inactive: the colour scheme's
    title bar colours, with their see-through (ArkadeOS Glass, T086)."""
    c = kdeglobals()
    out = {}
    for active, key, fallback in ((True, "activeBackground", (45, 81, 110, 136)),
                                  (False, "inactiveBackground", (30, 53, 72, 133))):
        try:
            parts = tuple(int(x) for x in c.get("WM", key, fallback="").split(","))
        except ValueError:
            parts = ()
        out[active] = QColor(*(parts if len(parts) in (3, 4) else fallback))
    return out


def mix(a, b, share):
    """Colour a with the given share of b."""
    return QColor(*(round(x + (y - x) * share) for x, y in zip(a.getRgb()[:3], b.getRgb()[:3])))


def rgba(c, alpha):
    return f"rgba({c.red()},{c.green()},{c.blue()},{alpha})"


SWITCHES = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/tmp/arkadeos-portal-{os.getuid()}") / "arkadeos-portal"


def switch_images(on, track, knob):
    """The switch's four looks (on, off, and both greyed) as pictures for the
    style sheet."""
    SWITCHES.mkdir(parents=True, exist_ok=True)
    paths = {}
    for name, fill, x, dot, alpha in (("on", on, 26, "#ffffff", 1), ("off", track, 10, knob, 1),
                                      ("on-disabled", on, 26, "#ffffff", .45), ("off-disabled", track, 10, knob, .45)):
        path = SWITCHES / f"switch-{name}.svg"
        path.write_text(f'<svg xmlns="http://www.w3.org/2000/svg" width="36" height="20" viewBox="0 0 36 20">'
                        f'<g opacity="{alpha}"><rect width="36" height="20" rx="10" fill="{fill}"/>'
                        f'<circle cx="{x}" cy="10" r="7" fill="{dot}"/></g></svg>')
        paths[name] = path.as_posix()
    return paths


def style_sheet(palette):
    """ArkadeOS Glass for the Portal, from the colour scheme in use: the solid
    pane and its cards, switches, buttons and fields; the glass side's words
    white on the dark glass, dark on the light one."""
    window = palette.color(QPalette.Window)
    text = palette.color(QPalette.WindowText)
    accent = palette.color(QPalette.Highlight)
    muted = palette.color(QPalette.PlaceholderText).name()
    dark = window.lightness() < 128
    white, black = QColor("#ffffff"), QColor("#000000")
    card = mix(window, white, .045) if dark else palette.color(QPalette.Base)
    field = mix(window, black, .28) if dark else white
    button = mix(window, text, .10)
    line = rgba(text, .10)
    ink = "#0b1a28"
    glass_ink = "#ffffff" if dark else "#10161f"
    danger = "#ff8fa0" if dark else "#c0283f"
    amber = QColor("#F59E0B")
    s = switch_images(accent.name(), mix(window, text, .22).name(), "#c9d1dc" if dark else "#ffffff")
    return f"""
#pane {{ background: {window.name()}; border-radius: 6px; }}
#scroll, #scrollBody {{ background: transparent; }}
#scroll > QWidget > QWidget {{ background: transparent; }}
#pageTitle {{ font-size: 21px; font-weight: 700; }}
#pageSub, #muted, #cardNote, #footNote {{ color: {muted}; }}
#groupTitle {{ color: {muted}; font-size: 11px; font-weight: 700; letter-spacing: 1px; padding-top: 4px; }}
#card {{ background: {card.name()}; border: 1px solid {line}; border-radius: 10px; }}
#card[pending="true"] {{ background: {rgba(accent, .12)}; border: 1px solid {rgba(accent, .7)}; }}
#card[pending="true"] #cardNote {{ color: {accent.name()}; }}
#cardName {{ font-weight: 600; }}
#cardTitle {{ font-size: 14px; font-weight: 700; }}
#headline {{ font-size: 16px; font-weight: 700; }}
#versions {{ color: {text.name()}; }}
#notice {{ background: {rgba(amber, .14)}; border: 1px solid {rgba(amber, .5)}; border-radius: 8px; padding: 8px 12px; }}
#footBar {{ background: {mix(window, text, .04).name()}; border-top: 1px solid {line};
  border-bottom-left-radius: 6px; border-bottom-right-radius: 6px; }}
#pane QPushButton {{ background: {button.name()}; border: 1px solid {line}; border-radius: 8px; padding: 6px 14px;
  font-weight: 600; min-height: 18px; }}
#pane QPushButton:hover {{ background: {mix(window, text, .16).name()}; }}
#pane QPushButton:disabled {{ color: {muted}; }}
#pane QPushButton#primary {{ background: {accent.name()}; color: {ink}; border: 1px solid {accent.name()}; }}
#pane QPushButton#primary:hover {{ background: {accent.lighter(112).name()}; }}
#pane QPushButton#primary:disabled {{ background: {rgba(accent, .45)}; color: {rgba(QColor(ink), .6)}; }}
#pane QPushButton#danger {{ color: {danger}; }}
#pane QLineEdit, #pane QComboBox {{ background: {field.name()}; border: 1px solid {line}; border-radius: 8px;
  padding: 5px 10px; min-height: 18px; }}
#pane QComboBox::drop-down {{ border: none; width: 22px; }}
#switch::indicator {{ width: 36px; height: 20px; }}
#switch::indicator:checked {{ image: url({s["on"]}); }}
#switch::indicator:unchecked {{ image: url({s["off"]}); }}
#switch::indicator:checked:disabled {{ image: url({s["on-disabled"]}); }}
#switch::indicator:unchecked:disabled {{ image: url({s["off-disabled"]}); }}
#log {{ background: {field.name()}; border: 1px solid {line}; border-radius: 8px; }}
#progressBox {{ background: {field.name()}; border: 1px solid {line}; border-radius: 10px; }}
#progressBox QProgressBar {{ background: {mix(window, black, .45 if dark else .12).name()}; border: none; border-radius: 4px; }}
#progressBox QProgressBar::chunk {{ border-radius: 4px; background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
  stop:0 {accent.name()}, stop:1 {accent.lighter(125).name()}); }}
#games, #games QHeaderView {{ background: transparent; border: none; }}
#games QComboBox {{ margin: 6px 0; }}
#games QHeaderView::section {{ background: transparent; border: none; border-bottom: 1px solid {line};
  color: {muted}; padding: 6px 8px; font-weight: 700; }}
#side QPushButton#nav {{ background: transparent; color: {glass_ink}; border: 1px solid transparent; border-radius: 8px;
  padding: 8px 10px; text-align: left; font-size: 14px; font-weight: 600; }}
#side QPushButton#nav:hover {{ background: rgba(255,255,255,.10); }}
#side QPushButton#nav:checked {{ background: rgba(255,255,255,{.20 if dark else .45}); border: 1px solid rgba(255,255,255,{.35 if dark else .7}); }}
#badge {{ background: {accent.name()}; color: {ink}; border-radius: 9px; padding: 1px 7px; font-size: 11px; font-weight: 700; }}
#sideFoot {{ color: {glass_ink}; font-size: 11px; }}
"""


class Portal(QWidget):
    """The window: the pages listed on the glass at the left, the page on a
    solid pane at the right (design A)."""

    def __init__(self, first_run):
        super().__init__()
        self.setAttribute(Qt.WA_TranslucentBackground)
        self.setWindowTitle("ArkadeOS Portal")
        self.setWindowIcon(QIcon.fromTheme("arkadeos-portal", QIcon.fromTheme("preferences-system")))
        self.glass = glass_colours()
        row = QHBoxLayout(self)
        row.setContentsMargins(0, 0, 0, 0)
        row.setSpacing(7)
        side = QWidget()
        side.setObjectName("side")
        side.setFixedWidth(196)
        self.nav = QVBoxLayout(side)
        self.nav.setContentsMargins(4, 2, 0, 4)
        self.nav.setSpacing(2)
        row.addWidget(side)
        pane = QFrame()
        pane.setObjectName("pane")
        inside = QVBoxLayout(pane)
        inside.setContentsMargins(0, 0, 0, 0)
        self.stack = QStackedWidget()
        inside.addWidget(self.stack)
        row.addWidget(pane, 1)
        self.buttons = QButtonGroup(self)

        apps = AppsTab(first_run)
        button = self.page(apps, "view-app-grid-symbolic", tr("Apps", "Appok"))
        apps.pending.connect(lambda n, b=button: self.badge(b, str(n) if n else ""))
        if not first_run:
            self.page(GamesTab(), "input-gamepad-symbolic", tr("Games", "Játékok"))
            system = SystemTab()
            button = self.page(system, "preferences-system-symbolic", tr("System", "Rendszer"))
            # The Portal opens on Apps: a newer version shows beside System.
            system.newer.connect(lambda on, b=button: self.badge(b, tr("new", "új") if on else ""))
        self.nav.addStretch()
        version = next((line.split("=", 1)[1].strip('"') for line in Path("/usr/lib/os-release").read_text().splitlines()
                        if line.startswith("VERSION=")), "")
        channel = {"stable": tr("Stable channel", "Stabil csatorna"), "testing": tr("Testing channel", "Teszt csatorna")}.get(
            run("arkadeos-update", "channel"), "")
        foot = QLabel("\n".join(x for x in (f"ArkadeOS {version}".strip(), channel) if x))
        foot.setObjectName("sideFoot")
        foot.setContentsMargins(10, 0, 0, 6)
        self.nav.addWidget(foot)
        self.buttons.buttons()[0].setChecked(True)

    def page(self, widget, icon, title):
        index = self.stack.addWidget(widget)
        button = QPushButton(QIcon.fromTheme(icon), "  " + title)
        button.setObjectName("nav")
        button.setCheckable(True)
        button.clicked.connect(lambda: self.stack.setCurrentIndex(index))
        inner = QHBoxLayout(button)
        inner.setContentsMargins(0, 0, 10, 0)
        inner.addStretch()
        badge = QLabel()
        badge.setObjectName("badge")
        badge.setAttribute(Qt.WA_TransparentForMouseEvents)
        badge.setFixedHeight(18)
        badge.hide()
        inner.addWidget(badge, 0, Qt.AlignVCenter)
        button.badge_label = badge
        self.buttons.addButton(button)
        self.nav.addWidget(button)
        return button

    @staticmethod
    def badge(button, text):
        button.badge_label.setText(text)
        button.badge_label.setVisible(bool(text))

    def restyle(self):
        self.glass = glass_colours()
        QApplication.instance().setStyleSheet(style_sheet(QApplication.palette()))
        self.update()

    def event(self, event):
        if event.type() == QEvent.ApplicationPaletteChange:
            # The day/night switch: the colours and the glass come again.
            QTimer.singleShot(0, self.restyle)
        elif event.type() == QEvent.WindowActivate or event.type() == QEvent.WindowDeactivate:
            self.update()
        return super().event(event)

    def paintEvent(self, event):
        # The glass: the frame's own colour, KWin blurs the desktop behind it.
        painter = QPainter(self)
        painter.setCompositionMode(QPainter.CompositionMode_Source)
        painter.fillRect(self.rect(), self.glass[self.isActiveWindow()])


def main():
    first_run = "--first-run" in sys.argv
    if first_run and FIRST_RUN_DONE.exists():
        return
    if first_run:
        wait_for_look()
    app = QApplication(sys.argv)
    app.setDesktopFileName("org.arkadeos.Portal")
    app.setStyleSheet(style_sheet(app.palette()))
    window = Portal(first_run)
    window.resize(960, 640)
    LookLog(window)
    window.show()
    app.exec()


if __name__ == "__main__":
    main()
