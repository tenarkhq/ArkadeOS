    @staticmethod
    def heading(icon, text):
        """A card's title with its icon."""
        box = QWidget()
        row = QHBoxLayout(box)
        row.setContentsMargins(0, 0, 0, 0)
        row.setSpacing(8)
        mark = QLabel()
        mark.setPixmap(QIcon.fromTheme(icon).pixmap(18, 18))
        row.addWidget(mark)
        title = QLabel(text)
        title.setObjectName("cardTitle")
        row.addWidget(title, 1)
        return box

    def update_headline(self, running=False):
        """The update card's first line: what to know at a glance."""
        if running:
            text, kind = tr("Updating…", "Frissítés folyamatban…"), "busy"
        elif self.staged:
            text, kind = tr(f"{self.staged} starts after a restart", f"Újraindítás után a {self.staged} indul"), "new"
        elif self.latest_newer:
            text, kind = tr("A newer version is out", "Újabb verzió érhető el"), "new"
        elif self.looking:
            text, kind = tr("Looking for a newer version…", "Újabb verzió keresése…"), "busy"
        else:
            text, kind = tr("The system is up to date", "A rendszer naprakész"), "ok"
        palette = QApplication.palette()
        mark, colour = {"ok": ("✓", "#22C55E"), "new": ("●", palette.color(QPalette.Highlight).name()),
                        "busy": ("…", palette.color(QPalette.PlaceholderText).name())}[kind]
        self.headline.setText(f"<span style='color:{colour}'>{mark}</span>&nbsp;&nbsp;{html.escape(text)}")

    def poll(self):
        if not self.isVisible() and not self.running:
            return
        s = update_state(self.log)
        self.progress.show_state(s)
        running = s["kind"] == "running"
        self.update_now.setEnabled(not running)
        self.rollback.setEnabled(not running)
        self.update_now.setText(tr("Updating…", "Frissítés folyamatban…") if running
                                else tr("Update now", "Frissítés most"))
        self.restart.setVisible(bool(s["staged"]) and not running)
        self.staged = s["staged"]
        self.update_headline(running)
        if self.running and not running:
            self.refresh()
        self.running = running

    def showEvent(self, event):
        super().showEvent(event)
        self.poll()
        # The Portal may stay open for hours: asked again after ten minutes.
        if time.monotonic() - self.looked > 600:
            self.look_for_newer()

    def look_for_newer(self):
        """Asks the channel for its newest version, in the background."""
        if self.looking:
            # What it compares with changed meanwhile: asked once more after it.
            self.again = True
            return
        self.looking, self.looked = True, time.monotonic()
        self.check.setEnabled(False)
        self.latest_line = tr("Newest available: looking…", "Legfrissebb elérhető: keresés…")
        self.show_versions()
        self.checker.start("arkadeos-update", ["latest"])

    def newer_found(self, code=1, status=QProcess.CrashExit):
        if not self.looking:
            return
        self.looking = False
        out = bytes(self.checker.readAllStandardOutput()).decode(errors="replace").strip()
        self.latest_line = out.splitlines()[-1] if out else tr(
            "Newest available: the channel could not be reached",
            "Legfrissebb elérhető: a csatorna most nem érhető el")
        # arkadeos-update latest: exit status 10 when a newer one is out.
        self.latest_newer = status == QProcess.NormalExit and code == 10
        self.check.setEnabled(True)
        self.show_versions()
        self.newer.emit(self.latest_newer)
        if self.again:
            self.again = False
            self.look_for_newer()

    def show_versions(self):
        lines = self.status_lines + ([self.latest_line] if self.latest_line else [])
        self.version.setText(version_table(lines, self.latest_line if self.latest_newer else ""))
        self.update_headline(self.running)

    def button(self, icon, text, command):
        b = QPushButton(QIcon.fromTheme(icon), text)
        b.clicked.connect(lambda: self.call(command))
        return b

    def call(self, command):
        result = subprocess.run(command, capture_output=True, text=True)
        text = (result.stdout + result.stderr).strip()
        if text:
            QMessageBox.information(self, "ArkadeOS", text)
        self.refresh()
        self.poll()

    def refresh(self):
        """The version lines again: at the start, after an update and after
        every change made here (channel, going back, an earlier build)."""
        self.status_lines = run("arkadeos-update", "status").splitlines()
        self.show_versions()
        index = self.channel.findData(run("arkadeos-update", "channel"))
        if index >= 0:
            self.channel.setCurrentIndex(index)
        self.look_for_newer()

    def reset_system(self):
        if QMessageBox.question(self, "ArkadeOS", tr(
                "Reset the system settings to the factory ones? Home folders, users, network "
                "connections, language and keyboard stay; packages added on top are removed. "
                "It counts after a reboot.",
                "Visszaállítod a rendszerbeállításokat a gyáriakra? A saját mappák, a felhasználók, "
                "a hálózati kapcsolatok, a nyelv és a billentyűzet megmaradnak; a ráadásként "
                "telepített csomagok eltűnnek. Újraindítás után érvényes.")) != QMessageBox.Yes:
            return
        result = subprocess.run(["pkexec", "/usr/libexec/arkadeos/reset-system"], capture_output=True, text=True)
        if result.returncode == 0:
            QMessageBox.information(self, "ArkadeOS", tr(
                f"Done. Restart the machine. The old settings are in {result.stdout.strip()}.",
                f"Kész. Indítsd újra a gépet. A régi beállítások itt vannak: {result.stdout.strip()}."))

    def reset_desktop(self):
        if QMessageBox.question(self, "ArkadeOS", tr(
                "Restore the ArkadeOS look, taskbar and shortcuts? Your own settings are "
                "kept in a backup folder; files and apps stay.",
                "Visszaállítod az ArkadeOS kinézetét, tálcáját és billentyűparancsait? "
                "A saját beállításaid egy mentési mappába kerülnek; a fájlok és az appok "
                "megmaradnak.")) != QMessageBox.Yes:
            return
        backup = run("/usr/libexec/arkadeos/reset-desktop")
        QMessageBox.information(self, "ArkadeOS", tr(
            f"Done. Log out and back in to see it. Your settings are in {backup}.",
            f"Kész. Jelentkezz ki és be, hogy érvénybe lépjen. A beállításaid itt vannak: {backup}."))


# Power profiles a game can run with (arkadeos-power, T011, T055).
PROFILES = [
    ("battery", tr("Battery", "Akku")),
    ("balanced", tr("Balanced", "Kiegyensúlyozott")),
    ("gaming", "Gaming"),
    ("max", tr("Max (charger only)", "Max (csak töltőn)")),
    ("wow", tr("WoW (full CPU, GPU held back)", "WoW (teljes CPU, visszafogott GPU)")),
]
FACTORY_GAMES = Path("/usr/share/arkadeos/game-profiles.conf")
USER_GAMES = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "arkadeos/game-profiles.conf"
GAME_NAMES = {"wow.exe": ("World of Warcraft", "Battle.net"), "wowclassic.exe": ("WoW Classic", "Battle.net")}
STEAM_ROOTS = [Path.home() / ".local/share/Steam", Path.home() / ".var/app/com.valvesoftware.Steam/.local/share/Steam"]
# Steam's own tools are no games.
STEAM_TOOLS = re.compile(r"^(Proton|Steam Linux Runtime|Steamworks Common)")


def read_games(path):
    out = {}
    try:
        for line in path.read_text().splitlines():
            key, _, value = line.partition("=")
            if key.strip() and not key.startswith("#") and value.strip():
                out[key.strip()] = value.strip()
    except OSError:
        pass
    return out


def steam_games():
    """AppId -> name of the installed Steam games, from every Steam library."""
    games = {}
    for root in STEAM_ROOTS:
        libraries = {root}
        try:
            libraries |= {Path(p) for p in re.findall(r'"path"\s+"([^"]+)"',
                                                       (root / "steamapps/libraryfolders.vdf").read_text())}
        except OSError:
            pass
        for library in libraries:
            for manifest in (library / "steamapps").glob("appmanifest_*.acf"):
                try:
                    text = manifest.read_text(errors="replace")
                except OSError:
                    continue
                appid = re.search(r'"appid"\s+"(\d+)"', text)
                name = re.search(r'"name"\s+"([^"]+)"', text)
                if appid and name and not STEAM_TOOLS.match(name.group(1)):
                    games[appid.group(1)] = name.group(1)
    return games


