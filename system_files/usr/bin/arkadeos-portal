#!/usr/bin/python3
"""ArkadeOS Portal (T037): everything optional of ArkadeOS in one window.

Apps: tick to install, untick to remove (portal-item does the work). On the
first login it opens by itself as the choice screen (T026, --first-run): the
defaults are ticked, and what is chosen gets installed.
System: update now, go back to the previous version, channel (stable or
testing), the image for the graphics card, firmware, desktop defaults.
Games: the power profile each game runs with (T055); arkadeos-power game
keeps the list, a game not on it runs on Gaming.

The window is ArkadeOS Glass's (T086, Roland, 2026-11-13, design A of
https://claude.ai/artifact/A9QNLgyxWb3rFxzpJJBJs8): the pages listed on the
glass at the left, in the window frame's own glass colour (KWin blurs behind
every window), each page on a solid pane with cards; switches instead of
ticks, the changes waiting to be applied in a bar at the bottom.
"""
import configparser
import html
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

from PySide6.QtCore import (
    QEvent, QLocale, QObject, QProcess, Qt, QThread, QTimer, Signal,
)
from PySide6.QtGui import QColor, QIcon, QPainter, QPalette
from PySide6.QtWidgets import (
    QApplication, QButtonGroup, QCheckBox, QComboBox, QFrame, QGraphicsDropShadowEffect, QGridLayout,
    QHBoxLayout, QHeaderView, QLabel, QLineEdit, QMessageBox, QPlainTextEdit, QProgressBar, QPushButton,
    QScrollArea, QStackedWidget, QTableWidget, QToolButton, QVBoxLayout, QWidget,
)

ITEM = "/usr/libexec/arkadeos/portal-item"
CATALOG = Path("/usr/share/arkadeos/portal/catalog.tsv")
APPS_LIST = Path("/usr/share/arkadeos/apps.list")
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "arkadeos"
FIRST_RUN_DONE = STATE / "portal-first-run"
# Chosen in the installer (T026): the first start installs it without asking.
FROM_INSTALLER = Path("/etc/arkadeos/apps-from-installer")
CHOSEN = Path("/etc/arkadeos/apps")

HU = QLocale().name().startswith("hu")


def tr(en, hu):
    return hu if HU else en


GROUPS = {
    "base": tr("Basic apps", "Alap appok"),
    "chat": tr("Chat", "Csevegés"),
    "stores": tr("Game stores", "Játékáruházak"),
    "gaming": tr("Gaming", "Játék"),
    "stream": tr("Streaming and recording", "Streamelés és felvétel"),
    "desktop": tr("Desktop", "Asztal"),
    "ai": tr("AI", "AI"),
    "dev": tr("Developer tools", "Fejlesztői eszközök"),
    "vendor": tr("Laptop maker (only the detected one can be chosen)",
                 "Gépgyártó (csak a felismert választható)"),
}


def catalog():
    items = []
    for line in CATALOG.read_text().splitlines():
        if not line or line.startswith("#"):
            continue
        item_id, group, kind, ref, en, hun = line.split("\t")
        items.append({"id": item_id, "group": group, "kind": kind, "name": tr(en, hun)})
    return items


def defaults():
    """The apps that come by default (apps.list: always or on)."""
    on = set()
    for line in APPS_LIST.read_text().splitlines():
        if line and not line.startswith("#"):
            item_id, _, default = line.split("|")
            if default in ("always", "on"):
                on.add(item_id)
    return on


def run(*args):
    return subprocess.run(args, capture_output=True, text=True).stdout.strip()


class StatusReader(QObject):
    """Reads every item's status in the background: some take a moment."""
    found = Signal(str, bool)
    finished = Signal()

    def __init__(self, ids):
        super().__init__()
        self.ids = ids

    def work(self):
        for item_id in self.ids:
            self.found.emit(item_id, run(ITEM, item_id, "status") == "on")
        self.finished.emit()


def split_name(name):
    """'EasyEffects (microphone filter)' -> ('EasyEffects', 'microphone filter')."""
    m = re.match(r"^(.*?) \((.*)\)$", name)
    return (m.group(1), m.group(2)) if m else (name, "")


def page_head(title, text, extra=None):
    """A page's title and its line under it, with an extra widget at the right."""
    head = QHBoxLayout()
    head.setContentsMargins(22, 18, 22, 10)
    words = QVBoxLayout()
    words.setSpacing(2)
    big = QLabel(title)
    big.setObjectName("pageTitle")
    words.addWidget(big)
    line = QLabel(text)
    line.setObjectName("pageSub")
    line.setWordWrap(True)
    words.addWidget(line)
    head.addLayout(words, 1)
    if extra is not None:
        head.addWidget(extra, 0, Qt.AlignBottom)
    return head, line


def card():
    frame = QFrame()
    frame.setObjectName("card")
    return frame


def set_flag(widget, name, value):
    """A style flag of a widget (its look in the style sheet follows it)."""
    if widget.property(name) != value:
        widget.setProperty(name, value)
        widget.style().unpolish(widget)
        widget.style().polish(widget)


class AppsTab(QWidget):
    # How many changes wait to be applied (shown beside the page's name).
    pending = Signal(int)

    def __init__(self, first_run):
        super().__init__()
        self.first_run = first_run
        self.from_installer = first_run and FROM_INSTALLER.exists()
        self.chosen = set(CHOSEN.read_text().split()) if self.from_installer and CHOSEN.exists() else set()
        self.items = catalog()
        self.installed = {}
        self.boxes = {}
        self.names = {i["id"]: i["name"] for i in self.items}
        self.cards = {}
        self.queue = []
        self.busy = False
        self.loaded = False

        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)
        self.search = QLineEdit()
        self.search.setObjectName("search")
        self.search.setPlaceholderText(tr("Search the apps", "Keresés az appok között"))
        self.search.setClearButtonEnabled(True)
        self.search.setFixedWidth(240)
        self.search.textChanged.connect(self.filter)
        head, _ = page_head(tr("Apps", "Appok"), tr(
            "Welcome to ArkadeOS! What you chose during the installation is being set up; "
            "everything can be changed here later.",
            "Üdv az ArkadeOS-en! Most települ, amit a telepítéskor kiválasztottál; később itt "
            "bármikor módosíthatod.") if self.from_installer else tr(
            "Welcome to ArkadeOS! Switch on what you want on this machine; everything can be "
            "changed here later too.",
            "Üdv az ArkadeOS-en! Kapcsold be, mi kerüljön a gépre; később itt bármikor "
            "módosíthatod.") if first_run else tr(
            "Switch on what you want on this machine, switch off what you would remove.",
            "Kapcsold be, ami kell ezen a gépen, kapcsold ki, amit eltávolítanál."), self.search)
        layout.addLayout(head)
        # T053: what the installer's hardware check found (English and
        # Hungarian line of each finding).
        check = Path("/etc/arkadeos/hardware-check.txt")
        if first_run and check.exists():
            notes = [b.splitlines() for b in check.read_text().split("\n\n") if b.strip()]
            found = QLabel("\n".join("⚠ " + (n[1] if HU and len(n) > 1 else n[0]) for n in notes))
            found.setObjectName("notice")
            found.setWordWrap(True)
            box = QHBoxLayout()
            box.setContentsMargins(22, 0, 22, 10)
            box.addWidget(found)
            layout.addLayout(box)

        self.locked = set()
        body = QWidget()
        body.setObjectName("scrollBody")
        groups = QVBoxLayout(body)
        groups.setContentsMargins(22, 0, 22, 16)
        groups.setSpacing(6)
        self.groups = []
        for group, title in GROUPS.items():
            members = [i for i in self.items if i["group"] == group]
            if not members:
                continue
            heading = QLabel(title.upper())
            heading.setObjectName("groupTitle")
            groups.addWidget(heading)
            grid = QGridLayout()
            grid.setHorizontalSpacing(8)
            grid.setVerticalSpacing(8)
            grid.setColumnStretch(0, 1)
            grid.setColumnStretch(1, 1)
            groups.addLayout(grid)
            groups.addSpacing(8)
            frames = []
            for item in members:
                frame = card()
                row = QHBoxLayout(frame)
                row.setContentsMargins(12, 8, 12, 8)
                row.setSpacing(12)
                words = QVBoxLayout()
                words.setSpacing(0)
                name, about = split_name(item["name"])
                title_label = QLabel(name)
                title_label.setObjectName("cardName")
                words.addWidget(title_label)
                note = QLabel()
                note.setObjectName("cardNote")
                words.addWidget(note)
                row.addLayout(words, 1)
                switch = QCheckBox()
                switch.setObjectName("switch")
                switch.setCursor(Qt.PointingHandCursor)
                switch.setEnabled(False)
                switch.setAccessibleName(item["name"])
                row.addWidget(switch)
                frame.about = about
                frame.note = note
                frame.switch = switch
                if item["kind"] == "fixed":
                    # Part of the image: shown so the list is complete, never removed.
                    switch.setChecked(True)
                    frame.about = tr("always on this machine", "a rendszer része")
                else:
                    self.boxes[item["id"]] = switch
                    self.cards[item["id"]] = frame
                    switch.toggled.connect(self.changed)
                if item["group"] == "vendor" and run("arkadeos-vendor", item["id"], "allowed") != "yes":
                    # Another maker's machine (arkadeos-vendor): never selectable here.
                    self.locked.add(item["id"])
                    frame.about = tr("this machine is not this maker's laptop",
                                     "ez a gép nem ennek a gyártónak a laptopja")
                note.setText(frame.about)
                note.setVisible(bool(frame.about))
                frame.item = item
                frames.append(frame)
            self.groups.append((heading, grid, frames))
        groups.addStretch()
        self.place()
        scroll = QScrollArea()
        scroll.setObjectName("scroll")
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.NoFrame)
        scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        scroll.setWidget(body)
        layout.addWidget(scroll, 1)

        self.log = QPlainTextEdit()
        self.log.setObjectName("log")
        self.log.setReadOnly(True)
        self.log.setMaximumHeight(140)
        self.log.hide()
        logbox = QHBoxLayout()
        logbox.setContentsMargins(22, 0, 22, 10)
        logbox.addWidget(self.log)
        layout.addLayout(logbox)

        bar = QFrame()
        bar.setObjectName("footBar")
        row = QHBoxLayout(bar)
        row.setContentsMargins(16, 10, 16, 10)
        self.state = QLabel(tr("Checking what is installed…", "Annak ellenőrzése, mi van telepítve…"))
        self.state.setObjectName("footNote")
        self.state.setTextFormat(Qt.RichText)
        row.addWidget(self.state, 1)
        self.cancel = QPushButton(tr("Cancel", "Mégse"))
        self.cancel.clicked.connect(self.undo)
        self.cancel.setVisible(False)
        row.addWidget(self.cancel)
        self.apply = QPushButton(QIcon.fromTheme("dialog-ok-apply"), tr("Apply", "Alkalmazás"))
        self.apply.setObjectName("primary")
        self.apply.setEnabled(False)
        self.apply.clicked.connect(self.start)
        row.addWidget(self.apply)
        layout.addWidget(bar)

        self.thread = QThread()
        self.reader = StatusReader([i["id"] for i in self.items if i["kind"] != "fixed"])
        self.reader.moveToThread(self.thread)
        self.thread.started.connect(self.reader.work)
        self.reader.found.connect(self.found)
        self.reader.finished.connect(self.ready)
        self.reader.finished.connect(self.thread.quit)
        self.thread.start()

    def place(self, text=""):
        """The cards that match the search, two by two, under their group."""
        text = text.strip().lower()
        for heading, grid, frames in self.groups:
            shown = [f for f in frames if not text or text in f.item["name"].lower()]
            for frame in frames:
                grid.removeWidget(frame)
                frame.setVisible(frame in shown)
            for n, frame in enumerate(shown):
                grid.addWidget(frame, n // 2, n % 2)
            heading.setVisible(bool(shown))

    def filter(self, text):
        self.place(text)

    def changes(self):
        if not self.loaded:
            return []
        return [(i, b.isChecked()) for i, b in self.boxes.items() if b.isChecked() != self.installed.get(i, False)]

    def changed(self):
        """Marks the cards whose switch differs from what is installed, and
        says in the bar what waits to be applied."""
        waiting = dict(self.changes())
        for item_id, frame in self.cards.items():
            if item_id in waiting:
                set_flag(frame, "pending", True)
                frame.note.setText(tr("to be installed", "telepítésre jelölve") if waiting[item_id]
                                   else tr("to be removed", "eltávolításra jelölve"))
                frame.note.setVisible(True)
            else:
                set_flag(frame, "pending", False)
                frame.note.setText(frame.about)
                frame.note.setVisible(bool(frame.about))
        if self.loaded and not self.busy:
            names = [split_name(self.names[i])[0] for i in waiting]
            if names:
                count = tr(f"{len(names)} change{'s' if len(names) > 1 else ''}", f"{len(names)} változás")
                shown = ", ".join(names[:3]) + ("…" if len(names) > 3 else "")
                self.state.setText(f"<b>{count}</b> " + tr("waiting: ", "vár: ") + html.escape(shown))
            else:
                self.state.setText(tr("Everything is as it is on the machine.", "Minden úgy van, ahogy a gépen."))
            self.cancel.setVisible(bool(names) and not self.first_run)
        self.pending.emit(len(waiting))

    def undo(self):
        for item_id, switch in self.boxes.items():
            switch.setChecked(self.installed.get(item_id, False))

    def found(self, item_id, on):
        self.installed[item_id] = on
        check = self.boxes[item_id]
        if self.from_installer:
            # The installer's choice; makers follow /etc/arkadeos/vendor, so their status.
            vendor = any(i["id"] == item_id and i["group"] == "vendor" for i in self.items)
            check.setChecked(on if vendor else item_id in self.chosen)
        else:
            check.setChecked(on or (self.first_run and item_id in defaults()))
        check.setEnabled(item_id not in self.locked)

    def ready(self):
        self.loaded = True
        self.state.setText("")
        self.apply.setEnabled(True)
        self.changed()
        if self.from_installer:
            self.start()

    def start(self):
        self.queue = [(i, "install" if b.isChecked() else "remove") for i, b in self.boxes.items()
                      if b.isChecked() != self.installed.get(i, False)]
        if self.first_run and not self.from_installer:
            chosen = [i for i, b in self.boxes.items() if b.isChecked()]
            subprocess.run(["pkexec", "/usr/libexec/arkadeos/apps-choose", *chosen])
        if not self.queue:
            self.done()
            return
        self.busy = True
        self.apply.setEnabled(False)
        self.cancel.setVisible(False)
        for check in self.boxes.values():
            check.setEnabled(False)
        self.log.show()
        self.next()

    def next(self):
        if not self.queue:
            self.done()
            return
        item_id, action = self.queue.pop(0)
        name = self.names[item_id]
        self.state.setText(html.escape(tr(f"{'Installing' if action == 'install' else 'Removing'}: {name}",
                                          f"{'Telepítés' if action == 'install' else 'Eltávolítás'}: {name}")))
        proc = QProcess(self)
        proc.setProcessChannelMode(QProcess.MergedChannels)
        proc.readyRead.connect(lambda: self.log.appendPlainText(
            bytes(proc.readAll()).decode(errors="replace").rstrip()))
        proc.finished.connect(lambda code, _status: self.item_done(item_id, action, code))
        proc.start(ITEM, [item_id, action])

    def item_done(self, item_id, action, code):
        ok = code == 0
        if ok:
            self.installed[item_id] = action == "install"
        else:
            self.boxes[item_id].setChecked(self.installed.get(item_id, False))
        self.log.appendPlainText(("✔ " if ok else "✘ ") + self.names[item_id])
        self.next()

    def done(self):
        if self.first_run:
            STATE.mkdir(parents=True, exist_ok=True)
            FIRST_RUN_DONE.touch()
        self.busy = False
        self.apply.setEnabled(True)
        for item_id, check in self.boxes.items():
            check.setEnabled(item_id not in self.locked)
        self.changed()
        self.state.setText(tr("Done.", "Kész."))


# The update (uupd.service, "Update now" or the daily 04:00 run) and how far it
# is: uupd writes each step to the journal as JSON (--json), and for the system
# step every progress line of bootc with the bytes fetched. Members of wheel
# read the system journal; without it the bar only shows that the update runs.
UPDATE_STEPS = [
    ("System", "", tr("System", "Rendszer")),
    ("Brew", "", "Homebrew"),
    ("Flatpak", "System Apps", tr("Machine's apps", "Gép appjai")),
    ("Flatpak", "Apps for User", tr("Own apps", "Saját appok")),
    ("Distrobox", "", tr("Containers", "Konténerek")),
]
# The system step's stages, by uupd's name for them. "Bootc" is the step's
# first line, before bootc reports anything: it asks the channel then.
SYSTEM_STAGES = {
    "Bootc": ("check", tr("looking for a new version", "új verzió keresése")),
    "Downloading": ("download", tr("download", "letöltés")),
    "Importing": ("import", tr("unpack", "beépítés")),
    "Deploying": ("deploy", tr("install", "telepítés")),
}
OTHER_STAGE = ("prepare", tr("preparing", "előkészítés"))
# The download's bytes at the head of a bootc progress line (canonical JSON,
# keys in ABC order) inside uupd's line. Read from the head only: the line
# also lists every layer fetched so far, tens of kilobytes near the end, and
# the journal cuts a line at 48K.
DOWNLOAD_BYTES = re.compile(r'"output":"\{\\"bytes\\":(\d+),\\"bytesCached\\":\d+,\\"bytesTotal\\":(\d+),')
STEP_DOING = [
    tr("Updating Homebrew", "Homebrew frissítése"),
    tr("Updating the machine's apps", "A gép appjainak frissítése"),
    tr("Updating own apps", "Saját appok frissítése"),
    tr("Updating containers", "Konténerek frissítése"),
]
# A finished update stays on show this long, or until the reboot it waits for.
SHOW_DONE = 6 * 3600


def update_step(title, description):
    for i, (t, d, _) in enumerate(UPDATE_STEPS):
        if t == title and description.startswith(d):
            return i
    return None


def new_progress():
    """What the update's log told so far: the step (UPDATE_STEPS), the system
    step's stage, the text for it, the download's bytes and the failed steps."""
    return {"step": None, "stage": "", "text": "", "bytes": None, "total": None, "failed": []}


def parse_update_log(lines, seen=None):
    """Adds uupd's journal lines to what was seen so far (new_progress).

    The download's size and how much of it is here come from bootc's own
    progress lines. uupd's "overall" percentage is not used: it gives each of
    its steps the same share, so a system download of gigabytes moved the bar
    from 0 to 20%, and the three app steps took the rest in seconds (Roland,
    2026-11-12)."""
    seen = new_progress() if seen is None else seen
    for line in lines:
        if not line.startswith("{"):
            continue
        if '"msg":"Command output"' in line[:80]:
            m = DOWNLOAD_BYTES.search(line[:400])
            if m:
                seen["bytes"], seen["total"] = int(m.group(1)), int(m.group(2))
            continue
        if '"msg":"Updating"' not in line and '"msg":"module_fail"' not in line:
            continue
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if e.get("msg") == "Updating":
            i = update_step(e.get("title", ""), e.get("description", ""))
            if i is None:
                continue
            seen["step"] = i
            if i == 0:
                seen["stage"], stage = SYSTEM_STAGES.get(e.get("description", ""), OTHER_STAGE)
                seen["text"] = f"{UPDATE_STEPS[0][2]}: {stage}"
            else:
                seen["stage"], seen["text"] = "", STEP_DOING[i - 1]
        elif e.get("msg") == "module_fail":
            name = (e.get("module") or "").split(" ")[0].capitalize()
            seen["failed"].append({"System": UPDATE_STEPS[0][2], "Brew": "Homebrew", "Flatpak": tr("Apps", "Appok"),
                                   "Distrobox": UPDATE_STEPS[4][2]}.get(name, name))
    return seen


class UpdateLog:
    """uupd's journal lines of the running or last update, read a piece at a
    time: a full system download leaves tens of megabytes of them, and the
    page asks every two seconds."""

    def __init__(self):
        self.started, self.cursor, self.seen = None, "", new_progress()

    def read(self, started):
        if not started:
            return new_progress()
        if started != self.started:
            self.started, self.cursor, self.seen = started, "", new_progress()
        where = ["--after-cursor", self.cursor] if self.cursor else ["--since", f"@{started}"]
        result = subprocess.run(["journalctl", "-u", "uupd.service", "-o", "cat", "--no-pager", "--show-cursor", *where],
                                capture_output=True, text=True, errors="replace")
        if result.returncode:
            # The place is gone (the journal was rotated): from the start again.
            self.started = None
            return self.seen
        lines = result.stdout.splitlines()
        for line in reversed(lines):
            if line.startswith("-- cursor: "):
                self.cursor = line[len("-- cursor: "):].strip()
                break
        return parse_update_log(lines, self.seen)


def running_game():
    """What the game watcher takes for the running game (a program's name,
    Steam with the AppId, GameMode), "" when it gave no name, None when no
    game runs. The mark is the one the update waits on (no-game-running)."""
    try:
        return (Path(f"/run/user/{os.getuid()}/arkadeos-game").read_text().splitlines() or [""])[0].strip()
    except OSError:
        return None


def update_state(log):
    """running / done / failed / skipped / idle, with what the screen shows;
    log is the page's UpdateLog."""
    props = dict(line.split("=", 1) for line in run(
        "systemctl", "show", "uupd.service", "--timestamp=unix", "-p", "ActiveState", "-p", "Result",
        "-p", "ExecMainStartTimestamp", "-p", "InactiveEnterTimestamp").splitlines() if "=" in line)
    stamp = lambda key: int(props.get(key, "").lstrip("@") or 0)  # noqa: E731
    started, ended = stamp("ExecMainStartTimestamp"), stamp("InactiveEnterTimestamp")
    running = props.get("ActiveState") in ("activating", "active", "reloading")
    # What waits for the reboot matters only once the update is over.
    state = {"started": started, "ended": ended, "staged": "" if running else run("arkadeos-update", "staged")}
    state.update(log.read(started))
    if running:
        state["kind"] = "running"
    elif props.get("Result") == "exec-condition":
        # The update did not start because a game ran. Said only while one
        # still runs (Roland, 2026-11-12): the unit keeps this result until
        # its next start, hours after the game.
        state["game"] = running_game()
        state["kind"] = "idle" if state["game"] is None else "skipped"
    elif not ended or (time.time() - ended > SHOW_DONE and not state["staged"]):
        state["kind"] = "idle"
    elif props.get("Result") not in ("success", None) or state["failed"]:
        state["kind"] = "failed"
    else:
        state["kind"] = "done"
    return state


def clock(stamp):
    return time.strftime("%H:%M", time.localtime(stamp))


def amount(got, total):
    """'1.2 / 5.6 GB', or in MB for a small download."""
    unit, name, digits = (1e9, "GB", 1) if total >= 1e9 else (1e6, "MB", 0)
    text = f"{got / unit:.{digits}f} / {total / unit:.{digits}f} {name}"
    return text.replace(".", ",") if HU else text


class UpdateProgress(QFrame):
    """The update's step and outcome under the version lines. The bar and the
    percentage are the system download's: how much of it is here, with the
    time left. The other stages and steps report no progress of their own, so
    the bar only shows that they run."""

    def __init__(self):
        super().__init__()
        self.samples = []
        self.setObjectName("progressBox")
        box = QVBoxLayout(self)
        top = QHBoxLayout()
        self.title = QLabel()
        self.title.setWordWrap(True)
        font = self.title.font()
        font.setBold(True)
        self.title.setFont(font)
        self.percent = QLabel()
        self.percent.setForegroundRole(QPalette.PlaceholderText)
        top.addWidget(self.title, 1)
        top.addWidget(self.percent)
        box.addLayout(top)
        self.bar = QProgressBar()
        self.bar.setTextVisible(False)
        self.bar.setMaximumHeight(8)
        box.addWidget(self.bar)
        steps = QHBoxLayout()
        self.steps = [QLabel() for _ in UPDATE_STEPS[:4]]
        for label in self.steps:
            steps.addWidget(label, 1)
        box.addLayout(steps)
        self.note = QLabel()
        self.note.setWordWrap(True)
        self.note.setForegroundRole(QPalette.PlaceholderText)
        box.addWidget(self.note)

    def time_left(self, got, total, now):
        """Seconds until the download is done at the speed of the last half
        minute; None until two readings a few seconds apart are here."""
        if self.samples and got < self.samples[-1][1]:
            self.samples = []
        self.samples = [x for x in self.samples if now - x[0] <= 30] + [(now, got)]
        then, before = self.samples[0]
        if now - then < 4 or got <= before:
            return None
        return (total - got) / ((got - before) / (now - then))

    def show_state(self, s, now=None):
        self.setVisible(s["kind"] != "idle")
        running = s["kind"] == "running"
        for label in self.steps:
            label.setVisible(running)
        self.bar.setVisible(running or s["kind"] == "done")
        downloading = running and s["stage"] == "download" and bool(s["total"])
        self.percent.setVisible(downloading)
        if not downloading:
            self.samples = []
        if running:
            text = s["text"] or tr("Updating…", "Frissítés fut…")
            if downloading:
                got = min(s["bytes"], s["total"])
                text += " · " + amount(got, s["total"])
                left = self.time_left(got, s["total"], time.monotonic() if now is None else now)
                if left is not None and got < s["total"]:
                    minutes = round(left / 60)
                    text += " · " + (tr("less than a minute left", "kevesebb mint 1 perc van hátra") if minutes < 1
                                     else tr(f"about {minutes} min left", f"kb. {minutes} perc van hátra"))
                percent = int(got * 100 // s["total"])
                self.bar.setRange(0, 100)
                self.bar.setValue(percent)
                self.percent.setText(f"{percent}%")
            else:
                self.bar.setRange(0, 0)
            self.title.setText(text)
            for i, label in enumerate(self.steps):
                name = UPDATE_STEPS[i][2]
                if s["step"] is not None and i < s["step"]:
                    label.setText(f"✓ {name}")
                elif i == s["step"]:
                    label.setText(f"<b>● {html.escape(name)}</b>")
                else:
                    label.setText(f"○ {name}")
            self.note.setText(tr(f"Started at {clock(s['started'])}. You can close the Portal; the update goes on.",
                                 f"Elindítva {clock(s['started'])}-kor. Bezárhatod a Portalt, a frissítés fut tovább."))
        elif s["kind"] == "done":
            self.bar.setRange(0, 100)
            self.bar.setValue(100)
            if s["staged"]:
                self.title.setText(tr(f"✓ Done at {clock(s['ended'])}. The new system starts after a restart.",
                                      f"✓ Kész {clock(s['ended'])}-kor. Az új rendszer újraindítás után indul."))
                self.note.setText(tr("The apps and Homebrew are up to date already; they need no restart.",
                                     "Az appok és a Homebrew már frissek, nekik nem kell újraindítás."))
            else:
                self.title.setText(tr(f"✓ Done at {clock(s['ended'])}. Everything is up to date, no restart needed.",
                                      f"✓ Kész {clock(s['ended'])}-kor. Minden friss, nem kell újraindítani."))
                self.note.setText(tr("The apps and Homebrew are up to date.", "Az appok és a Homebrew frissek."))
        elif s["kind"] == "failed":
            parts = ", ".join(dict.fromkeys(s["failed"])) or tr("the update", "a frissítés")
            self.title.setText(tr(f"Not everything updated at {clock(s['ended'])}: {parts} failed.",
                                  f"{clock(s['ended'])}-kor nem minden frissült: {parts} nem sikerült."))
            self.title.setStyleSheet("color: #d6284a")
            self.note.setText(tr("Try again with Update now; the details are in: journalctl -u uupd",
                                 "Próbáld újra a Frissítés most gombbal; a részletek itt: journalctl -u uupd"))
        elif s["kind"] == "skipped":
            game = f" ({s['game']})" if s.get("game") else ""
            self.title.setText(tr(f"The update did not start: a game is running{game}.",
                                  f"A frissítés nem indult el, mert játék fut{game}."))
            self.note.setText(tr("Start it again after the game, or it runs by itself tomorrow at 04:00.",
                                 "Indítsd újra a játék után, vagy holnap 04:00-kor magától lefut."))
        if s["kind"] != "failed":
            self.title.setStyleSheet("")


def version_table(lines, strong=""):
    """'Label: value' lines as a two-column table for a label; the line equal
    to strong is bold."""
    rows = []
    for line in lines:
        label, colon, value = line.partition(":")
        if not colon or not value.strip():
            label, colon, value = "", "", line
        label, value = html.escape(label.strip() + colon), html.escape(value.strip())
        if strong and line == strong:
            label, value = f"<b>{label}</b>", f"<b>{value}</b>"
        rows.append(f"<tr><td>{label}&nbsp;&nbsp;</td><td>{value}</td></tr>")
    return f"<table cellspacing='0' cellpadding='1'>{''.join(rows)}</table>"


