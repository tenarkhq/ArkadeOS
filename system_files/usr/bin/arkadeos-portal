        self.running = False
        self.refresh()
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.poll)
        self.timer.start(2000)

    def resizeEvent(self, event):
        """Two columns while both fit beside each other, one under the other in a
        narrow window, so nothing is cut off at the right edge."""
        super().resizeEvent(event)
        if not hasattr(self, "columns"):
            return
        need = (self.updates_card.minimumSizeHint().width() + self.side.minimumSize().width()
                + 22 * 2 + 12 + 16)
        direction = QBoxLayout.LeftToRight if self.width() >= need else QBoxLayout.TopToBottom
        if self.columns.direction() != direction:
            self.columns.setDirection(direction)

    @staticmethod
    def heading(icon, text):
        """A card's title with its icon."""
        box = QWidget()
        row = QHBoxLayout(box)
        row.setContentsMargins(0, 0, 0, 0)
        row.setSpacing(8)
        mark = QLabel()
        mark.setPixmap(QIcon.fromTheme(icon).pixmap(18, 18))
        row.addWidget(mark)
        title = QLabel(text)
        title.setObjectName("cardTitle")
        row.addWidget(title, 1)
        return box

    def update_headline(self, running=False):
        """The update card's first line: what to know at a glance."""
        if running:
            text, kind = tr("Updating…", "Frissítés folyamatban…"), "busy"
        elif self.staged:
            text, kind = tr(f"{self.staged} starts after a restart", f"Újraindítás után a {self.staged} indul"), "new"
        elif self.latest_newer:
            text, kind = tr("A newer version is out", "Újabb verzió érhető el"), "new"
        elif self.looking:
            text, kind = tr("Looking for a newer version…", "Újabb verzió keresése…"), "busy"
        else:
            text, kind = tr("The system is up to date", "A rendszer naprakész"), "ok"
        palette = QApplication.palette()
        mark, colour = {"ok": ("✓", "#22C55E"), "new": ("●", palette.color(QPalette.Highlight).name()),
                        "busy": ("…", palette.color(QPalette.PlaceholderText).name())}[kind]
        self.headline.setText(f"<span style='color:{colour}'>{mark}</span>&nbsp;&nbsp;{html.escape(text)}")

    def poll(self):
        if not self.isVisible() and not self.running:
            return
        s = update_state(self.log)
        self.progress.show_state(s)
        running = s["kind"] == "running"
        self.update_now.setEnabled(not running)
        self.rollback.setEnabled(not running)
        self.update_now.setText(tr("Updating…", "Frissítés folyamatban…") if running
                                else tr("Update now", "Frissítés most"))
        self.restart.setVisible(bool(s["staged"]) and not running)
        self.staged = s["staged"]
        self.update_headline(running)
        if self.running and not running:
            self.refresh()
        self.running = running

    def showEvent(self, event):
        super().showEvent(event)
        self.poll()
        # The Portal may stay open for hours: asked again after ten minutes.
        if time.monotonic() - self.looked > 600:
            self.look_for_newer()

    def look_for_newer(self):
        """Asks the channel for its newest version, in the background."""
        if self.looking:
            # What it compares with changed meanwhile: asked once more after it.
            self.again = True
            return
        self.looking, self.looked = True, time.monotonic()
        self.check.setEnabled(False)
        self.latest_line = tr("Newest available: looking…", "Legfrissebb elérhető: keresés…")
        self.show_versions()
        self.checker.start("arkadeos-update", ["latest"])

    def newer_found(self, code=1, status=QProcess.CrashExit):
        if not self.looking:
            return
        self.looking = False
        out = bytes(self.checker.readAllStandardOutput()).decode(errors="replace").strip()
        self.latest_line = out.splitlines()[-1] if out else tr(
            "Newest available: the channel could not be reached",
            "Legfrissebb elérhető: a csatorna most nem érhető el")
        # arkadeos-update latest: exit status 10 when a newer one is out.
        self.latest_newer = status == QProcess.NormalExit and code == 10
        self.check.setEnabled(True)
        self.show_versions()
        self.newer.emit(self.latest_newer)
        if self.again:
            self.again = False
            self.look_for_newer()

    def show_auto(self):
        """The switch's words: what happens, and when it looked last."""
        self.auto_note.setText(tr(
            "A new system version is downloaded and installed by itself. The machine does not "
            "restart: a notice tells when it is ready, and the restart is yours to choose.",
            "Az új rendszerverziót magától letölti és telepíti. Nem indítja újra a gépet: "
            "értesítést küld, ha kész, az újraindításról te döntesz.") if self.auto.isChecked() else tr(
            "Only told when a new version is out, with its number. Update now installs it.",
            "Csak szól, ha új verzió jött ki, a verziószámmal. A Frissítés most gombbal telepíted."))
        channel = tr("Testing", "Teszt") if self.channel_now == "testing" else tr("Stable", "Stabil")
        text = tr(f"Looked for after the login and every 6 hours on the {channel} channel",
                  f"Keresés bejelentkezés után és 6 óránként a {channel} csatornán")
        try:
            stamp = int((STATE / "update-checked").read_text().strip())
        except (OSError, ValueError):
            stamp = 0
        if stamp:
            day = time.strftime("%Y-%m-%d", time.localtime(stamp))
            if day == time.strftime("%Y-%m-%d"):
                text += tr(f" · last at {clock(stamp)}", f" · utoljára ma {clock(stamp)}")
            else:
                text += tr(f" · last on {day} {clock(stamp)}", f" · utoljára {day} {clock(stamp)}")
        self.auto_when.setText(text)

    def auto_toggled(self, on):
        """The setting is the machine's: saved through arkadeos-update auto
        (no password for the machine's admins). Turned on, it looks at once,
        and a newer version is installed then."""
        result = subprocess.run(["arkadeos-update", "auto", "on" if on else "off"], capture_output=True, text=True)
        if result.returncode != 0:
            self.auto.blockSignals(True)
            self.auto.setChecked(not on)
            self.auto.blockSignals(False)
        elif on:
            subprocess.Popen(["systemctl", "--user", "start", "--no-block", "arkadeos-update-check.service"])
        self.show_auto()

    def show_versions(self):
        self.show_auto()
        lines = self.status_lines + ([self.latest_line] if self.latest_line else [])
        self.version.setText(version_table(lines, self.latest_line if self.latest_newer else ""))
        self.update_headline(self.running)

    def button(self, icon, text, command):
        b = QPushButton(QIcon.fromTheme(icon), text)
        b.clicked.connect(lambda: self.call(command))
        return b

    def call(self, command):
        result = subprocess.run(command, capture_output=True, text=True)
        text = (result.stdout + result.stderr).strip()
        if text:
            QMessageBox.information(self, "ArkadeOS", text)
        self.refresh()
        self.poll()

    def refresh(self):
        """The version lines again: at the start, after an update and after
        every change made here (channel, going back, an earlier build)."""
        self.status_lines = run("arkadeos-update", "status").splitlines()
        self.show_versions()
        self.channel_now = run("arkadeos-update", "channel")
        index = self.channel.findData(self.channel_now)
        if index >= 0:
            self.channel.setCurrentIndex(index)
        self.look_for_newer()

    def reset_system(self):
        if QMessageBox.question(self, "ArkadeOS", tr(
                "Reset the system settings to the factory ones? Home folders, users, network "
                "connections, language and keyboard stay; packages added on top are removed. "
                "It counts after a reboot.",
                "Visszaállítod a rendszerbeállításokat a gyáriakra? A saját mappák, a felhasználók, "
                "a hálózati kapcsolatok, a nyelv és a billentyűzet megmaradnak; a ráadásként "
                "telepített csomagok eltűnnek. Újraindítás után érvényes.")) != QMessageBox.Yes:
            return
        result = subprocess.run(["pkexec", "/usr/libexec/arkadeos/reset-system"], capture_output=True, text=True)
        if result.returncode == 0:
            QMessageBox.information(self, "ArkadeOS", tr(
                f"Done. Restart the machine. The old settings are in {result.stdout.strip()}.",
                f"Kész. Indítsd újra a gépet. A régi beállítások itt vannak: {result.stdout.strip()}."))

    def reset_desktop(self):
        if QMessageBox.question(self, "ArkadeOS", tr(
                "Restore the ArkadeOS look, taskbar and shortcuts? Your own settings are "
                "kept in a backup folder; files and apps stay.",
                "Visszaállítod az ArkadeOS kinézetét, tálcáját és billentyűparancsait? "
                "A saját beállításaid egy mentési mappába kerülnek; a fájlok és az appok "
                "megmaradnak.")) != QMessageBox.Yes:
            return
        backup = run("/usr/libexec/arkadeos/reset-desktop")
        QMessageBox.information(self, "ArkadeOS", tr(
            f"Done. Log out and back in to see it. Your settings are in {backup}.",
            f"Kész. Jelentkezz ki és be, hogy érvénybe lépjen. A beállításaid itt vannak: {backup}."))


# Power profiles a game can run with (arkadeos-power, T011, T055).
PROFILES = [
    ("battery", tr("Battery", "Akku")),
    ("balanced", tr("Balanced", "Kiegyensúlyozott")),
    ("gaming", "Gaming"),
    ("max", tr("Max (charger only)", "Max (csak töltőn)")),
    ("wow", tr("WoW (full CPU, GPU held back)", "WoW (teljes CPU, visszafogott GPU)")),
]
FACTORY_GAMES = Path("/usr/share/arkadeos/game-profiles.conf")
USER_GAMES = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "arkadeos/game-profiles.conf"
GAME_NAMES = {"wow.exe": ("World of Warcraft", "Battle.net"), "wowclassic.exe": ("WoW Classic", "Battle.net")}
STEAM_ROOTS = [Path.home() / ".local/share/Steam", Path.home() / ".var/app/com.valvesoftware.Steam/.local/share/Steam"]
# Steam's own tools are no games.
STEAM_TOOLS = re.compile(r"^(Proton|Steam Linux Runtime|Steamworks Common)")


def read_games(path):
    out = {}
    try:
        for line in path.read_text().splitlines():
            key, _, value = line.partition("=")
            if key.strip() and not key.startswith("#") and value.strip():
                out[key.strip()] = value.strip()
    except OSError:
        pass
    return out


def steam_games():
    """AppId -> name of the installed Steam games, from every Steam library."""
    games = {}
    for root in STEAM_ROOTS:
        libraries = {root}
        try:
            libraries |= {Path(p) for p in re.findall(r'"path"\s+"([^"]+)"',
                                                       (root / "steamapps/libraryfolders.vdf").read_text())}
        except OSError:
            pass
        for library in libraries:
            for manifest in (library / "steamapps").glob("appmanifest_*.acf"):
                try:
                    text = manifest.read_text(errors="replace")
                except OSError:
                    continue
                appid = re.search(r'"appid"\s+"(\d+)"', text)
                name = re.search(r'"name"\s+"([^"]+)"', text)
                if appid and name and not STEAM_TOOLS.match(name.group(1)):
                    games[appid.group(1)] = name.group(1)
    return games


class GamesTab(QWidget):
    def __init__(self):
        super().__init__()
        outer = QVBoxLayout(self)
        outer.setContentsMargins(0, 0, 0, 0)
        outer.setSpacing(0)
        head, _ = page_head(tr("Games", "Játékok"), tr(
            "The power profile each game runs with. It switches on when the game starts, and "
            "the profile before comes back when it exits. A game not on the list runs on Gaming.",
            "Melyik játék milyen energiaprofillal fusson. A játék indulásakor ez kapcsol be "
            "magától, és kilépéskor visszaáll az előző profil. Ami nincs a listán, Gaminggel fut."))
        outer.addLayout(head)
        layout = QVBoxLayout()
        layout.setContentsMargins(22, 0, 22, 16)
        layout.setSpacing(10)
        outer.addLayout(layout, 1)
        self.table = QTableWidget(0, 4)
        self.table.setObjectName("games")
        self.table.setShowGrid(False)
        self.table.verticalHeader().setDefaultSectionSize(46)
        self.table.horizontalHeader().setDefaultAlignment(Qt.AlignLeft | Qt.AlignVCenter)
        self.table.setHorizontalHeaderLabels([tr("Game", "Játék"), tr("From", "Honnan"),
                                              tr("Power profile", "Energiaprofil"), ""])
        header = self.table.horizontalHeader()
        header.setSectionResizeMode(0, QHeaderView.Stretch)
        for column in (1, 2, 3):
            header.setSectionResizeMode(column, QHeaderView.ResizeToContents)
        self.table.verticalHeader().hide()
        self.table.setEditTriggers(QTableWidget.NoEditTriggers)
        self.table.setSelectionMode(QTableWidget.NoSelection)
        layout.addWidget(self.table, 1)

        row = QHBoxLayout()
        self.add = QPushButton(QIcon.fromTheme("list-add"), tr("Add a program…", "Program hozzáadása…"))
        self.add.clicked.connect(lambda: self.adding(True))
        row.addWidget(self.add)
        self.name = QLineEdit()
        self.name.setPlaceholderText(tr("The program's name, e.g. Diablo IV.exe", "A program neve, például Diablo IV.exe"))
        self.name.returnPressed.connect(self.add_program)
        row.addWidget(self.name, 1)
        self.add_ok = QPushButton(tr("Add", "Hozzáadás"))
        self.add_ok.clicked.connect(self.add_program)
        row.addWidget(self.add_ok)
        self.add_cancel = QPushButton(tr("Cancel", "Mégse"))
        self.add_cancel.clicked.connect(lambda: self.adding(False))
        row.addWidget(self.add_cancel)
        row.addStretch()
        layout.addLayout(row)
        hint = QLabel(tr(
            "Steam games come on the list by themselves. For another game give the program's name "
            "(e.g. Wow.exe), even before it is installed. ✕ removes a program you added.",
            "A Steam-játékok maguktól kerülnek a listára. Más játékhoz a program nevét kell megadni "
            "(például Wow.exe), akkor is, ha a játék még nincs telepítve. A kézzel felvett programot "
            "a ✕ törli."))
        hint.setObjectName("muted")
        hint.setWordWrap(True)
        layout.addWidget(hint)
        self.status = QLabel()
        layout.addWidget(self.status)
        self.adding(False)
        self.refresh()

    def adding(self, on):
        self.add.setVisible(not on)
        for widget in (self.name, self.add_ok, self.add_cancel):
            widget.setVisible(on)
        if on:
            self.name.setFocus()
        else:
            self.name.clear()

    def rows(self):
        """(key, name, from, factory profile or None, own profile or None, removable)"""
        factory, own, steam = read_games(FACTORY_GAMES), read_games(USER_GAMES), steam_games()
        keys = {k.lower(): k for k in list(factory) + list(own)}
        out = []
        for low, key in keys.items():
            if key in steam:
                continue
            fac = next((v for k, v in factory.items() if k.lower() == low), None)
            mine = next((v for k, v in own.items() if k.lower() == low), None)
            name, source = GAME_NAMES.get(low, (re.sub(r"(?i)\.exe$", "", key), tr("program", "program")))
            out.append((key, name, source, fac, mine, fac is None))
        for appid, name in sorted(steam.items(), key=lambda kv: kv[1].lower()):
            out.append((appid, name, "Steam", factory.get(appid), own.get(appid), False))
        return out

    def refresh(self):
        rows = self.rows()
        self.table.setRowCount(len(rows))
        names = dict(PROFILES)
        for i, (key, name, source, fac, mine, removable) in enumerate(rows):
            label = QLabel(f"<b>{html.escape(name)}</b> <span style='color:gray'>{html.escape(key)}</span>")
            label.setTextFormat(Qt.RichText)
            self.table.setCellWidget(i, 0, label)
            self.table.setCellWidget(i, 1, QLabel(source))
            combo = QComboBox()
            combo.addItem(tr(f"Default ({names[fac or 'gaming'].split(' (')[0]})",
                             f"Alapértelmezett ({names[fac or 'gaming'].split(' (')[0]})"), "default")
            for profile, text in PROFILES:
                combo.addItem(text, profile)
            index = combo.findData(mine) if mine else 0
            combo.setCurrentIndex(max(index, 0))
            combo.currentIndexChanged.connect(lambda _, k=key, n=name, c=combo: self.choose(k, n, c))
            self.table.setCellWidget(i, 2, combo)
            if removable:
                remove = QToolButton()
                remove.setText("✕")
                remove.setToolTip(tr("Remove from the list", "Törlés a listáról"))
                remove.clicked.connect(lambda _, k=key: self.remove(k))
                self.table.setCellWidget(i, 3, remove)
            else:
                self.table.removeCellWidget(i, 3)

    def power(self, key, profile):
        result = subprocess.run(["arkadeos-power", "game", key, profile], capture_output=True, text=True)
        if result.returncode:
            QMessageBox.warning(self, "ArkadeOS", (result.stdout + result.stderr).strip())
        return result.returncode == 0

    def choose(self, key, name, combo):
        if self.power(key, combo.currentData()):
            self.status.setText(tr(f"Saved: {name} → {combo.currentText()}. It counts from its next start.",
                                   f"Mentve: {name} → {combo.currentText()}. A következő indításától érvényes."))

    def add_program(self):
        key = self.name.text().strip()
        if not key:
            return
        if not key.lower().endswith(".exe"):
            key += ".exe"
        if self.power(key, "gaming"):
            self.adding(False)
            self.refresh()
            self.status.setText(tr(f"Added: {key}. Choose its profile in the list.",
                                   f"Hozzáadva: {key}. A profilját a listában lehet választani."))

    def remove(self, key):
        if self.power(key, "default"):
            self.refresh()
            self.status.setText(tr(f"Removed: {key}. It runs on Gaming again.",
                                   f"Törölve: {key}. Újra Gaminggel fut."))


def config(name, group, key):
    run = subprocess.run(["kreadconfig6", "--file", name, "--group", group, "--key", key],
                         capture_output=True, text=True)
    return run.stdout.strip()


def wait_for_look():
    """On the first login the Plasma look may not be final yet when the
    Portal starts: where the user turned Plasma's automatic light/dark switch
    on (a kded module), it applies the right look a few seconds after the
    session opens. The choice screen waits for that (at most 30
    seconds), so it opens in the final look; Breeze follows later switches
    by itself."""
    home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    files = [home / "kdeglobals"]
    automatic = config("kdeglobals", "KDE", "AutomaticLookAndFeel") == "true"
    deadline = time.monotonic() + 30
    scheme = ""
    while time.monotonic() < deadline:
        if automatic:
            kded = subprocess.run(["busctl", "--user", "call", "org.kde.kded6", "/kded",
                                   "org.kde.kded6", "loadedModules"], capture_output=True, text=True)
            ready = "lookandfeelautoswitcher" in kded.stdout
        else:
            ready = True
        scheme = config("kdeglobals", "General", "ColorScheme")
        still = all(not f.exists() or time.time() - f.stat().st_mtime >= 2 for f in files)
        if ready and still:
            break
        time.sleep(0.5)
    print(f"arkadeos-portal: waited for the look, {scheme or 'unset'}", file=sys.stderr)


class LookLog(QObject):
    """Writes the colours the window shows to the journal: when it opens and
    at each light/dark switch it follows (for the VM test)."""

    def __init__(self, window):
        super().__init__(window)
        window.installEventFilter(self)
        self.log()

    def log(self):
        scheme = config("kdeglobals", "General", "ColorScheme")
        print(f"arkadeos-portal: shows the colours {scheme or 'unset'}", file=sys.stderr, flush=True)

    def eventFilter(self, obj, event):
        if event.type() == QEvent.ApplicationPaletteChange:
            self.log()
        return False


def kdeglobals():
    c = configparser.ConfigParser(strict=False, interpolation=None)
    c.optionxform = str
    try:
        c.read(Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "kdeglobals")
    except configparser.Error:
        pass
    return c


def glass_colours():
    """The window frame's glass, active and inactive: the colour scheme's
    title bar colours, with their see-through (ArkadeOS Glass, T086)."""
    c = kdeglobals()
    out = {}
    for active, key, fallback in ((True, "activeBackground", (45, 81, 110, 136)),
                                  (False, "inactiveBackground", (30, 53, 72, 133))):
        try:
            parts = tuple(int(x) for x in c.get("WM", key, fallback="").split(","))
        except ValueError:
            parts = ()
        out[active] = QColor(*(parts if len(parts) in (3, 4) else fallback))
    return out


def mix(a, b, share):
    """Colour a with the given share of b."""
    return QColor(*(round(x + (y - x) * share) for x, y in zip(a.getRgb()[:3], b.getRgb()[:3])))


def rgba(c, alpha):
    return f"rgba({c.red()},{c.green()},{c.blue()},{alpha})"


SWITCHES = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/tmp/arkadeos-portal-{os.getuid()}") / "arkadeos-portal"


def switch_images(on, track, knob):
    """The switch's four looks (on, off, and both greyed) as pictures for the
    style sheet."""
    SWITCHES.mkdir(parents=True, exist_ok=True)
    paths = {}
    for name, fill, x, dot, alpha in (("on", on, 26, "#ffffff", 1), ("off", track, 10, knob, 1),
                                      ("on-disabled", on, 26, "#ffffff", .45), ("off-disabled", track, 10, knob, .45)):
        path = SWITCHES / f"switch-{name}.svg"
        path.write_text(f'<svg xmlns="http://www.w3.org/2000/svg" width="36" height="20" viewBox="0 0 36 20">'
                        f'<g opacity="{alpha}"><rect width="36" height="20" rx="10" fill="{fill}"/>'
                        f'<circle cx="{x}" cy="10" r="7" fill="{dot}"/></g></svg>')
        paths[name] = path.as_posix()
    return paths


def style_sheet(palette):
    """ArkadeOS Glass for the Portal, from the colour scheme in use: the solid
    pane and its cards, switches, buttons and fields; the glass side's words
    white on the dark glass, dark on the light one."""
    window = palette.color(QPalette.Window)
    text = palette.color(QPalette.WindowText)
    accent = palette.color(QPalette.Highlight)
    muted = palette.color(QPalette.PlaceholderText).name()
    dark = window.lightness() < 128
    white, black = QColor("#ffffff"), QColor("#000000")
    card = mix(window, white, .045) if dark else palette.color(QPalette.Base)
    field = mix(window, black, .28) if dark else white
    button = mix(window, text, .10)
    line = rgba(text, .10)
    ink = "#0b1a28"
    glass_ink = "#ffffff" if dark else "#10161f"
    danger = "#ff8fa0" if dark else "#c0283f"
    amber = QColor("#F59E0B")
    s = switch_images(accent.name(), mix(window, text, .22).name(), "#c9d1dc" if dark else "#ffffff")
    return f"""
#pane {{ background: {window.name()}; border-radius: 6px; }}
#scroll, #scrollBody {{ background: transparent; }}
#scroll > QWidget > QWidget {{ background: transparent; }}
#pane QScrollBar:vertical {{ background: {window.name()}; border: none; width: 10px; margin: 0; }}
#pane QScrollBar:horizontal {{ background: {window.name()}; border: none; height: 10px; margin: 0; }}
#pane QScrollBar::handle {{ background: {rgba(text, .25)}; border-radius: 3px; margin: 3px 2px; }}
#pane QScrollBar::handle:vertical {{ min-height: 32px; }}
#pane QScrollBar::handle:horizontal {{ min-width: 32px; }}
#pane QScrollBar::handle:hover {{ background: {rgba(text, .42)}; }}
#pane QScrollBar::add-line, #pane QScrollBar::sub-line {{ width: 0; height: 0; border: none; background: none; }}
#pane QScrollBar::add-page, #pane QScrollBar::sub-page {{ background: none; }}
#pageTitle {{ font-size: 21px; font-weight: 700; }}
#pageSub, #muted, #cardNote, #footNote {{ color: {muted}; }}
#groupTitle {{ color: {muted}; font-size: 11px; font-weight: 700; letter-spacing: 1px; padding-top: 4px; }}
#card {{ background: {card.name()}; border: 1px solid {line}; border-radius: 10px; }}
#card[pending="true"] {{ background: {rgba(accent, .12)}; border: 1px solid {rgba(accent, .7)}; }}
#card[pending="true"] #cardNote {{ color: {accent.name()}; }}
#cardName {{ font-weight: 600; }}
