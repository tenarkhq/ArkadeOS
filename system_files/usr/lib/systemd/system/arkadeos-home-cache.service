[Unit]
Description=ArkadeOS: each user's cache folder out of the home snapshots
After=local-fs.target systemd-tmpfiles-setup.service arkadeos-home-snapshots.service
Before=systemd-user-sessions.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/arkadeos/home-cache

[Install]
WantedBy=multi-user.target
