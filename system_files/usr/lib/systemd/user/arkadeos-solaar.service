[Unit]
Description=Solaar for the plugged-in Logitech receiver (battery level, pairing)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# Its tray icon from the icon theme's symbolic battery set: the ArkadeOS
# Glass tray icons (T086), not Breeze's coloured ones.
ExecStart=/usr/bin/solaar --window=hide --battery-icons=symbolic
Restart=on-failure
RestartSec=10
