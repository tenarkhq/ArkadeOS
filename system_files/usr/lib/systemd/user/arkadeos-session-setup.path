[Unit]
Description=Rerun the ArkadeOS per-user setup when apps are installed or removed
PartOf=graphical-session.target

[Path]
PathChanged=/var/lib/flatpak/exports/share/applications
PathChanged=%h/.local/share/flatpak/exports/share/applications
# Web apps the browser adds (their taskbar name, T067).
PathChanged=%h/.local/share/applications
# KDE's places file, first written when a file view opens (T069).
PathChanged=%h/.local/share/user-places.xbel
Unit=arkadeos-session-setup.service

[Install]
WantedBy=graphical-session.target
