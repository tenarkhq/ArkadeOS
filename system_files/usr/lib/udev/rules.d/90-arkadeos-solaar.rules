# Logitech wireless receivers (Unifying, Lightspeed, Bolt): start Solaar for
# the user while one is plugged in (T045).
ACTION=="add|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="046d", ATTR{product}=="*[Rr]eceiver*", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="arkadeos-solaar.service"
