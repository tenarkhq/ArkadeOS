# Dolphin's sidebar and the file dialogs show only drives a person opens, with
# names a person reads, as Finder does (T069).
SUBSYSTEM!="block", GOTO="arkadeos_drives_end"
ENV{DEVTYPE}!="partition", GOTO="arkadeos_drives_end"

# Windows' hidden partitions: EFI system, Microsoft reserved, Windows recovery.
ENV{ID_PART_ENTRY_TYPE}=="c12a7328-f81f-11d2-ba4b-00a0c93ec93b", ENV{UDISKS_IGNORE}="1"
ENV{ID_PART_ENTRY_TYPE}=="e3c9e316-0b5c-4db8-817d-f92df00215ae", ENV{UDISKS_IGNORE}="1"
ENV{ID_PART_ENTRY_TYPE}=="de94bba4-06d1-4d40-a16a-bfd50179d6ac", ENV{UDISKS_IGNORE}="1"

# ArkadeOS's own boot and system partitions, also when it runs from a USB
# drive (udisks hides them only on internal disks). Windows or exFAT data
# partitions on the same disk stay.
ENV{ID_FS_TYPE}!="ntfs|exfat", PROGRAM=="/usr/libexec/arkadeos/system-disk %k", ENV{UDISKS_IGNORE}="1"

# Windows' own drive, usually without a label: "Windows" instead of its size.
ENV{ID_FS_TYPE}=="ntfs", ENV{ID_FS_LABEL}=="", ENV{ID_PART_ENTRY_TYPE}=="ebd0a0a2-b9e5-4433-87c0-68b6b72699c7", ENV{UDISKS_NAME}="Windows"

LABEL="arkadeos_drives_end"
