diff --git a/app/SidebarMode.cpp b/app/SidebarMode.cpp
index d1e8728..b58ee1c 100644
--- a/app/SidebarMode.cpp
+++ b/app/SidebarMode.cpp
@@ -597,6 +597,11 @@ void SidebarMode::initWidget()
     d->quickWidget = new QQuickWidget(d->engine.get(), d->mainWidget);
     d->quickWidget->quickWindow()->setTitle(i18n("Sidebar"));
     d->quickWidget->setResizeMode(QQuickWidget::SizeRootObjectToView);
+    // ArkadeOS Glass: the sidebar is drawn on top of the window's own
+    // see-through background (the Darkly style, blurred behind by KWin), so
+    // it shows the glass as Dolphin's sidebar does; the pages stay solid.
+    d->quickWidget->setAttribute(Qt::WA_AlwaysStackOnTop, true);
+    d->quickWidget->setClearColor(Qt::transparent);
 
     d->quickWidget->rootContext()->setContextProperty(QStringLiteral("systemsettings"), this);
 
